#!/usr/bin/env bash
# brg — brigada: message transport between coding agents from different harnesses.
# Spec: DESIGN.md §3–§9. One file, bash 3.2+; utilities: mkdir mv rm cat sed awk
# date sleep kill ls head tail wc sort tr printf cp uname nohup. No jq/python/node.
#
# Agents (from the project root):  bash .brigada/bin/brg <command> --as <name> …
# Human:                            init (from the brigada repo), board, say, tail, who, stop, resume,
#                                   task cancel --as human.
#
# Layout: the .brigada root is <dir of this script>/.. (see DESIGN §4).
#
# CRLF guard (git with core.autocrlf=true on Windows): read with CRLF endings, the
# first line keeps a trailing CR in the value, while the second ends in a comment
# that swallows its CR — so it still parses, explains and exits. No blank line may
# come before it (a lone CR is a command "\r": "command not found").
_brg_crlf=x
case ${#_brg_crlf} in 1) ;; *) printf '%s\n' "brg: ОШИБКА: у файла $0 окончания строк CRLF (Windows) — bash его не выполнит." "Причина — git с core.autocrlf=true. Это .brigada/bin/brg — переустанови: bash <brigada>/bin/brg init <проект>. Это сам репозиторий brigada — удали bin/brg и восстанови: git checkout -- bin/brg (по .gitattributes он запишется с LF) или скачай brigada заново. Проверка: bash <brigada>/bin/brg doctor <проект>." >&2; exit 2 ;; esac #
unset _brg_crlf

BRG_VERSION=0.5.0
# the caller's locale, restored for commands started by `brg run`
_brg_lc_set=${LC_ALL+1}
_brg_lc=${LC_ALL-}
LC_ALL=C # byte semantics everywhere (lengths, patterns, tr/sed/awk); UTF-8 passes through
export LC_ALL
unset CDPATH
NL=$'\n'
CR=$'\r'

# ── locations ──────────────────────────────────────────────────────────────
_brg_src=${BASH_SOURCE[0]:-$0}
_brg_src=${_brg_src//\\//} # bin/brg.cmd may pass C:\…\brg
case $_brg_src in */*) BIN_DIR=${_brg_src%/*} ;; *) BIN_DIR=. ;; esac
_brg_pwd=$PWD
if cd "$BIN_DIR" 2>/dev/null; then
  BIN_DIR=$PWD
  cd "$_brg_pwd" 2>/dev/null
fi
# Git Bash: a drive path C:/x → /c/x, the form of $PWD there (compared with it)
case $BIN_DIR in
  [A-Za-z]:/*)
    _brg_d=${BIN_DIR%%:*}
    case $_brg_d in [A-Z]) _brg_d=$(printf '%s' "$_brg_d" | tr 'A-Z' 'a-z') ;; esac
    [ -d "/$_brg_d${BIN_DIR#?:}" ] && BIN_DIR=/$_brg_d${BIN_DIR#?:}
    ;;
esac
ROOT=${BIN_DIR%/*}
[ -n "$ROOT" ] || ROOT=/
BRG_SELF=$BIN_DIR/${_brg_src##*/}
# the project root (paths of reservations, cwd of `brg run`): the parent of .brigada
PROJ=${ROOT%/*}
[ -n "$PROJ" ] || PROJ=/
RUN=$ROOT/run
LOCKS=$RUN/locks
# Paths shown to agents: relative to the project root (where agents run brg).
case $ROOT in */.brigada) RROOT=.brigada ;; *) RROOT=$ROOT ;; esac

# ── small helpers ──────────────────────────────────────────────────────────
is_uint() {
  case $1 in '' | *[!0-9]*) return 1 ;; esac
  return 0
}

# Names: letters, digits, . _ - ; no leading dot/dash; ≤ 64 bytes.
valid_name() {
  case $1 in '' | [.-]* | *[!A-Za-z0-9._-]*) return 1 ;; esac
  [ ${#1} -le 64 ]
}

get_now() { NOW=$(date -u +%s); }
get_now_iso() {
  local x
  x=$(date -u '+%s %Y-%m-%dT%H:%M:%SZ')
  NOW=${x%% *}
  ISO=${x#* }
}

# shq_v VAR STRING — quote for a copy-pasteable command (only when needed).
shq_v() {
  local _sq_s=$2 _sq_q="'\\''"
  case $_sq_s in
    '') _sq_s="''" ;;
    *[!A-Za-z0-9_./:=@%+$'\x80'-$'\xff'-]*) _sq_s="'${_sq_s//\'/$_sq_q}'" ;; # UTF-8 bytes are not special
  esac
  eval "$1=\$_sq_s"
}

# mv with retries (Windows: the target may be briefly held by a reader/antivirus).
mv_retry() {
  local i=0
  while ! mv -f "$1" "$2" 2>/dev/null; do
    i=$((i + 1))
    if [ $i -ge 10 ]; then
      mv -f "$1" "$2"
      return
    fi
    sleep 0.1
  done
}

# ago_v VAR SECONDS — "5 с назад" / "3 мин назад" / "2 ч назад"
ago_v() {
  local _ag_s=$2 _ag_r
  if [ "$_ag_s" -lt 0 ]; then _ag_s=0; fi
  if [ "$_ag_s" -lt 120 ]; then
    _ag_r="$_ag_s с назад"
  elif [ "$_ag_s" -lt 7200 ]; then
    _ag_r="$((_ag_s / 60)) мин назад"
  else
    _ag_r="$((_ag_s / 3600)) ч назад"
  fi
  eval "$1=\$_ag_r"
}

# dur_v VAR SECONDS — "90 с" / "5 мин" / "2 ч"
dur_v() {
  local _du_s=$2 _du_r
  if [ "$_du_s" -lt 120 ]; then
    _du_r="$_du_s с"
  elif [ "$_du_s" -lt 7200 ]; then
    _du_r="$(((_du_s + 30) / 60)) мин"
  else
    _du_r="$(((_du_s + 1800) / 3600)) ч"
  fi
  eval "$1=\$_du_r"
}

# parse_dur_v VAR SPEC — 90 | 90s | 5m | 1h → seconds (1 s … 24 h); 1 if invalid
parse_dur_v() {
  local _pd_n=$2 _pd_m=1
  case $_pd_n in
    *s) _pd_n=${_pd_n%s} ;;
    *m) _pd_n=${_pd_n%m} _pd_m=60 ;;
    *h) _pd_n=${_pd_n%h} _pd_m=3600 ;;
  esac
  is_uint "$_pd_n" && [ ${#_pd_n} -le 6 ] || return 1
  _pd_n=$((10#$_pd_n * _pd_m))
  [ "$_pd_n" -ge 1 ] && [ "$_pd_n" -le 86400 ] || return 1
  eval "$1=\$_pd_n"
}

# utf8_cut_v VAR STRING MAX — at most MAX bytes, cut at a UTF-8 character boundary:
# if the first dropped byte continues a character, that character's bytes before
# the cut go too (its continuation bytes, then its lead byte).
utf8_cut_v() {
  local _uc_s=$2 _uc_n=$3
  [ "$_uc_n" -ge 0 ] || _uc_n=0
  if [ ${#_uc_s} -gt "$_uc_n" ]; then
    case ${_uc_s:_uc_n:1} in
      [$'\x80'-$'\xbf'])
        _uc_s=${_uc_s:0:_uc_n}
        while :; do
          case $_uc_s in *[$'\x80'-$'\xbf']) _uc_s=${_uc_s%?} ;; *) break ;; esac
        done
        case $_uc_s in *[$'\xc0'-$'\xff']) _uc_s=${_uc_s%?} ;; esac
        ;;
      *) _uc_s=${_uc_s:0:_uc_n} ;;
    esac
  fi
  eval "$1=\$_uc_s"
}

# trunc_v VAR STRING MAX — at most MAX bytes (cut at a UTF-8 boundary), ends with "…".
trunc_v() {
  local _tr_s=$2
  if [ ${#_tr_s} -gt "$3" ]; then
    utf8_cut_v _tr_s "$_tr_s" "$3"
    _tr_s="$_tr_s…"
  fi
  eval "$1=\$_tr_s"
}

# fit_v VAR TEXT MAX WHAT HINT — lenient limits of one-line options (--note, --title,
# --desc, …): a longer TEXT is not refused but cut at a UTF-8 boundary to MAX bytes
# including the mark " …(обрезано)"; the warning (what was cut and HINT: where the
# details go instead) is added to FIT_WARN, which the command prints.
FIT_MARK=" …(обрезано)"
FIT_WARN=
fit_v() {
  local _fv_s=$2
  if [ ${#_fv_s} -gt "$3" ]; then
    utf8_cut_v _fv_s "$_fv_s" $(($3 - ${#FIT_MARK}))
    while :; do
      case $_fv_s in *[[:space:]]) _fv_s=${_fv_s%?} ;; *) break ;; esac
    done
    _fv_s="$_fv_s$FIT_MARK"
    FIT_WARN="$FIT_WARN${FIT_WARN:+$NL}Внимание: $4 длиннее $3 байт (${#2}) — сохранено обрезанным, с пометкой «…(обрезано)».${5:+ $5}"
  fi
  eval "$1=\$_fv_s"
}
fit_warn_print() { [ -z "$FIT_WARN" ] || printf '%s\n' "$FIT_WARN"; }

# plural_new_v VAR N — "новое" / "новых"
plural_new_v() {
  local _pn_w=новых
  if [ $(($2 % 10)) -eq 1 ] && [ $(($2 % 100)) -ne 11 ]; then _pn_w=новое; fi
  eval "$1=\$_pn_w"
}

# Local UTC offset in seconds (for HH:MM display; computed once per process).
TZ_OFF=
tz_offset() {
  local z s hh mm
  z=$(date +%z 2>/dev/null)
  TZ_OFF=0
  case $z in
    [+-][0-9][0-9][0-9][0-9])
      s=${z%????}
      hh=${z#?}
      hh=${hh%??}
      mm=${z#???}
      TZ_OFF=$((10#$hh * 3600 + 10#$mm * 60))
      [ "$s" = - ] && TZ_OFF=$((-TZ_OFF))
      ;;
  esac
}
hm_v() { # VAR EPOCH — local "HH:MM"
  local _hm_e
  [ -n "$TZ_OFF" ] || tz_offset
  _hm_e=$((($2 + TZ_OFF) % 86400))
  printf -v _hm_e '%02d:%02d' $((_hm_e / 3600)) $((_hm_e % 3600 / 60))
  eval "$1=\$_hm_e"
}

detect_platform() {
  local s v=
  if [ -n "${BRG_PLATFORM:-}" ]; then # override for tests/diagnostics
    PLATFORM=$BRG_PLATFORM
    return
  fi
  s=$(uname -s 2>/dev/null)
  case $s in
    Darwin) PLATFORM=Darwin ;;
    Linux)
      PLATFORM=Linux
      if [ -r /proc/version ]; then
        IFS= read -r v </proc/version
        case $v in *[Mm]icrosoft* | *WSL*) PLATFORM=WSL ;; esac
      fi
      ;;
    MINGW* | MSYS*) PLATFORM=MSYS ;;
    CYGWIN*) PLATFORM=Cygwin ;;
    *) PLATFORM=${s:-unknown} ;;
  esac
  PLATFORM=${PLATFORM//[!A-Za-z0-9._-]/}
}

# ── output, errors, metrics ────────────────────────────────────────────────
CMD=
AGENT=     # the base name (all state lives under it: DESIGN §3)
ASN=       # the caller's full name (base.key) — only for --as hints and NEXT lines
AS_NOKEY=  # 1: a read command called with the base name of a keyed agent
WAIT_MODE=
NEXT_ON_ERR= # NEXT line printed with every error (DESIGN §5: agents must not fall out of the loop)

say_err() {
  if [ -n "$WAIT_MODE" ]; then printf '%s\n' "$@"; else printf '%s\n' "$@" >&2; fi
}

# die MSG [LINE...] — error + hints + NEXT; wait always exits 0 (status is in the text).
die() {
  local m=$1
  shift
  say_err "── ОШИБКА: $m" "$@"
  [ -n "$NEXT_ON_ERR" ] && say_err "── NEXT: $NEXT_ON_ERR"
  metric "${CMD:-brg}" result=error
  [ -n "$WAIT_MODE" ] && exit 0
  exit 1
}

usage_die() {
  local u
  usage_line_v u "$CMD"
  die "$1" "Использование: $u"
}

metric() {
  [ -d "$RUN" ] || return 0
  [ -n "$NOW" ] || get_now
  printf '%s %s %s%s\n' "$NOW" "${AGENT:--}" "$*" "${AS_NOKEY:+ nokey=1}" >>"$RUN/metrics.log" 2>/dev/null
}

need_val() { # "$@" of the option loop: OPT VALUE
  if [ $# -lt 2 ] || [ -z "$2" ]; then usage_die "$1 требует значение"; fi
}

# ── config (key: value; built-in defaults ← config.default ← config) ───────
# Every key: config beats config.default beats the built-in value. The layers are
# also kept apart (CFGU_ config, CFGD_ config.default, CFGB_ built-in) for keys
# with a more specific variant — wait_timeout.<harness>.<platform> — where the
# user's config wins over any default however specific (see wait_timeout_v).
cfg_b() { # KEY VALUE — a built-in default
  local k=${1//./_}
  k=${k//-/_}
  eval "CFG_$k=\$2; CFGB_$k=\$2"
}
cfg_defaults() {
  cfg_b wait_timeout.default 100
  cfg_b wait_timeout.claude 100
  cfg_b wait_timeout.opencode 100
  cfg_b wait_timeout.codex 25
  cfg_b wait_timeout.codex.msys 100
  CFG_heartbeat=30
  CFG_asleep_after=900
  CFG_gone_after=3600
  CFG_dropout_after=300
  CFG_lock_stale=30
  CFG_msg_max_bytes=8192
  CFG_wait_output_max=20000
  CFG_run_timeout=1800
  CFG_runner_stale=60
  CFG_runner_dead_grace=5
}

# cfg_parse FILE CALLBACK — calls CALLBACK KEY VALUE for every valid "key: value" line
cfg_parse() {
  local line k v
  [ -f "$1" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%%#*}
    case $line in *:*) ;; *) continue ;; esac
    k=${line%%:*}
    v=${line#*:}
    k=${k//[[:space:]]/}
    v=${v//[[:space:]]/}
    case $k in '' | *[!A-Za-z0-9_.-]*) continue ;; esac
    case $v in *[!A-Za-z0-9_.-]*) continue ;; esac
    "$2" "$k" "$v"
  done <"$1"
}
cfg_set() {
  local k=${1//./_}
  k=${k//-/_}
  eval "CFG_$k=\$2"
}
CFGL_VARS=
cfg_set_layer() { # PREFIX KEY VALUE — into CFG_ and the layer PREFIX_
  local k=${2//./_}
  k=${k//-/_}
  eval "CFG_$k=\$3; $1_$k=\$3"
  CFGL_VARS="$CFGL_VARS $1_$k"
}
cfg_set_d() { cfg_set_layer CFGD "$@"; } # config.default
cfg_set_u() { cfg_set_layer CFGU "$@"; } # config
cfg_num() { # VAR KEY DEFAULT
  local _cn_k=${2//./_} _cn_v
  _cn_k=${_cn_k//-/_}
  eval "_cn_v=\${CFG_$_cn_k-}"
  is_uint "$_cn_v" || _cn_v=$3
  eval "$1=\$_cn_v"
}
cfg_load() {
  local v
  for v in $CFGL_VARS; do unset "$v"; done # a second load (doctor: another .brigada)
  CFGL_VARS=
  cfg_defaults
  cfg_parse "$ROOT/config.default" cfg_set_d
  cfg_parse "$ROOT/config" cfg_set_u
  cfg_num HEARTBEAT heartbeat 30
  cfg_num ASLEEP_AFTER asleep_after 900
  cfg_num GONE_AFTER gone_after 3600
  cfg_num DROPOUT_AFTER dropout_after 300
  cfg_num LOCK_STALE lock_stale 30
  cfg_num MSG_MAX msg_max_bytes 8192
  cfg_num OUTMAX wait_output_max 20000
  cfg_num RUN_TIMEOUT run_timeout 1800
  cfg_num RUNNER_STALE runner_stale 60
  cfg_num RUNNER_DEAD_GRACE runner_dead_grace 5
  [ "$RUN_TIMEOUT" -ge 1 ] || RUN_TIMEOUT=1
  [ "$HEARTBEAT" -ge 1 ] || HEARTBEAT=1
  [ "$LOCK_STALE" -ge 1 ] || LOCK_STALE=1
  [ "$RUNNER_STALE" -ge 3 ] || RUNNER_STALE=3
  RDG_CFG=$RUNNER_DEAD_GRACE # as configured (doctor)
  [ "$RUNNER_DEAD_GRACE" -lt "$RUNNER_STALE" ] || RUNNER_DEAD_GRACE=$((RUNNER_STALE - 1))
  HB_FRESH=$((HEARTBEAT + 5))
}
platform_key_v() { # VAR PLATFORM — key part for config: Darwin → darwin, MSYS → msys, …
  local _pk_p
  case $2 in
    Darwin) _pk_p=darwin ;;
    Linux) _pk_p=linux ;;
    MSYS) _pk_p=msys ;;
    WSL) _pk_p=wsl ;;
    Cygwin) _pk_p=cygwin ;;
    *) _pk_p=$(printf '%s' "$2" | tr 'A-Z' 'a-z') ;;
  esac
  eval "$1=\$_pk_p"
}
# wait_timeout_v VAR HARNESS [PLATFORM] — the wait timeout of an agent. The user's
# config wins over the defaults, a more specific key within one file:
#   config: wait_timeout.<harness>.<platform>, wait_timeout.<harness>
#   config.default: the same two, then the built-in values: the same two
#   (codex.msys: Codex on Windows blocks instead of parking, DESIGN §5.1);
# none of them — wait_timeout.default, in the same order of files.
wait_timeout_v() {
  local _wt_t= _wt_p= _wt_l _wt_k _wt_v _wt_h=${2//[!a-z0-9_]/_}
  if [ -n "${3:-}" ]; then
    platform_key_v _wt_p "$3"
    _wt_p=${_wt_p//[!a-z0-9_]/_}
  fi
  for _wt_l in CFGU CFGD CFGB; do
    for _wt_k in ${_wt_p:+"${_wt_h}_$_wt_p"} "$_wt_h"; do
      eval "_wt_v=\${${_wt_l}_wait_timeout_$_wt_k-}"
      if is_uint "$_wt_v"; then
        _wt_t=$_wt_v
        break 2
      fi
    done
  done
  if [ -z "$_wt_t" ]; then
    for _wt_l in CFGU CFGD CFGB; do
      eval "_wt_v=\${${_wt_l}_wait_timeout_default-}"
      if is_uint "$_wt_v"; then
        _wt_t=$_wt_v
        break
      fi
    done
  fi
  eval "$1=\${_wt_t:-100}"
}

need_root() {
  if [ ! -f "$ROOT/VERSION" ] || [ ! -d "$ROOT/lobby/messages" ]; then
    die "не найдено состояние brigada в $ROOT" \
      "Агенты вызывают brg из проекта: bash .brigada/bin/brg …" \
      "Создать .brigada в проекте: bash /путь/к/brigada/bin/brg init <каталог_проекта>"
  fi
  [ -d "$RUN/wait" ] && [ -d "$RUN/seen" ] && [ -d "$LOCKS" ] && [ -d "$ROOT/tasks" ] && [ -d "$ROOT/common" ] ||
    mkdir -p "$RUN/wait" "$RUN/seen" "$LOCKS" "$ROOT/tasks" "$ROOT/common" 2>/dev/null
  body_gc
}
# body_gc — remove stdin copies (run/.body.<pid>.<rnd>, see rb_pipe) left by a brg
# killed with SIGKILL while reading stdin: the pid in the name is no longer alive.
body_gc() {
  local f p
  for f in "$RUN"/.body.*; do
    [ -f "$f" ] || continue
    p=${f##*/.body.}
    p=${p%%.*}
    pid_alive "$p" && continue
    rm -f "$f"
  done
}

# pid_alive PID — does the process of a pid read from a file exist? 0 alive, 1 dead;
# PA_WHY = alive | eperm | dead. EPERM ("Operation not permitted": a sandbox, another
# user) means it exists but is out of reach — alive. ESRCH or anything else — dead.
# The only place that reads the text of a kill error (English: LC_ALL=C is set at
# the top). Not a number, or 0 (kill -0 0 signals our own group: always succeeds) —
# dead. Own children and $$ use kill -0 directly. BRG_TEST_EPERM_PIDS (tests):
# "pid pid …" ("*" — any pid) answer EPERM.
PA_WHY=
pid_alive() {
  local e
  PA_WHY=dead
  is_uint "${1:-}" || return 1
  case $1 in *[!0]*) ;; *) return 1 ;; esac
  case " ${BRG_TEST_EPERM_PIDS:-} " in *" $1 "* | *" * "*)
    PA_WHY=eperm
    return 0
    ;;
  esac
  if kill -0 "$1" 2>/dev/null; then
    PA_WHY=alive
    return 0
  fi
  e=$(kill -0 "$1" 2>&1)
  case $e in *"not permitted"*)
    PA_WHY=eperm
    return 0
    ;;
  esac
  return 1
}

# ── locks (DESIGN §4.2): mkdir + owner "pid epoch" ─────────────────────────
# Stale: owner dead, or older than lock_stale (≫ any critical section), or no
# owner file for longer than lock_stale (creator died between mkdir and writing
# the owner). Breaking is serialized by <lock>.brk and done by an atomic rename
# of the lock to a unique name followed by rm: of several breakers only one
# removes the stale lock, and a fresh lock (different owner) is never removed.
# Release removes only our own lock.
HELD=
lock_owner_v() { # VAR DIR — owner line if well-formed ("pid epoch"), else ""
  local _lo_o= _lo_p _lo_e
  [ -f "$2/owner" ] && IFS= read -r _lo_o <"$2/owner" 2>/dev/null
  _lo_p=${_lo_o%% *}
  _lo_e=${_lo_o#* }
  if ! is_uint "$_lo_p" || ! is_uint "$_lo_e" || [ "$_lo_o" != "$_lo_p $_lo_e" ]; then _lo_o=; fi
  eval "$1=\$_lo_o"
}

# lock_stale_check DIR TRIES SINCEVAR [NOAGE] → 0 if stale; LS_OWNER = observed owner,
# LS_WHY = dead | hb (the owner is to blame) | "" (no owner / age).
# SINCEVAR keeps the time the lock was first seen without an owner. NOAGE: the age
# of the lock does not count (the exec lock of `brg run` is held for minutes): a
# live owner is stale only when its heartbeat (DIR/hb, see lock_hb_v) is older
# than runner_stale and the caller has been watching long enough to tell (HB_JUDGE,
# see hb_obs_tick) — a guard against a reused pid and a hung runner; a dead owner
# only when its heartbeat is silent as well (runner_gone).
LS_WHY=
LS_HBAGE=
lock_stale_check() {
  local o since f w=hb
  lock_owner_v o "$1"
  LS_OWNER=$o
  LS_WHY=
  if [ -n "$o" ]; then
    eval "$3="
    if ! pid_alive "${o%% *}"; then
      if [ -z "${4:-}" ]; then
        LS_WHY=dead
        return 0
      fi
      # the exec lock: a dead-looking runner may be alive in another pid
      # namespace — dead once its heartbeat is silent too (runner_gone); until
      # then it is judged as a live one below
      lock_hb_v f "$1" "$o"
      get_now
      LS_HBAGE=$((NOW - f))
      if runner_gone "$f"; then
        LS_WHY=dead
        return 0
      fi
      w=dead
    fi
    if [ -n "${4:-}" ]; then
      [ -n "${HB_JUDGE:-}" ] || return 1
      lock_hb_v f "$1" "$o"
      get_now
      LS_HBAGE=$((NOW - f))
      [ "$LS_HBAGE" -gt "$RUNNER_STALE" ] || return 1
      LS_WHY=$w
      return 0
    fi
    if [ $(($2 % 20)) -eq 0 ]; then
      get_now
      [ $((NOW - ${o#* })) -gt "$LOCK_STALE" ] && return 0
    fi
    return 1
  fi
  [ -d "$1" ] || return 1 # released meanwhile
  get_now
  eval "since=\${$3}"
  if [ -z "$since" ]; then
    eval "$3=\$NOW"
    return 1
  fi
  [ $((NOW - since)) -gt "$LOCK_STALE" ]
}

# lock_hb_v VAR DIR OWNER — when the owner of a lock last showed life: the epoch
# in DIR/hb ("pid epoch", written by the owner every tick) if it is that owner's
# and newer, else the epoch of acquiring (from OWNER, "pid epoch")
lock_hb_v() {
  local _lh_h= _lh_e=${3#* }
  [ -f "$2/hb" ] && { IFS= read -r _lh_h <"$2/hb"; } 2>/dev/null
  if [ "${_lh_h%% *}" = "${3%% *}" ] && is_uint "${_lh_h#* }" && [ "${_lh_h#* }" -gt "$_lh_e" ]; then
    _lh_e=${_lh_h#* }
  fi
  eval "$1=\$_lh_e"
}
# Watching for heartbeats (a runner waiting for its turn): a heartbeat older than
# runner_stale means "dead" only if this process itself has been running without a
# gap for longer than runner_stale. After a gap (the machine slept, the process was
# stopped) the others get a fresh grace period: they were frozen too and have not
# had a chance to beat yet. → HB_JUDGE=1 when allowed to judge.
# HB_OBS — since when we watch without a gap ("" — not watching: a one-shot check);
# HB_OBS_D — the same with the tighter gap of runner_dead_grace (see runner_gone):
# a gap must not pass for that much silence. Two marks, so that a loaded machine
# (gaps of a few seconds) does not delay the runner_stale verdict.
HB_JUDGE=
HB_OBS=
HB_OBS_D=
hb_obs_init() {
  get_now
  HB_OBS=$NOW HB_OBS_D=$NOW HB_LAST=$NOW HB_JUDGE=
}
hb_obs_tick() { # after get_now
  local gap=$((RUNNER_STALE / 2)) g=$((RUNNER_DEAD_GRACE / 2)) d=$((NOW - HB_LAST))
  [ "$gap" -ge 2 ] || gap=2
  [ "$gap" -le 10 ] || gap=10
  [ "$g" -ge 2 ] || g=2
  [ "$d" -gt "$gap" ] && HB_OBS=$NOW
  [ "$d" -gt "$g" ] && HB_OBS_D=$NOW
  HB_LAST=$NOW
  HB_JUDGE=
  [ $((NOW - HB_OBS)) -gt "$RUNNER_STALE" ] && HB_JUDGE=1
  return 0
}
# runner_gone HB — a runner whose pid pid_alive calls dead: is it really gone? A pid
# namespace may hide a live process (ESRCH), so its heartbeat (epoch HB; "" — none)
# must be older than runner_dead_grace too, and a runner watching from the queue
# (HB_OBS_D set) must have watched without a gap that long: after a sleep every
# heartbeat looks old. One-shot checks (views, doctor) skip the last condition.
# NOW set.
runner_gone() {
  local a=$RUNNER_DEAD_GRACE
  is_uint "${1:-}" && a=$((NOW - $1))
  [ "$a" -ge "$RUNNER_DEAD_GRACE" ] || return 1
  [ -z "$HB_OBS_D" ] || [ $((NOW - HB_OBS_D)) -ge "$RUNNER_DEAD_GRACE" ]
}

# lock_break DIR OBSERVED_OWNER → 0 if the caller should retry mkdir at once
LB_BRK_SINCE=
lock_break() {
  local d=$1 b=$1.brk t=$1.stale.$$.$RANDOM o
  if ! mkdir "$b" 2>/dev/null; then
    # another breaker is at work; clean up after a breaker that died
    if lock_stale_check "$b" 20 LB_BRK_SINCE; then
      mv "$b" "$t.brk" 2>/dev/null && rm -rf "$t.brk"
      LB_BRK_SINCE=
    fi
    return 1
  fi
  LB_BRK_SINCE=
  get_now
  printf '%s %s\n' "$$" "$NOW" >"$b/owner"
  lock_owner_v o "$d"
  if [ -d "$d" ] && [ "$o" = "$2" ] && mv "$d" "$t" 2>/dev/null; then
    lock_owner_v o "$t"
    if [ "$o" = "$2" ]; then
      rm -rf "$t"
      metric lock.break lock="${d##*/}" owner="${2:-none}"${LS_WHY:+ why=$LS_WHY}
    elif [ ! -e "$d" ]; then
      mv "$t" "$d" 2>/dev/null # changed hands between check and rename: put back
    fi
  fi
  lock_owner_v o "$b"
  [ "${o%% *}" = "$$" ] && rm -rf "$b"
  return 0
}

# lock_try NAME NOAGE TRIESVAR SINCEVAR — one attempt; a stale lock is broken and
# the attempt repeated at once. 0 if acquired. TRIESVAR/SINCEVAR keep the state
# between attempts (zero/empty them before the first one). LOCK_DEAD_HOOK, if
# set, is called as HOOK DIR OWNER before a lock of a dead owner is broken.
LOCK_DEAD_HOOK=
lock_try() {
  local d=$LOCKS/$1.lock t o w
  while ! mkdir "$d" 2>/dev/null; do
    if [ ! -d "$LOCKS" ]; then
      mkdir -p "$LOCKS" 2>/dev/null || die "нет каталога блокировок: $LOCKS"
      continue
    fi
    eval "t=\$(($3 + 1)); $3=\$t"
    lock_stale_check "$d" "$t" "$4" "$2" || return 1
    eval "$4="
    o=$LS_OWNER
    w=$LS_WHY
    if [ -n "$LOCK_DEAD_HOOK" ] && [ -n "$o" ] && [ -n "$w" ]; then
      "$LOCK_DEAD_HOOK" "$d" "$o" # may take other locks
      LS_WHY=$w
    fi
    lock_break "$d" "$o" || return 1
  done
  get_now
  printf '%s %s\n' "$$" "$NOW" >"$d/owner"
  HELD="$HELD $1"
}

LA_MISS_SINCE=
LA_TRIES=0
lock_acquire() { # NAME [NOAGE]
  LA_MISS_SINCE=
  LA_TRIES=0
  while ! lock_try "$1" "${2:-}" LA_TRIES LA_MISS_SINCE; do sleep 0.05; done
}

lock_release() { # NAME — only our own lock
  local d=$LOCKS/$1.lock o
  lock_owner_v o "$d"
  [ "${o%% *}" = "$$" ] && rm -rf "$d"
  HELD=${HELD/ $1/}
}
release_all() {
  local n
  for n in $HELD; do lock_release "$n"; done
  rb_cleanup # stdin reader of read_body
}

# ── roster ─────────────────────────────────────────────────────────────────
profile_read() { # FILE → P_KEY P_HARNESS P_MODEL P_PLATFORM P_LEFT P_JOINED (epoch)
  local line
  P_KEY= P_HARNESS= P_MODEL= P_PLATFORM= P_LEFT= P_JOINED=
  [ -f "$1" ] || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    case $line in
      '') break ;;
      Key:*) P_KEY=${line#Key: } ;;
      Harness:*) P_HARNESS=${line#Harness: } ;;
      Model:*) P_MODEL=${line#Model: } ;;
      Platform:*) P_PLATFORM=${line#Platform: } ;;
      Left:*) P_LEFT=${line#Left: } ;;
      Joined-Epoch:*) P_JOINED=${line#Joined-Epoch: } ;;
    esac
  done <"$1"
  return 0
}

list_agents() { # → AGENT_NAMES (space-separated)
  local f n
  AGENT_NAMES=
  for f in "$ROOT"/agents/*; do
    [ -f "$f" ] || continue
    n=${f##*/}
    valid_name "$n" || continue
    AGENT_NAMES="$AGENT_NAMES $n"
  done
}

# Session key (DESIGN §3): join gives "<base>.<key>"; the key lives only in the
# profile (Key:) and is checked by need_agent. Harness names are [a-z0-9], so the
# first dot splits a full name.
KEY_ABC=abcdefghijkmnpqrstuvwxyz23456789 # 32 chars: [a-z2-9] without l and o
key_gen_v() { # VAR — a fresh key: 6 chars of KEY_ABC
  local _kg_k= _kg_i
  for _kg_i in 1 2 3 4 5 6; do _kg_k=$_kg_k${KEY_ABC:$((RANDOM % 32)):1}; done
  eval "$1=\$_kg_k"
}
key_ok() { # KEY — 0 if it has the form of a key: [a-z2-9]{6}
  case $1 in [a-z2-9][a-z2-9][a-z2-9][a-z2-9][a-z2-9][a-z2-9]) return 0 ;; esac
  return 1
}

# need_agent write|read — resolve --as / BRG_AS into AGENT (the base name: all
# state lives under it), ASN (the full name, for --as hints and NEXT) and A_*.
# Commands that change state ("write") need the session key; "read" commands also
# take the bare base name (subagents) — then AS_NOKEY=1: no Last-Seen, hints with
# a placeholder. A wrong key is refused by every command. A profile without Key:
# (joined before 0.2.0) takes the bare name everywhere. On a refusal NEXT is join:
# "fix and repeat with --as <same name>" would loop the agent.
need_agent() {
  local n=${OPT_AS:-${BRG_AS:-}} b k= dot= j="$BRG join --harness <харнесс> --model <модель>"
  if [ -z "$n" ]; then
    die "нужно имя агента: --as <имя> (или переменная BRG_AS)" \
      "Имя выдаёт join: $j"
  fi
  b=${n%%.*}
  case $n in *.*) dot=1 k=${n#*.} ;; esac
  if ! valid_name "$n" || [ ! -f "$ROOT/agents/$b" ]; then
    NEXT_ON_ERR=$j
    die "неизвестный агент: $n" \
      "Подключись (имя выдаст join): $j"
  fi
  profile_read "$ROOT/agents/$b"
  AS_NOKEY=
  if [ -n "$dot" ]; then
    if [ -z "$P_KEY" ] || [ "$k" != "$P_KEY" ] || ! key_ok "$k"; then
      NEXT_ON_ERR=$j
      die "ключ устарел или с ошибкой: под именем $b переподключилась другая сессия" \
        "Сверь имя с выводом своего join в этом чате (полное имя повторяется в последней строке NEXT:). Если ты не делал join в этом чате — сделай join (получишь новое имя)."
    fi
  elif [ -n "$P_KEY" ]; then
    if [ "${1:-write}" != read ]; then
      NEXT_ON_ERR=$j
      die "имя $b занято другой сессией" \
        "Твоё имя — только из вывода твоего join в этом чате (полное, с ключом после точки: $b.<ключ>); не видишь его — сделай join (получишь новое имя)."
    fi
    AS_NOKEY=1
  fi
  AGENT=$b
  AGENT_FILE=$ROOT/agents/$b
  if [ -n "$AS_NOKEY" ]; then ASN='<твоё имя из join>'; else ASN=$n; fi
  A_HARNESS=$P_HARNESS A_MODEL=$P_MODEL A_PLATFORM=$P_PLATFORM
  if [ -n "$P_LEFT" ]; then
    NEXT_ON_ERR="заверши ход (или, если человек просит вернуться: $BRG join --as $b --harness ${A_HARNESS:-<харнесс>})"
    die "агент $b отключён (brg leave)" \
      "Вернуться под тем же именем (курсоры сохранены, ключ будет новый): $BRG join --as $b --harness ${A_HARNESS:-<харнесс>}"
  fi
  stop_banner
}

# The human's stop (DESIGN §9) seen by any agent command, not only by wait.
stop_who_v() { # VAR — whom the human stopped: "бригаду" | "тебя (NAME)"; 1 if nobody
  local _sw_w
  if [ -e "$RUN/stopped" ]; then
    _sw_w="бригаду"
  elif [ -n "$AGENT" ] && [ -e "$RUN/stopped.$AGENT" ]; then
    _sw_w="тебя ($AGENT)"
  else
    return 1
  fi
  eval "$1=\$_sw_w"
}
# stop_banner — the first line of an agent command while stopped; once per process.
# wait and status print STOP themselves, task new lifts it: they set STOP_SHOWN.
STOP_SHOWN=
stop_banner() {
  local w
  [ -z "$STOP_SHOWN" ] || return 0
  stop_who_v w || return 0
  STOP_SHOWN=1
  echo "── STOP: человек остановил $w. Новую работу не начинай: сдай сделанное, если нужно (send, item done), и заверши ход."
}
# stop_refuse WHAT — commands that start work (item add|claim|reassign, item review
# --start, run) are refused while stopped; NEXT is "end the turn": wait would only
# return STOP.
stop_refuse() {
  local w
  stop_who_v w || return 0
  NEXT_ON_ERR="заверши ход (стоп снимет человек и напишет тебе «продолжай»)"
  die "человек остановил $w — $1 не выполнено: при стопе новую работу не начинают" \
    "Можно сдать сделанное и сообщить: send, item done|release, item review --verdict, task close. Стоп снимает только человек."
}

touch_seen() { # [NAME] — Last-Seen := now (not for a read command without the key)
  local n=${1:-$AGENT} f
  [ -n "$n" ] || return 0
  [ -z "${1:-}" ] && [ -n "$AS_NOKEY" ] && return 0
  [ -n "$NOW" ] || get_now
  f=$RUN/seen/$n
  printf '%s\n' "$NOW" >"$RUN/seen/.tmp.$n.$$" 2>/dev/null && mv_retry "$RUN/seen/.tmp.$n.$$" "$f"
}

# wait_info NAME → WI_PID (from the pid file), WI_ALIVE=1 if that wait is alive
# (pid alive and its heartbeat file is fresh — guards against pid reuse); WI_HBE —
# the epoch of the heartbeat file, if any (a wait killed by KILL leaves it behind).
wait_info() {
  local p= hb= hp he
  WI_PID= WI_ALIVE= WI_HBE=
  [ -f "$RUN/wait/$1.hb" ] && IFS= read -r hb <"$RUN/wait/$1.hb"
  hp=${hb%% *}
  he=${hb#* }
  [ "$hb" = "$hp $he" ] && is_uint "$he" && WI_HBE=$he
  [ -f "$RUN/wait/$1.pid" ] && IFS= read -r p <"$RUN/wait/$1.pid"
  is_uint "$p" || return 0
  WI_PID=$p
  [ "$hp" = "$p" ] && is_uint "$he" || return 0
  [ $((NOW - he)) -le "$HB_FRESH" ] || return 0
  pid_alive "$p" && WI_ALIVE=1
  return 0
}

# agent_state NAME → ST (waiting|working|asleep|gone), ST_SEEN (epoch), ST_LEFT
agent_state() {
  local s= age
  profile_read "$ROOT/agents/$1"
  ST_LEFT=$P_LEFT
  [ -f "$RUN/seen/$1" ] && IFS= read -r s <"$RUN/seen/$1"
  is_uint "$s" || s=0
  ST_SEEN=$s
  if [ -n "$P_LEFT" ]; then
    ST=gone
    return
  fi
  wait_info "$1"
  if [ -n "$WI_ALIVE" ]; then
    ST=waiting
    return
  fi
  age=$((NOW - s))
  if [ "$age" -gt "$GONE_AFTER" ]; then
    ST=gone
  elif [ "$age" -gt "$ASLEEP_AFTER" ]; then
    ST=asleep
  else
    ST=working
  fi
}

# wait_last_mark [NAME] — run/wait/<name>.last := now: the last moment the agent
# was in (or about to enter) its wait loop — written by join and by a finishing wait.
wait_last_mark() {
  local n=${1:-$AGENT}
  [ -d "$RUN/wait" ] || return 0
  [ -n "$NOW" ] || get_now
  printf '%s\n' "$NOW" >"$RUN/wait/.tmp.last.$n.$$" 2>/dev/null && mv_retry "$RUN/wait/.tmp.last.$n.$$" "$RUN/wait/$n.last"
}

# idle_calc NAME — right after agent_state NAME: ID_D — seconds since the agent was
# last in its wait loop (wait/<name>.last, the heartbeat of a killed wait, else
# Joined-Epoch; -1 if unknown), ID_T — its wait timeout + 60 s, ID_P — the dropout
# threshold max(ID_T, dropout_after).
idle_calc() {
  local l=
  [ -f "$RUN/wait/$1.last" ] && IFS= read -r l <"$RUN/wait/$1.last"
  is_uint "$l" || l=0
  [ -n "$WI_HBE" ] && [ "$WI_HBE" -gt "$l" ] && l=$WI_HBE
  [ "$l" -gt 0 ] || { is_uint "$P_JOINED" && l=$P_JOINED; }
  wait_timeout_v ID_T "$P_HARNESS" "$P_PLATFORM"
  ID_T=$((ID_T + 60))
  ID_P=$ID_T
  [ "$DROPOUT_AFTER" -gt "$ID_P" ] && ID_P=$DROPOUT_AFTER
  ID_D=-1
  [ "$l" -gt 0 ] && ID_D=$((NOW - l))
  return 0
}

# idle_note_v VAR NAME SEP — right after agent_state NAME: for an agent without a live
# wait (working/asleep) once that lasts longer than its wait timeout + 60 s:
# "<SEP>без wait 5 мин"; plus "<SEP>возможно выпал" if neither a wait nor a brg call
# for longer than max(wait timeout + 60 s, dropout_after) — an agent quietly writing
# code for a few minutes is not flagged (the model may have ended its turn: DESIGN
# §5.3 — the human tells it "продолжай"); not for an agent the human stopped. ""
# otherwise. The states themselves (asleep/gone) do not change.
idle_note_v() {
  local _id_r= _id_x
  case $ST in
    working | asleep) ;;
    *)
      eval "$1="
      return 0
      ;;
  esac
  idle_calc "$2"
  if [ "$ID_D" -gt "$ID_T" ]; then
    dur_v _id_x "$ID_D"
    _id_r="$3без wait $_id_x"
    if [ "$ID_D" -gt "$ID_P" ] && [ $((NOW - ST_SEEN)) -gt "$ID_P" ] && [ ! -e "$RUN/stopped" ] && [ ! -e "$RUN/stopped.$2" ]; then
      _id_r="$_id_r${3}возможно выпал"
    fi
  fi
  eval "$1=\$_id_r"
}

# online_v VAR EXCLUDE — "name (harness, model, state[, без wait …]), …" of agents not gone
online_v() {
  local _on_n _on_s= _on_i
  list_agents
  for _on_n in $AGENT_NAMES; do
    [ "$_on_n" = "$2" ] && continue
    agent_state "$_on_n"
    [ "$ST" = gone ] && continue
    idle_note_v _on_i "$_on_n" ", "
    _on_s="$_on_s${_on_s:+, }$_on_n ($P_HARNESS, $P_MODEL, $ST$_on_i)"
  done
  eval "$1=\$_on_s"
}

# win_note — for agents in PowerShell/cmd (started through bin/brg.cmd): no heredoc there
win_note() {
  [ -n "${BRG_VIA_CMD:-}" ] || return 0
  echo "Ты вызываешь brg из PowerShell/cmd: команда — $BRG …; heredoc здесь нет — текст сообщения в файл (UTF-8) и --file <путь>; короткое описание подзадачи/ревью — --desc/--comment \"…\"."
}
harness_hint_v() { # VAR HARNESS TIMEOUT [PLATFORM]
  local _hh_ms=$((($3 + 60) * 1000)) _hh_s _hh_park
  [ $_hh_ms -gt 600000 ] && _hh_ms=600000
  _hh_park="если команда всё же «запаркована» (управление вернулось, а процесс идёт) — дождись её опросом сессии (write_stdin с пустым вводом и максимальным yield_time_ms); второй wait не запускай."
  case $2 in
    claude) _hh_s="Claude Code: в Bash tool передавай timeout: $_hh_ms (мс) и не используй run_in_background." ;;
    opencode) _hh_s="OpenCode: в инструменте shell/bash передавай timeout: $_hh_ms (мс)." ;;
    codex)
      if [ "${4:-}" = MSYS ]; then
        _hh_s="Codex (Windows): wait блокирует команду до $3 с — если инструмент принимает лимит времени, ставь ≥ $_hh_ms мс; $_hh_park"
      else
        _hh_s="Codex: wait короткий ($3 с), чтобы вернуться до «парковки» команды; $_hh_park"
      fi
      ;;
    *) _hh_s="Если харнесс ограничивает время команды — ставь лимит ≥ $_hh_ms мс; если он всё же прервал wait — просто вызови wait снова." ;;
  esac
  eval "$1=\$_hh_s"
}

# ── tasks: lookup (DESIGN §6) ──────────────────────────────────────────────
# tasks/<id>[-<slug>]/: task (headers), brief.md, seq, messages/, cursors/,
# items/, reservations/, shared/, summary.md. tasks/active holds the dir name of
# the only active task (absent: none). Changes are made under the "task" lock;
# the pointer is written last on creation and removed last on close/cancel.
BRIEF_MAX=65536

# task_norm_id_v VAR RAW — T1 | t001 | 1 | T001-slug → T001; 1 if not a task id
task_norm_id_v() {
  local _tn_n=${2%%-*}
  case $_tn_n in [Tt]*) _tn_n=${_tn_n#?} ;; esac
  is_uint "$_tn_n" && [ ${#_tn_n} -le 6 ] || return 1
  _tn_n=$((10#$_tn_n))
  [ "$_tn_n" -gt 0 ] || return 1
  printf -v _tn_n 'T%03d' "$_tn_n"
  eval "$1=\$_tn_n"
}
task_dir_v() { # VAR ID — absolute dir of task ID; 1 if none
  local _td_f _td_d=
  for _td_f in "$ROOT/tasks/$2" "$ROOT/tasks/$2"-*; do
    if [ -f "$_td_f/task" ]; then
      _td_d=$_td_f
      break
    fi
  done
  eval "$1=\$_td_d"
  [ -n "$_td_d" ]
}
# active_task → ACT_NAME (dir name), ACT_ID, ACT_DIR; ACT_RAW = pointer as read. 1 if none.
active_task() {
  ACT_RAW= ACT_NAME= ACT_ID= ACT_DIR=
  [ -f "$ROOT/tasks/active" ] && { IFS= read -r ACT_RAW <"$ROOT/tasks/active"; } 2>/dev/null
  case $ACT_RAW in T[0-9][0-9][0-9]*) ;; *) return 1 ;; esac
  case $ACT_RAW in */* | *..* | *[!A-Za-z0-9-]*) return 1 ;; esac
  [ -f "$ROOT/tasks/$ACT_RAW/task" ] || return 1
  ACT_NAME=$ACT_RAW
  ACT_ID=${ACT_RAW%%-*}
  ACT_DIR=$ROOT/tasks/$ACT_RAW
}

# task_read DIR → TK_* (TK_EXTRA keeps unknown header lines for later stages)
task_read() {
  local line
  TK_ID= TK_TITLE= TK_STATUS= TK_HOST= TK_LEAD= TK_CREATED= TK_CREATED_EPOCH= TK_CREATED_BY=
  TK_CLOSED= TK_CLOSED_EPOCH= TK_CLOSED_BY= TK_EXTRA=
  [ -f "$1/task" ] || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    case $line in
      '') break ;;
      'Id: '*) TK_ID=${line#Id: } ;;
      'Title: '*) TK_TITLE=${line#Title: } ;;
      'Status: '*) TK_STATUS=${line#Status: } ;;
      'Host: '*) TK_HOST=${line#Host: } ;;
      'Lead: '*) TK_LEAD=${line#Lead: } ;;
      'Created: '*) TK_CREATED=${line#Created: } ;;
      'Created-Epoch: '*) TK_CREATED_EPOCH=${line#Created-Epoch: } ;;
      'Created-By: '*) TK_CREATED_BY=${line#Created-By: } ;;
      'Closed: '*) TK_CLOSED=${line#Closed: } ;;
      'Closed-Epoch: '*) TK_CLOSED_EPOCH=${line#Closed-Epoch: } ;;
      'Closed-By: '*) TK_CLOSED_BY=${line#Closed-By: } ;;
      *) TK_EXTRA=$TK_EXTRA$line$NL ;;
    esac
  done <"$1/task"
  return 0
}
task_write() { # DIR — TK_* → DIR/task (tmp + mv)
  local t=$1/.tmp.task.$$
  if ! {
    printf 'Id: %s\nTitle: %s\nStatus: %s\nHost: %s\nLead: %s\nCreated: %s\nCreated-Epoch: %s\nCreated-By: %s\n' \
      "$TK_ID" "$TK_TITLE" "$TK_STATUS" "$TK_HOST" "$TK_LEAD" "$TK_CREATED" "$TK_CREATED_EPOCH" "$TK_CREATED_BY"
    [ -z "$TK_CLOSED" ] || printf 'Closed: %s\nClosed-Epoch: %s\nClosed-By: %s\n' "$TK_CLOSED" "$TK_CLOSED_EPOCH" "$TK_CLOSED_BY"
    printf '%s' "$TK_EXTRA"
  } >"$t" || ! mv_retry "$t" "$1/task"; then
    rm -f "$t"
    die "не удалось записать $1/task"
  fi
}

# role_v VAR NAME — role of NAME in the loaded task (TK_*)
role_v() {
  local _ro_r=
  [ "$2" = "$TK_HOST" ] && _ro_r=host
  [ "$2" = "$TK_LEAD" ] && _ro_r=${_ro_r:+$_ro_r и }lead
  eval "$1=\${_ro_r:-участник}"
}

# task_info_lines NAME — the active task block for join/status (ACT_*/TK_* loaded)
task_info_lines() {
  local role plan=" (пока нет — его пишет lead)" sum= rl="твоя роль"
  role_v role "$1"
  [ -n "${AS_NOKEY:-}" ] && rl="роль $1" # no key: do not confirm the identity
  [ -f "$ACT_DIR/shared/plan.md" ] && plan=
  [ -s "$ACT_DIR/summary.md" ] && sum=" · итог: $RROOT/tasks/$ACT_NAME/summary.md"
  echo "Активная задача: $ACT_ID «$TK_TITLE» · host $TK_HOST · lead $TK_LEAD · $rl: $role"
  echo "  Постановка: $RROOT/tasks/$ACT_NAME/brief.md · план: $RROOT/tasks/$ACT_NAME/shared/plan.md$plan$sum"
  echo "  История переписки задачи: $BRG read --as ${ASN:-$1} --channel $ACT_ID --since 0"
}

# ── channels ───────────────────────────────────────────────────────────────
# A channel is a directory with seq, messages/NNNNNN.msg, cursors/<name>:
# `lobby` and the task channels (Channel: T001 → tasks/T001-<slug>/).
chan_dir() { # VAR CHANNEL → CHAN_ID (normalized name); 1 if unknown
  local _cd_id _cd_d
  case $2 in
    lobby)
      CHAN_ID=lobby
      eval "$1=\$ROOT/lobby"
      ;;
    [Tt][0-9]*)
      task_norm_id_v _cd_id "$2" || return 1
      task_dir_v _cd_d "$_cd_id" || return 1
      CHAN_ID=$_cd_id
      eval "$1=\$_cd_d"
      ;;
    *) return 1 ;;
  esac
}
# channels every wait listens to: lobby + the active task
listen_channels() {
  LISTEN=lobby
  active_task && LISTEN="lobby $ACT_ID"
  LISTEN_RAW=$ACT_RAW
}
# listen_set — channels of AGENT's wait/read/status: LISTEN plus finished tasks
# that still hold something for AGENT (a batch issued but not confirmed, or
# messages after its cursor — e.g. the lead's last word right before close).
# Such a channel is drained like any other (at-least-once) and then dropped.
# A finished task without AGENT's cursor (never listened to) is not drained.
# → LS_N, LS_CH[] (ids), LS_NOTE[] ("" | " (закрыта)" | " (отменена)")
listen_set() {
  local f d n s st
  listen_channels
  LS_N=0
  LS_CH=()
  LS_NOTE=()
  for n in $LISTEN; do
    LS_CH[LS_N]=$n
    LS_NOTE[LS_N]=
    LS_N=$((LS_N + 1))
  done
  for f in "$ROOT"/tasks/T[0-9]*/cursors/"$AGENT"; do
    [ -f "$f" ] || continue
    d=${f%/cursors/*}
    n=${d##*/}
    n=${n%%-*}
    [ "$n" = "$ACT_ID" ] && continue
    cursor_read "$f"
    seq_read_v s "$d"
    [ "$CUR_PEND" -gt "$CUR_ACK" ] || [ "$CUR_ACK" -lt "$s" ] || continue
    task_status_v st "$d"
    case $st in done) st=" (закрыта)" ;; cancelled) st=" (отменена)" ;; *) st= ;; esac
    LS_CH[LS_N]=$n
    LS_NOTE[LS_N]=$st
    LS_N=$((LS_N + 1))
  done
}
ls_note_v() { # VAR ID — LS_NOTE of channel ID in the last listen_set ("" if none)
  local _ln_i=0 _ln_r=
  while [ $_ln_i -lt "${LS_N:-0}" ]; do
    [ "${LS_CH[_ln_i]}" = "$2" ] && _ln_r=${LS_NOTE[_ln_i]}
    _ln_i=$((_ln_i + 1))
  done
  eval "$1=\$_ln_r"
}
task_status_v() { # VAR DIR — Status header of the task (TK_* untouched)
  local _ts_l _ts_s=
  while IFS= read -r _ts_l || [ -n "$_ts_l" ]; do
    case $_ts_l in
      '') break ;;
      'Status: '*)
        _ts_s=${_ts_l#Status: }
        break
        ;;
    esac
  done <"$2/task"
  eval "$1=\$_ts_s"
}
# skip_finished_tasks — AGENT's cursors in finished tasks := their end (an agent
# back after leave does not get the chatter of tasks finished meanwhile)
skip_finished_tasks() {
  local f d n s
  for f in "$ROOT"/tasks/T[0-9]*/cursors/"$AGENT"; do
    [ -f "$f" ] || continue
    d=${f%/cursors/*}
    n=${d##*/}
    [ "$n" = "$ACT_NAME" ] && continue
    seq_read_v s "$d"
    cursor_write "$f" "$s" "$s"
  done
}
# where send/say/read --since go by default: the active task, else lobby
default_channel() {
  DEFCHAN=lobby
  active_task && DEFCHAN=$ACT_ID
}
# chan_writable CHANNEL → CHAN_DIR, CHAN_ID; dies on an unknown or finished channel
chan_writable() {
  local x
  if ! chan_dir CHAN_DIR "$1"; then
    x=lobby
    active_task && x="$x, $ACT_ID"
    die "нет канала: $1" "Каналы: $x."
  fi
  [ "$CHAN_ID" = lobby ] && return 0
  active_task
  [ "$CHAN_ID" = "$ACT_ID" ] && return 0
  task_read "$CHAN_DIR"
  die "задача $CHAN_ID не активна (${TK_STATUS:-?}): в её канал никто не смотрит" \
    "Пиши в ${ACT_ID:+канал активной задачи (по умолчанию) или }lobby (--channel lobby)."
}

seq_scan_max() { # VAR DIR — highest message number on disk
  local _sm_f _sm_b _sm_m=0 _sm_k
  for _sm_f in "$2"/messages/*.msg; do
    _sm_b=${_sm_f##*/}
    _sm_b=${_sm_b%.msg}
    case $_sm_b in '' | *[!0-9]*) continue ;; esac
    _sm_k=$((10#$_sm_b))
    [ $_sm_k -gt $_sm_m ] && _sm_m=$_sm_k
  done
  eval "$1=\$_sm_m"
}

seq_read_v() { # VAR DIR — seq (recomputed from files if missing/broken)
  local _sr_s=
  [ -f "$2/seq" ] && IFS= read -r _sr_s <"$2/seq"
  is_uint "$_sr_s" && [ ${#_sr_s} -le 15 ] || seq_scan_max _sr_s "$2"
  eval "$1=\$_sr_s"
}

# msg_write CHANNEL FROM TO KIND RE — body in $BODY, time in NOW/ISO, extra
# header lines in $MSG_EXTRA ("Key: value\n"…) → MSG_ID.
# Under the channel lock: seq+1 → temp file → mv into messages/ → seq (tmp+mv).
# A file already at seq+1 means a crash between mv and the seq update: seq is
# recomputed as the highest file number. A seq far above the highest file
# (corrupted) is not trusted either.
MSG_EXTRA=
QUIET="Wake: no$NL" # informational system message: does not wake wait (DESIGN §5)
# "Wake: a,b" — the message wakes only a and b; for the other addressees it is quiet.
# wake_extra_v VAR NAMES — that header for NAMES (comma list) minus AGENT; "Wake: no" if none left
wake_extra_v() {
  local _we_r= _we_x _we_rest=$2,
  while [ -n "$_we_rest" ]; do
    _we_x=${_we_rest%%,*}
    _we_rest=${_we_rest#*,}
    [ -n "$_we_x" ] && [ "$_we_x" != "$AGENT" ] || continue
    case ",$_we_r," in *",$_we_x,"*) continue ;; esac
    _we_r=$_we_r${_we_r:+,}$_we_x
  done
  eval "$1=\"Wake: \${_we_r:-no}\$NL\""
}
msg_write() {
  local c=$1 d s n f m tmp
  chan_dir d "$c" || die "нет канала: $c"
  lock_acquire "chan.$c"
  seq_read_v s "$d"
  if [ "$s" -gt 0 ]; then
    printf -v f '%s/messages/%06d.msg' "$d" "$s"
    if [ ! -f "$f" ]; then
      seq_scan_max m "$d"
      if [ "$s" -gt $((m + SCAN_HOLES)) ]; then
        metric seq.reset channel="$c" seq="$s" max="$m"
        s=$m
      fi
    fi
  fi
  n=$((s + 1))
  printf -v f '%s/messages/%06d.msg' "$d" "$n"
  if [ -e "$f" ]; then
    seq_scan_max m "$d"
    [ "$m" -ge "$n" ] && n=$((m + 1))
    printf -v f '%s/messages/%06d.msg' "$d" "$n"
    metric seq.recover channel="$c" seq="$s" max="$m"
  fi
  tmp=$d/messages/.tmp.$$
  if ! {
    printf 'Id: %s\nChannel: %s\nFrom: %s\nTo: %s\nKind: %s\n' "$n" "$c" "$2" "$3" "$4"
    [ -z "$5" ] || printf 'Re: %s\n' "$5"
    printf '%s' "$MSG_EXTRA"
    printf 'Time: %s\nEpoch: %s\n\n%s\n' "$ISO" "$NOW" "$BODY"
  } >"$tmp"; then
    rm -f "$tmp"
    lock_release "chan.$c"
    die "не удалось записать сообщение в $d/messages"
  fi
  if ! mv_retry "$tmp" "$f"; then
    rm -f "$tmp"
    lock_release "chan.$c"
    die "не удалось записать $f"
  fi
  printf '%s\n' "$n" >"$d/.seq.tmp.$$" && mv_retry "$d/.seq.tmp.$$" "$d/seq"
  lock_release "chan.$c"
  MSG_ID=$n
}

# Cursor (DESIGN §5): "Acked: N" — everything ≤ N handled; "Pending: M" — issued
# by the last wait, acknowledged by the next one. Pending = Acked: nothing pending.
cursor_read() { # FILE → CUR_ACK CUR_PEND
  local line v
  CUR_ACK=0 CUR_PEND=
  if [ -f "$1" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      v=${line#*:}
      v=${v//[[:space:]]/}
      case $line in
        Acked:*) is_uint "$v" && CUR_ACK=$v ;;
        Pending:*) is_uint "$v" && CUR_PEND=$v ;;
      esac
    done <"$1"
  fi
  [ -n "$CUR_PEND" ] && [ "$CUR_PEND" -ge "$CUR_ACK" ] || CUR_PEND=$CUR_ACK
}
cursor_write() { # FILE ACKED PENDING
  local t=${1%/*}/.tmp.${1##*/}.$$
  printf 'Acked: %s\nPending: %s\n' "$2" "$3" >"$t" && mv_retry "$t" "$1"
}

# scan_new DIR AFTER → SCAN_FILES[], SCAN_N, SCAN_MAX: message files with id > AFTER.
# Walks ids upwards; a missing id ≤ seq is a hole (skipped), above seq — the end.
# A file above seq (crash before the seq update) is still picked up. A seq far
# ahead whose own file is missing is not trusted (corrupted), and the walk stops
# after SCAN_HOLES missing ids in a row.
SCAN_LIMIT=1000
SCAN_HOLES=10000
scan_new() {
  local d=$1 i=$(($2 + 1)) s f miss=0
  SCAN_FILES=()
  SCAN_N=0
  SCAN_MAX=$2
  s=
  [ -f "$d/seq" ] && { IFS= read -r s <"$d/seq"; } 2>/dev/null
  is_uint "$s" && [ ${#s} -le 15 ] || s=0
  if [ "$s" -gt $((i + SCAN_HOLES)) ]; then
    printf -v f '%s/messages/%06d.msg' "$d" "$s"
    [ -f "$f" ] || s=0
  fi
  while [ "$SCAN_N" -lt "$SCAN_LIMIT" ]; do
    printf -v f '%s/messages/%06d.msg' "$d" "$i"
    if [ -f "$f" ]; then
      SCAN_FILES[SCAN_N]=$f
      SCAN_N=$((SCAN_N + 1))
      SCAN_MAX=$i
      miss=0
    elif [ "$i" -gt "$s" ]; then
      break
    else
      miss=$((miss + 1))
      [ "$miss" -lt "$SCAN_HOLES" ] || break
    fi
    i=$((i + 1))
  done
}

# Formatter: file names on stdin. Modes: wait (to me/all, not mine), read (+ mine),
# readall (everything), tail (everything, streamed). Output for non-tail modes:
# first line "shown last_shown rest total wake", then the text (capped at max bytes;
# with force=1 at least one message is shown).
AWK_FMT='
function emit(id,   n, i, t, ok, s, hl, ep, tm) {
  ok = 0
  if (mode == "tail" || mode == "readall") ok = 1
  else {
    n = split(h["To"], to, ",")
    for (i = 1; i <= n; i++) { t = to[i]; gsub(/[ \t]/, "", t); if (t == me || t == "all") ok = 1 }
    if (h["From"] == me) ok = (mode == "read") ? 1 : 0
  }
  if (!ok) return
  total++
  # Wake: (none) — wakes every addressee; no — nobody; name[,name] — only those
  if (h["Wake"] == "") wake++
  else if (h["Wake"] != "no") {
    n = split(h["Wake"], to, ",")
    for (i = 1; i <= n; i++) { t = to[i]; gsub(/[ \t]/, "", t); if (t == me) { wake++; break } }
  }
  if (countonly) return
  if (stopped) { rest++; return }
  ep = h["Epoch"] + off
  if (ep > 0) {
    ep = int(ep % 86400)
    if (tfmt == "hms") tm = sprintf("%02d:%02d:%02d", int(ep / 3600), int(ep % 3600 / 60), ep % 60)
    else tm = sprintf("%02d:%02d", int(ep / 3600), int(ep % 3600 / 60))
  } else tm = "?"
  hl = "#" id " "
  if (h["Kind"] == "system") hl = hl "[система] "
  hl = hl h["From"] " → " h["To"]
  if (h["Re"] != "") hl = hl " · re #" h["Re"]
  s = hl " · " tm "\n" body
  if (mode == "tail") { printf "%s%s", pfx, s; return }
  if ((shown > 0 || !force) && length(buf) + length(s) > max) { stopped = 1; rest++; return }
  buf = buf s; shown++; last = id
}
{
  f = $0; split("", h); body = ""; hdr = 1
  id = f; sub(/^.*\//, "", id); sub(/\.msg$/, "", id); id = id + 0
  while ((getline line < f) > 0) {
    if (hdr) {
      if (line == "") { hdr = 0; continue }
      k = line; sub(/:.*$/, "", k); v = line; sub(/^[^:]*:[ \t]*/, "", v); h[k] = v
    } else body = body ((line == "") ? "" : "  " line) "\n"
  }
  close(f)
  emit(id)
}
END { if (mode != "tail") { printf "%d %d %d %d %d\n", shown, last, rest, total, wake; printf "%s", buf } }
'

# fmt_msgs MODE MAX FORCE [TFMT] — formats SCAN_FILES → FMT_SHOWN FMT_LAST FMT_REST
# FMT_TOTAL FMT_WAKE (of the total: messages that wake a wait, i.e. without "Wake: no") FMT_TEXT
fmt_msgs() {
  local res meta
  [ -n "$TZ_OFF" ] || tz_offset
  res=$(printf '%s\n' "${SCAN_FILES[@]}" | awk -v me="$AGENT" -v mode="$1" -v max="$2" \
    -v force="$3" -v off="$TZ_OFF" -v tfmt="${4:-hm}" -v countonly="${FMT_COUNTONLY:-0}" "$AWK_FMT")
  meta=${res%%"$NL"*}
  FMT_TEXT=
  case $res in *"$NL"*) FMT_TEXT=${res#*"$NL"}$NL ;; esac
  set -- $meta
  FMT_SHOWN=${1:-0} FMT_LAST=${2:-0} FMT_REST=${3:-0} FMT_TOTAL=${4:-0} FMT_WAKE=${5:-0}
}
fmt_tail() { # [PREFIX] — streams SCAN_FILES to stdout; PREFIX goes before each header line
  [ -n "$TZ_OFF" ] || tz_offset
  printf '%s\n' "${SCAN_FILES[@]}" | awk -v me="$AGENT" -v mode=tail -v max=0 -v force=1 \
    -v off="$TZ_OFF" -v tfmt=hms -v countonly=0 -v pfx="${1:-}" "$AWK_FMT"
}

# check_to TO ALLOW_HUMAN → TO_NORM, TO_WARN; dies on unknown recipients
check_to() {
  local t=${1//[[:space:]]/} x out= rest
  TO_WARN=
  case $t in '' | *[!A-Za-z0-9._,-]*) die "недопустимый --to: $1" "Пример: --to all | --to codex-1,claude-2 | --to human" ;; esac
  if [ "$t" = all ]; then
    TO_NORM=all
    return
  fi
  rest=$t,
  while [ -n "$rest" ]; do
    x=${rest%%,*}
    rest=${rest#*,}
    [ -n "$x" ] || continue
    case $x in ?*.*) x=${x%%.*} ;; esac # a full name (base.key) names the same agent
    case ",$out," in *",$x,"*) continue ;; esac
    case $x in
      all) die "all нельзя смешивать с именами: $1" ;;
      human)
        [ "$2" = 1 ] || die "human не может писать сам себе: $1"
        ;;
      *)
        if ! valid_name "$x" || [ ! -f "$ROOT/agents/$x" ]; then
          die "нет такого агента: $x" "Кто подключён: $BRG who"
        fi
        agent_state "$x"
        [ "$ST" = gone ] && TO_WARN="$TO_WARN${TO_WARN:+, }$x — gone, может не прочитать"
        ;;
    esac
    out=$out${out:+,}$x
  done
  [ -n "$out" ] || die "пустой --to: $1"
  TO_NORM=$out
}

# read_body FILE|"" [KIND] → BODY (CRLF→LF, BOM and trailing newlines stripped);
# dies on empty/too big. KIND: msg (limit msg_max_bytes) | brief (limit BRIEF_MAX).
#
# stdin that is not a regular file (a pipe) is never read by us directly: a
# background `head -c` copies it into a temp file, and we poll it for up to
# BRG_STDIN_WAIT (10) s. A source that closes in time is delivered in full; one
# that does not is killed and the command fails with a clear error — nothing is
# half-read and silently dropped. (`read -t` and a signal watchdog do not work
# in bash 3.2: a timed-out read looks like EOF, and a trap does not interrupt a
# blocking read.) head -c also bounds the size of a runaway stream.
RB_PID=
RB_TMP=
rb_cleanup() { # kill the reader, remove the temp file (also from release_all)
  [ -z "$RB_PID" ] || kill -TERM "$RB_PID" 2>/dev/null
  [ -z "$RB_TMP" ] || rm -f "$RB_TMP"
  RB_PID= RB_TMP=
}
# rb_pipe MAXBYTES — stdin (pipe) → fd 3 opened on a complete temp copy; dies on timeout
rb_pipe() {
  local wait=${BRG_STDIN_WAIT:-10} t=0 step=1 rc
  is_uint "$wait" && [ "$wait" -gt 0 ] || wait=10
  RB_TMP=$RUN/.body.$$.$RANDOM
  head -c "$1" <&0 >"$RB_TMP" 2>/dev/null &
  RB_PID=$!
  # poll in tenths of a second: 0.1, 0.2, 0.4, then every 0.5 s
  while kill -0 "$RB_PID" 2>/dev/null; do
    if [ "$t" -ge $((wait * 10)) ]; then
      rb_cleanup
      die "stdin не закрыт — передай тело через heredoc или --file" \
        "Текст ждали из stdin $wait с, но поток так и не закрылся (пайп от процесса, который не завершается). Ничего не отправлено." \
        "Heredoc: … <<'BRG_EOF'" "текст" "BRG_EOF" \
        "Файл: --file <путь>"
    fi
    sleep "0.$step" 2>/dev/null || sleep 1
    t=$((t + step))
    [ "$step" -lt 5 ] && step=$((step * 2))
    [ "$step" -gt 5 ] && step=5
  done
  wait "$RB_PID" 2>/dev/null
  rc=$?
  RB_PID=
  if [ "$rc" -ne 0 ] || [ ! -f "$RB_TMP" ]; then
    rb_cleanup
    die "не удалось прочитать stdin" "Передай текст через heredoc или --file <путь>"
  fi
  exec 3<"$RB_TMP"
}
read_body() {
  local src=$1 kind=${2:-msg} line rc max=$MSG_MAX
  [ "$kind" = brief ] && max=$BRIEF_MAX
  BODY=
  if [ -n "$src" ]; then
    [ -f "$src" ] && [ -r "$src" ] || die "нет файла: $src"
    exec 3<"$src"
  else
    if [ -t 0 ]; then
      die "нет текста $([ "$kind" = brief ] && echo постановки || echo сообщения)" \
        "Передай текст через heredoc: … <<'BRG_EOF'" "текст" "BRG_EOF" \
        "или из файла: --file <путь>"
    fi
    if [ -f /dev/stdin ]; then exec 3<&0; else rb_pipe $((max * 2 + 4096)); fi
  fi
  while :; do
    line=
    IFS= read -r line <&3
    rc=$?
    [ $rc -ne 0 ] && [ -z "$line" ] && break
    BODY=$BODY${line%"$CR"}$NL
    [ $rc -ne 0 ] && break
    [ ${#BODY} -gt $((max * 2 + 4096)) ] && break # too big anyway
  done
  exec 3<&-
  rb_cleanup
  case $BODY in $'\xff\xfe'* | $'\xfe\xff'*)
    die "текст в кодировке UTF-16 — нужен UTF-8" \
      "Windows PowerShell 5.1 пишет UTF-16 через > и Out-File. Сохрани файл в UTF-8: инструментом записи файлов харнесса или Set-Content -Encoding utf8 <файл> \"текст\"."
    ;;
  esac
  BODY=${BODY#$'\xef\xbb\xbf'}
  body_check "$kind"
}
body_check() { # [KIND]
  while :; do
    case $BODY in *"$NL") BODY=${BODY%"$NL"} ;; *) break ;; esac
  done
  if [ "${1:-msg}" = brief ]; then
    case $BODY in *[![:space:]]*) ;; *) die "пустая постановка: передай текст задачи (дословно от человека) через heredoc или --file" ;; esac
    if [ $((${#BODY} + 1)) -gt "$BRIEF_MAX" ]; then
      die "постановка $((${#BODY} + 1)) байт — больше лимита $BRIEF_MAX" \
        "Сохрани полный текст в файл (например, $RROOT/common/<тема>.md), а в постановку дай суть и путь."
    fi
    return 0
  fi
  case $BODY in
    *[![:space:]]*) ;;
    *)
      if [ "${1:-msg}" = opt ]; then # an optional text (a comment): empty is no text
        BODY=
        return 0
      fi
      die "пустое сообщение"
      ;;
  esac
  if [ $((${#BODY} + 1)) -gt "$MSG_MAX" ]; then
    die "сообщение $((${#BODY} + 1)) байт — больше лимита $MSG_MAX (msg_max_bytes)" \
      "Положи текст в файл (в задаче — в её shared/, иначе $RROOT/common/<тема>.md) и пришли путь."
  fi
}

# ── commands ───────────────────────────────────────────────────────────────
usage_line_v() { # VAR CMD
  local _ul_u
  case $2 in
    init) _ul_u="bash /путь/к/brigada/bin/brg init [--no-agents-md] [каталог_проекта]" ;;
    join) _ul_u="$BRG join --harness <claude|codex|opencode|…> --model <модель>  |  вернуться под старым именем (ключ будет новый): $BRG join --as <имя> --harness <тот же> [--model <модель>]" ;;
    leave) _ul_u="$BRG leave --as <имя>" ;;
    send) _ul_u="$BRG send --as <имя> [--to all|<имя>[,<имя>]|human] [--re N] [--reply-by 5m|90s|1h] [--channel lobby|T00N] [--file F] <<'BRG_EOF' … BRG_EOF" ;;
    wait) _ul_u="$BRG wait --as <имя> [--timeout S]" ;;
    read) _ul_u="$BRG read --as <имя> [--channel lobby|T00N] [--since N] [--all]" ;;
    who) _ul_u="$BRG who" ;;
    tail) _ul_u="$BRG tail [-f] [-n N] [канал]" ;;
    say) _ul_u="$BRG say [--to all|<имя>[,<имя>]] [--channel C] [--file F] [текст…]  (без текста — stdin)" ;;
    status) _ul_u="$BRG status --as <имя>" ;;
    stop) _ul_u="$BRG stop [<имя>]" ;;
    resume) _ul_u="$BRG resume [<имя>]" ;;
    task) _ul_u="$BRG task new --as <имя> --title \"…\" [--cancel-current] [--file F] <<'BRG_EOF' постановка BRG_EOF | task close --as <lead> [--force] | task cancel --as <host|lead|human> | task show [T00N] | task list" ;;
    lead) _ul_u="$BRG lead give <имя> --as <lead> | lead take --as <имя>" ;;
    host) _ul_u="$BRG host give <имя> --as <host> | host take --as <имя>" ;;
    item) _ul_u="$BRG item add --as <имя> --title \"…\" [--desc \"описание\" | --file F | <<'BRG_EOF' описание BRG_EOF] [--paths \"предлагаемые пути\"] [--no-review] | item claim I00N --as <имя> [--paths \"src/a,tests/a\"|none] | item done I00N --as <имя> [--note \"итог\"] [--result <путь>] [--no-review] | item release I00N --as <имя> | item reassign I00N --to <имя> --as <lead> | item review I00N --as <имя> --start | item review I00N --as <имя> --verdict ok|changes [--comment \"…\" | --file F | <<'BRG_EOF' комментарий BRG_EOF] | item review I00N --as <имя> --verdict skip [--comment \"почему\" | --file F] | item cancel I00N --as <имя> [--comment \"почему\" | --file F] | item list [--as <имя> --mine] [--status todo,claimed,done,cancelled] | item show I00N" ;;
    run) _ul_u="$BRG run --as <имя> [--sync] [--timeout 10m] [--item I00N] -- <команда> [аргументы…]  |  run list · run show R00N · run cancel R00N --as <имя>" ;;
    doctor) _ul_u="$BRG doctor  |  из репозитория brigada: bash /путь/к/brigada/bin/brg doctor [каталог_проекта]" ;;
    board) _ul_u="$BRG board [--interval S] [--once]" ;;
    *) _ul_u="$BRG help" ;;
  esac
  eval "$1=\$_ul_u"
}
usage_print() {
  local u
  usage_line_v u "$1"
  printf 'Использование: %s\n' "$u"
  case $1 in
    join) echo "Подключиться к бригаде: выдаёт полное имя <харнесс>-<n>.<ключ> (например, claude-1.k7f3q9) — его целиком передавай в --as каждой команды; кто онлайн, активную задачу, таймаут wait и NEXT. --as — вернуться под старым именем, если потерян ключ (тот же харнесс; курсоры сохраняются; ключ новый, прежний перестаёт работать); разрешено, только когда прежняя сессия «выпала» — ни wait, ни вызовов brg дольше max(таймаут wait + 60 с, dropout_after) — или asleep/gone, или после leave." ;;
    leave) echo "Отключиться (тихое системное сообщение в lobby). Живой wait агента завершится на ближайшем тике." ;;
    send) echo "Отправить сообщение (тело — stdin или --file; CRLF→LF; лимит msg_max_bytes). По умолчанию --to all, канал — активная задача (нет задачи — lobby). --reply-by: по сроку твой wait вернёт сводку, кто ответил." ;;
    wait) echo "Ждать сообщений (последнее действие каждого шага). Слушает lobby и активную задачу. Всегда код 0, последняя строка — NEXT (кроме STOP/SUPERSEDED)." ;;
    read) echo "Показать сообщения повторно: по умолчанию — после подтверждённых во всех слушаемых каналах (включая выданное последним wait). Курсор не двигает. --since N — в одном канале (по умолчанию — задача). --all — включая чужие личные." ;;
    who) echo "Кто подключён: имя · харнесс · модель · состояние · когда был активен; активная задача. «без wait N мин» — wait не идёт дольше таймаута wait + 60 с; «возможно выпал» — ни wait, ни вызовов brg дольше dropout_after (по умолчанию 5 мин): модель могла завершить ход — человеку: напиши агенту в его чат «продолжай»." ;;
    tail) echo "Переписка в читаемом виде: без канала — lobby и активная задача (следит за сменой задачи); -f — следить (Ctrl-C — выход)." ;;
    say) echo "Сообщение от human (по умолчанию всем, в канал активной задачи); снимает общий стоп и стоп названных агентов." ;;
    status) echo "Кто я, задача и моя роль, непрочитанное (без сдвига курсора), мои дедлайны, жив ли мой wait, NEXT. С именем без ключа — только просмотр (не подтверждает, что ты этот агент)." ;;
    stop) echo "Остановить бригаду (или одного агента): wait возвращает STOP сразу и на ближайшем тике; любая команда агента печатает STOP первой строкой; item add|claim|reassign, item review --start и запуск run отказывают." ;;
    resume) echo "Снять стоп (весь или одного агента)." ;;
    init) echo "Создать/обновить <проект>/.brigada: bin/brg, README.md, PROTOCOL.md, board.html, config.default, VERSION; состояние и config не трогает. В корне проекта дописывает (или обновляет) короткий блок brigada в AGENTS.md (нет — создаёт и исключает из git) и в CLAUDE.md, если он есть и не импортирует AGENTS.md: тогда агенту достаточно сказать «подключись к бригаде». --no-agents-md — эти файлы не трогать." ;;
    task)
      echo "Задачи (одна активная): new — создать (ты host и lead; постановка человека дословно → brief.md); close — закрыть (lead; нужен непустой summary.md); cancel — отменить (host, lead или человек: --as human); show/list — посмотреть."
      echo "close отказывает, пока есть подзадачи в работе или идут прогоны (--force — отменить и остановить их). Есть непрочитанное для lead'а (то, что разбудило бы его wait) — close показывает его (оно считается доставленным) и отказывает: учти и повтори close."
      ;;
    lead | host) echo "Роль в активной задаче: give — передать (только текущий $1); take — взять, если текущий $1 asleep/gone." ;;
    item)
      echo "Подзадачи активной задачи. Как работать — решает бригада; обязательно одно: стадия подзадачи в brg (её видит человек на доске) — такая, как на деле. Переводят её этими командами."
      echo "add — добавить (todo; описание — --desc \"…\", stdin (heredoc) или --file; --paths — предлагаемые пути; --no-review — проверка не нужна, решили заранее); claim — взять в работу с резервированием путей (--paths относительно корня проекта, через запятую; none — без правок файлов; без --paths — предлагаемые пути подзадачи; пересечение с чужими резервированиями — отказ, со своими (другие твои подзадачи) — предупреждение); повторный claim своей — сменить пути; claim исполнителем сданной (done) — вернуть её в работу (правки, переделка; прежние пути)."
      echo "done — сдать (только исполнитель; снимает резервирования; --note — итог одной строкой до 500 байт, --result — файл с подробностями): «на проверке», «готово» — после ревью ok; --no-review — сдать без проверки (сразу «готово · без проверки»). release — вернуть в todo (исполнитель; lead — если исполнитель asleep/gone); reassign — передать другому (lead, если исполнитель asleep/gone; так же — правки сданной). cancel — подзадача не нужна (todo — любой; в работе или сданная — исполнитель или lead; --comment или --file — почему, необязательно): «отменено», назад пути нет."
      echo "review — проверка: --start — «взялся проверять» (не исполнитель; видно в сводке wait и item list; текста нет, stdin не читается); --verdict ok|changes — вердикт (не исполнитель; лучше агент другой модели), комментарий — --comment \"…\", stdin (heredoc) или --file; --verdict skip — проверка не нужна (любой, и исполнитель; комментарий необязателен — --comment или --file). Вердикт по сданной заканчивает круг проверки (Reviewing очищается). Результат получают исполнитель и lead. После changes исполнитель возвращает сданную подзадачу в работу тем же claim, правит и снова done."
      echo "list/show — посмотреть: стадия (todo · в работе · на проверке · правки · готово · отменено), кто проверяет; list --status — по статусу (todo, claimed, done, cancelled)."
      echo "Длинные --title, --note, --desc, --comment не отвергаются, а обрезаются с пометкой «…(обрезано)» и предупреждением."
      ;;
    run)
      echo "Запуск тестов/сборки под глобальной блокировкой: команды всей бригады выполняются строго по одной, по очереди запросов; cwd — корень проекта; одна строка-аргумент выполняется через bash -c."
      echo "По умолчанию в фоне: сразу печатает R00N и место в очереди, результат (статус, код, хвост лога) придёт тебе сообщением в wait. --sync — ждать здесь (для коротких команд; --timeout не больше таймаута wait). --timeout — лимит команды (по умолчанию run_timeout из config). Лог: shared/runs/R00N.log задачи."
      echo "run list — очередь и прогоны задачи; run show R00N — статус и хвост лога; run cancel R00N — остановить (свой прогон или lead). Раннер, который умер, отмечается killed; молчащий дольше runner_stale снимает следующий в очереди."
      echo "Задача отменяется — её прогоны останавливаются; task close при идущих прогонах отказывает (--force — остановить их). Результат прогона закрытой задачи приходит в lobby."
      ;;
    doctor)
      echo "Проверка среды и состояния (ничего не меняет): bash и платформа (и совпадение с агентами), CRLF в bin/brg и шаблонах, атомарность mkdir, mv поверх открытого файла, утилиты, запись в .brigada, .git/info/exclude, протухшие блокировки, мёртвые раннеры и очередь brg run, зависшие wait, таймауты wait в config."
      echo "Сводка ✓/⚠/✗ с подсказками; код выхода 0 — ошибок (✗) нет, 1 — есть. Сломанную установку (например, bin/brg с CRLF) проверяй копией из репозитория brigada: bash /путь/к/brigada/bin/brg doctor <проект>."
      ;;
    board)
      echo "Доска для человека в браузере: первой строкой — адрес страницы file://…/.brigada/board.html (открой его в браузере). Раз в --interval с (по умолчанию 2, минимум 1) пишет снимок в .brigada/run/board/: задача и статус, бригада, подзадачи с ревью, прогоны, переписка, постановка, план, итог, прошлые задачи."
      echo "Работает до Ctrl+C; --once — один снимок и выход. Только читает: никого не будит, ничего в бригаде не меняет."
      ;;
  esac
}

cmd_help() {
  cat <<BRG_HELP
brg $BRG_VERSION — транспорт бригады агентов. Из корня проекта: bash .brigada/bin/brg <команда> …

Агентам:
  <имя> — полное имя из своего join, с ключом (claude-1.k7f3q9); без ключа команды, меняющие
  состояние, отказывают; команды чтения (read, status, who, task/item/run show|list) — принимают
  join --harness <h> --model <m>     подключиться, получить имя (--as <имя> — вернуться под старым)
  wait --as <имя> [--timeout S]      ждать сообщений — последнее действие каждого шага
  send --as <имя> [--to all|<имя>[,<имя>]|human] [--re N] [--reply-by 5m] [--channel C] [--file F]
                                     тело — stdin (heredoc) или --file; канал — задача (или lobby)
  read --as <имя> [--channel C] [--since N] [--all]   показать сообщения повторно (курсор не двигает)
  status --as <имя>                  кто я, задача и роль, непрочитанное, дедлайны, NEXT
  task new --as <имя> --title "…" [--cancel-current] < постановка   создать задачу (ты host и lead)
  task close --as <lead> [--force]   закрыть (нужен summary.md) · task cancel --as <host|lead>
  task show [T00N] · task list       задача: роли, пути, постановка · все задачи
  lead give <имя> --as <lead> · lead take --as <имя>   (то же: host give|take)
  item add --as <имя> --title "…" [--desc "…"] [--paths "…"] [--no-review] < описание   подзадача
  item claim I00N --as <имя> [--paths "src/a,tests/a"|none]   взять (свою сданную — вернуть в работу)
  item done I00N --as <имя> [--note "…"] [--no-review] · item release|cancel I00N --as <имя>
  item reassign I00N --to <имя> --as <lead>
  item review I00N --as <имя> --start · --verdict ok|changes [--comment "…"] < комментарий
  item review I00N --as <имя> --verdict skip [--comment "почему"]   проверка не нужна
  item list [--mine] [--status todo] · item show I00N
  run --as <имя> [--sync] [--timeout 10m] [--item I00N] -- <команда>   тесты/сборка по очереди;
                                     результат придёт сообщением · run list · run show|cancel R00N
  who                                кто подключён
  leave --as <имя>                   отключиться
Человеку:
  init [--no-agents-md] [каталог]    (из репозитория brigada) создать/обновить .brigada/ и блок в AGENTS.md
  board [--interval S] [--once]      доска в браузере: задача, бригада, подзадачи, прогоны, переписка
  say [--to …] [текст]               сообщение от human (снимает стоп)
  tail [-f] [-n N] [канал]           переписка (по умолчанию lobby + активная задача)
  who                                кто подключён; «возможно выпал» — напиши агенту в его чат «продолжай»
  task cancel --as human             отменить активную задачу
  item list · run list               подзадачи (кто что делает, пути) · очередь и прогоны
  stop [<имя>] / resume [<имя>]      остановить бригаду или агента / снять стоп
  doctor [каталог_проекта]           проверить среду и состояние (Windows, блокировки, раннеры)

Подробнее: brg <команда> --help. Инструкция агента: .brigada/README.md, правила: .brigada/PROTOCOL.md
BRG_HELP
}

# ── init ───────────────────────────────────────────────────────────────────
install_file() { # SRC DST — copy via temp + rename (running brg keeps its old inode)
  local t=${2%/*}/.tmp.${2##*/}.$$
  cp "$1" "$t" 2>/dev/null && mv_retry "$t" "$2" || {
    rm -f "$t"
    die "не удалось установить $2"
  }
}
cfg_key_collect() { CFG_KEYS="$CFG_KEYS $1"; }

# git_dir_v VAR PROJECT — the git directory that holds info/exclude (for a worktree:
# the common dir); "" if PROJECT is not under git, GD_NOTE says why
git_dir_v() {
  local _gd_g=$2/.git _gd_d= _gd_c= _gd_l
  GD_NOTE="нет .git — пропущено"
  eval "$1="
  if [ -d "$_gd_g" ]; then
    _gd_d=$_gd_g
  elif [ -f "$_gd_g" ]; then
    IFS= read -r _gd_l <"$_gd_g"
    _gd_l=${_gd_l%"$CR"}
    case $_gd_l in "gitdir: "*) _gd_d=${_gd_l#gitdir: } ;; *) return 0 ;; esac
    case $_gd_d in /* | [A-Za-z]:*) ;; *) _gd_d=$2/$_gd_d ;; esac
    if [ -f "$_gd_d/commondir" ]; then
      IFS= read -r _gd_c <"$_gd_d/commondir"
      _gd_c=${_gd_c%"$CR"}
      case $_gd_c in /* | [A-Za-z]:*) _gd_d=$_gd_c ;; *) _gd_d=$_gd_d/$_gd_c ;; esac
    fi
  else
    return 0
  fi
  if [ ! -d "$_gd_d" ]; then
    GD_NOTE="не найден каталог git ($_gd_d) — пропущено"
    return 0
  fi
  GD_NOTE=
  eval "$1=\$_gd_d"
}
# The whole .brigada is kept out of git (DESIGN §3). Up to 0.2.0 init excluded only
# the correspondence and the runtime: those lines (and their comment) are replaced.
GIT_EXCLUDE=.brigada/
GIT_EXCLUDES_OLD=".brigada/tasks/ .brigada/lobby/ .brigada/run/ .brigada/agents/"
GIT_EXCLUDE_OLD_NOTE='# brigada: переписка и рантайм не коммитятся'
GIT_EXCLUDE_NOTE='# brigada: служебный каталог агентов (brg init) не коммитится'

# git_exclude_scan FILE → GE_FOUND (has .brigada/), GE_OLD (has lines of old brg),
# GE_KEEP (the file without those old lines, original line endings kept)
git_exclude_scan() {
  local line l
  GE_FOUND= GE_OLD= GE_KEEP=
  [ -f "$1" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    l=${line%"$CR"}
    [ "$l" = "$GIT_EXCLUDE" ] && GE_FOUND=1
    if [ "$l" = "$GIT_EXCLUDE_OLD_NOTE" ]; then
      GE_OLD=1
      continue
    fi
    case $l in .brigada/*/) case " $GIT_EXCLUDES_OLD " in *" $l "*)
      GE_OLD=1
      continue
      ;;
    esac ;; esac
    GE_KEEP=$GE_KEEP$line$NL
  done <"$1"
}

git_exclude() { # PROJECT → GIT_NOTE
  local gd ex rel
  git_dir_v gd "$1"
  if [ -z "$gd" ]; then
    GIT_NOTE=$GD_NOTE
    return 0
  fi
  mkdir -p "$gd/info" 2>/dev/null
  ex=$gd/info/exclude
  rel=${ex#"$1"/}
  git_exclude_scan "$ex"
  if [ -n "$GE_OLD" ]; then
    # rewrite without the old lines (tmp + mv), .brigada/ in place or at the end
    [ -n "$GE_FOUND" ] || GE_KEEP="$GE_KEEP$GIT_EXCLUDE_NOTE$NL$GIT_EXCLUDE$NL"
    printf '%s' "$GE_KEEP" >"$ex.brg.$$" && mv_retry "$ex.brg.$$" "$ex"
    GIT_NOTE="в $rel строки brigada (.brigada/tasks/, lobby/, run/, agents/) заменены на $GIT_EXCLUDE — весь каталог. Если части .brigada (bin/, config, common/, README.md) уже в git — убери их из индекса, файлы останутся: git rm -r --cached .brigada"
  elif [ -n "$GE_FOUND" ]; then
    GIT_NOTE="$rel уже настроен"
  else
    exclude_append "$ex" "$GIT_EXCLUDE_NOTE" "$GIT_EXCLUDE"
    GIT_NOTE="добавлено в $rel: $GIT_EXCLUDE (весь каталог brigada не коммитится)"
  fi
}
# exclude_append FILE COMMENT LINE — append both (a missing final newline first)
exclude_append() {
  local tl
  if [ -s "$1" ]; then
    tl=$(tail -c 1 "$1")
    [ -n "$tl" ] && printf '\n' >>"$1"
  fi
  printf '%s\n%s\n' "$2" "$3" >>"$1"
}

# Project instruction files (DESIGN §3): a short block between markers in AGENTS.md
# (Codex, OpenCode, Cursor, …) and in CLAUDE.md unless it imports AGENTS.md — then
# "подключись к бригаде" is enough for any harness. Markers are matched by prefix.
AM_BEGIN='<!-- brigada:begin'
AM_END='<!-- brigada:end'
AM_BLOCK="$AM_BEGIN — блок от brg init, init его обновляет; не нужен — удали по brigada:end включительно и запускай init с --no-agents-md -->
## brigada
Если человек просит «подключиться к бригаде» (brigada, .brigada) — прочитай \`.brigada/README.md\` и следуй ему. Подключиться — значит войти в рабочий цикл бригады и оставаться в нём до STOP: после \`join\` не отчитывайся человеку и не завершай ход — сразу \`wait\`. В бригаде ты только координатор: brg, переписка, решения, поручения подагентам и приём их результата; любую работу — чтение и правку кода, исследование, проверку чужой работы — делает твой подагент — одновременно один; больше — только с разрешения человека (харнесс без подагентов — делаешь сам, короткими шагами между \`wait\`). Без такой просьбы к бригаде не подключайся. Если работу тебе поручил другой агент (ты — подагент), к бригаде не подключайся и \`wait\` не вызывай ни при каких обстоятельствах — выполни поручение сам.
$AM_END -->"
AM_EXCLUDE=/AGENTS.md
AM_EXCLUDE_NOTE='# brigada: AGENTS.md создан brg init — чтобы коммитить его, удали строку ниже'
AM_FULL='«подключись к .brigada, прочитай инструкцию в .brigada/README.md»'

# am_scan FILE → AM_ALL (the file as is), AM_PRE/AM_POST (around the first block;
# later blocks are dropped), AM_HAS (a block), AM_BAD (begin without end), AM_TERM
# (newline after the end marker), AM_EOL (CRLF if the first line has it), AM_IMPORT
# (a line "@AGENTS.md" / "@./AGENTS.md" outside the blocks)
am_scan() {
  local line l t x st=0 first=1 ws=$' \t' # st: 0 before, 1 first block, 2 after, 3 later block
  AM_ALL= AM_PRE= AM_POST= AM_HAS= AM_BAD= AM_TERM= AM_EOL=$NL AM_IMPORT=
  while :; do
    if IFS= read -r line; then t=$NL; elif [ -n "$line" ]; then t=; else break; fi
    AM_ALL=$AM_ALL$line$t
    l=${line%"$CR"}
    if [ -n "$first" ]; then
      [ "$l" = "$line" ] || AM_EOL=$CR$NL
      first=
    fi
    case $st in
      0 | 2)
        case $l in "$AM_BEGIN"*)
          AM_HAS=1
          st=$((st + 1))
          continue
          ;;
        esac
        x=${l#"${l%%[!$ws]*}"}
        x=${x%"${x##*[!$ws]}"}
        case $x in @AGENTS.md | @./AGENTS.md) AM_IMPORT=1 ;; esac
        if [ $st = 0 ]; then AM_PRE=$AM_PRE$line$t; else AM_POST=$AM_POST$line$t; fi
        ;;
      *)
        case $l in "$AM_END"*)
          [ $st = 1 ] && AM_TERM=$t
          st=2
          ;;
        esac
        ;;
    esac
  done <"$1"
  case $st in 1 | 3) AM_BAD=1 ;; esac
  return 0
}
# am_write FILE CONTENT — tmp + mv keeping the mode; a symlink is written through
# (AGENTS.md and CLAUDE.md are often links to each other)
am_write() {
  local t=$1.brg.$$
  if [ -L "$1" ]; then
    printf '%s' "$2" >"$1"
    return
  fi
  [ -f "$1" ] && cp "$1" "$t" 2>/dev/null
  printf '%s' "$2" >"$t" && mv_retry "$t" "$1" && return 0
  rm -f "$t"
  return 1
}
# am_apply FILE NAME → AM_NOTE; after am_scan FILE: adds the block or brings it up
# to date, in the line endings of the file. 1 — FILE not changed for a problem.
am_apply() {
  local b=$AM_BLOCK n x='файл, вероятно, в git — коммитить блок или нет, решай сам'
  if [ -n "$AM_BAD" ]; then
    AM_NOTE="$2: есть «$AM_BEGIN», но нет «$AM_END» — не тронут; поправь вручную и повтори init"
    return 1
  fi
  [ "$AM_EOL" = "$NL" ] || b=${b//$NL/$AM_EOL}
  if [ -n "$AM_HAS" ]; then
    n=$AM_PRE$b${AM_TERM:+$AM_EOL}$AM_POST
    if [ "$n" = "$AM_ALL" ]; then
      AM_NOTE="$2: блок brigada уже есть"
      return 0
    fi
    AM_NOTE="блок brigada обновлён в $2 ($x)"
  else
    n=$AM_ALL
    case $n in *[!$CR$NL]*) ;; *) n= ;; esac # only empty lines
    if [ -n "$n" ]; then
      case $n in *"$NL") ;; *) n=$n$AM_EOL ;; esac
      case $n in *"$NL$NL" | *"$NL$CR$NL") ;; *) n=$n$AM_EOL ;; esac
    fi
    n=$n$b$AM_EOL
    AM_NOTE="блок brigada добавлен в $2 ($x)"
  fi
  am_write "$1" "$n" && return 0
  AM_NOTE="$2: не удалось записать"
  return 1
}
# agents_md PROJECT → AM_REPORT (lines for the init output), AM_READY (the block is
# where every harness reads it: "подключись к бригаде" works)
agents_md() {
  local a=$1/AGENTS.md c=$1/CLAUDE.md gd
  AM_REPORT= AM_READY=1
  if [ ! -e "$a" ] && [ ! -L "$a" ]; then
    if am_write "$a" "$AM_BLOCK$NL"; then
      git_dir_v gd "$1"
      if [ -n "$gd" ]; then
        mkdir -p "$gd/info" 2>/dev/null
        am_exclude "$gd/info/exclude"
        AM_NOTE="создан AGENTS.md (только у тебя: исключён из git — чтобы коммитить, удали $AM_EXCLUDE из ${gd#"$1"/}/info/exclude)"
      else
        AM_NOTE="создан AGENTS.md (git: $GD_NOTE)"
      fi
    else
      AM_NOTE="AGENTS.md: не удалось создать"
      AM_READY=
    fi
  elif [ ! -f "$a" ]; then
    AM_NOTE="AGENTS.md — не файл (или ссылка в никуда): не тронут"
    AM_READY=
  else
    am_scan "$a"
    am_apply "$a" AGENTS.md || AM_READY=
  fi
  AM_REPORT=$AM_NOTE$NL
  [ -e "$c" ] || [ -L "$c" ] || return 0
  if [ ! -f "$c" ]; then
    AM_NOTE="CLAUDE.md — не файл (или ссылка в никуда): не тронут"
    AM_READY=
  elif [ -f "$a" ] && [ "$c" -ef "$a" ]; then
    AM_NOTE="CLAUDE.md — тот же файл, что AGENTS.md"
  else
    am_scan "$c"
    if [ -n "$AM_IMPORT" ]; then
      AM_NOTE="CLAUDE.md импортирует AGENTS.md (@AGENTS.md) — не тронут"
    else
      am_apply "$c" CLAUDE.md || AM_READY=
    fi
  fi
  AM_REPORT=$AM_REPORT$AM_NOTE$NL
}
# am_exclude FILE — /AGENTS.md into the git excludes, unless it is there already
am_exclude() {
  local line l
  if [ -f "$1" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      l=${line%"$CR"}
      case $l in "$AM_EXCLUDE" | AGENTS.md) return 0 ;; esac
    done <"$1"
  fi
  exclude_append "$1" "$AM_EXCLUDE_NOTE" "$AM_EXCLUDE"
}

cmd_init() {
  local p= tpl=$ROOT/template B fresh=1 missing= k am=1
  CMD=init
  while [ $# -gt 0 ]; do
    case $1 in
      -h | --help)
        usage_print init
        exit 0
        ;;
      --no-agents-md)
        am=
        shift
        ;;
      -*) usage_die "неизвестный параметр: $1" ;;
      *)
        [ -z "$p" ] || usage_die "лишний аргумент: $1"
        p=$1
        shift
        ;;
    esac
  done
  if [ ! -f "$tpl/README.md" ] || [ ! -f "$tpl/config" ]; then
    die "init запускается из репозитория brigada (рядом с bin/ нужен template/)" \
      "Пример: bash /путь/к/brigada/bin/brg init /путь/к/проекту"
  fi
  [ -n "$p" ] || p=$PWD
  [ -d "$p" ] || die "нет каталога: $p"
  p=$(cd "$p" && pwd) || die "нет доступа к каталогу: $p"
  B=$p/.brigada
  [ -f "$B/VERSION" ] && fresh=
  mkdir -p "$B/bin" "$B/agents" "$B/lobby/messages" "$B/lobby/cursors" "$B/common" "$B/tasks" \
    "$B/run/locks" "$B/run/wait" "$B/run/seen" || die "не удалось создать $B"
  install_file "$BIN_DIR/brg" "$B/bin/brg"
  [ -f "$BIN_DIR/brg.cmd" ] && install_file "$BIN_DIR/brg.cmd" "$B/bin/brg.cmd"
  install_file "$tpl/README.md" "$B/README.md"
  [ -f "$tpl/PROTOCOL.md" ] && install_file "$tpl/PROTOCOL.md" "$B/PROTOCOL.md"
  [ -f "$tpl/board.html" ] && install_file "$tpl/board.html" "$B/board.html"
  install_file "$tpl/config" "$B/config.default"
  if [ ! -f "$B/config" ]; then
    install_file "$tpl/config" "$B/config"
  else
    CFG_KEYS=
    cfg_parse "$B/config" cfg_key_collect
    local have=$CFG_KEYS
    CFG_KEYS=
    cfg_parse "$tpl/config" cfg_key_collect
    for k in $CFG_KEYS; do
      case " $have " in *" $k "*) ;; *) missing="$missing $k" ;; esac
    done
  fi
  printf '%s\n' "$BRG_VERSION" >"$B/.tmp.VERSION.$$" && mv_retry "$B/.tmp.VERSION.$$" "$B/VERSION"
  [ -f "$B/lobby/seq" ] || printf '0\n' >"$B/lobby/seq"
  if [ ! -f "$B/common/project.md" ]; then
    printf '%s\n' "# Проект — устойчивые факты" "" \
      "Стек, как запускать тесты и сборку, конвенции. Пишут агенты (коротко), читают все." >"$B/common/project.md"
  fi
  git_exclude "$p"
  AM_READY=
  [ -n "$am" ] && agents_md "$p"
  RUN=$B/run
  get_now
  metric init version="$BRG_VERSION" fresh="${fresh:-0}" agents_md="${am:-0}"
  if [ -n "$fresh" ]; then
    echo "── brigada $BRG_VERSION: создано $B"
  else
    echo "── brigada $BRG_VERSION: обновлено $B (bin/brg, README.md, PROTOCOL.md, board.html, config.default, VERSION); состояние и config не тронуты"
  fi
  [ -n "$missing" ] && echo "В config нет ключей:$missing — действуют значения из config.default."
  echo "git: $GIT_NOTE"
  if [ -z "$am" ]; then
    echo "AGENTS.md и CLAUDE.md не тронуты (--no-agents-md): фраза агенту — полная."
  else
    printf '%s' "$AM_REPORT"
  fi
  if [ -n "$AM_READY" ]; then
    echo "Дальше скажи агенту в новой сессии: «подключись к бригаде» (сессии, открытые до init, блока не видели — им: $AM_FULL)."
  else
    echo "Дальше скажи агенту: $AM_FULL."
  fi
  echo "Смотреть переписку: bash .brigada/bin/brg tail -f · кто онлайн: bash .brigada/bin/brg who (у агента «возможно выпал» — напиши ему в его чат «продолжай»)"
  echo "Доска в браузере: bash .brigada/bin/brg board — открой в браузере адрес из первой строки"
  echo "Проверка среды (Windows, блокировки, раннеры): bash .brigada/bin/brg doctor; из PowerShell/cmd — .\\.brigada\\bin\\brg.cmd doctor"
}

# ── join / leave ───────────────────────────────────────────────────────────
norm_harness_v() { # VAR RAW
  local _nh_h
  _nh_h=$(printf '%s' "$2" | tr 'A-Z' 'a-z')
  case $_nh_h in
    claude | claude-code | claude_code | claudecode | "claude code" | cc) _nh_h=claude ;;
    opencode | open-code | open_code | "open code") _nh_h=opencode ;;
    codex | codex-cli | codex_cli | "codex cli" | openai-codex) _nh_h=codex ;;
    *) _nh_h=${_nh_h//[!a-z0-9]/} ;;
  esac
  _nh_h=${_nh_h:0:20}
  eval "$1=\$_nh_h"
}

# join: a new agent (name <harness>-<n>, printed with its session key: DESIGN §3)
# or, with --as (bare or full name), the same agent back after it lost its context
# or its key: same harness only; Left is lifted; cursors are kept; a new key — the
# old one stops working. Refused while that name has a live wait, and while the
# agent has not dropped out (silence — no wait, no brg call — longer than
# max(wait timeout + 60 s, dropout_after), or asleep/gone/left): otherwise a session
# that skipped join could take the name, with its roles, from a working agent.
cmd_join() {
  local raw_h= m= h n k f conflicts= T hint online s re= line prof was_left= key q
  NEXT_ON_ERR="$BRG join --harness <claude|codex|opencode|…> --model <модель>"
  while [ $# -gt 0 ]; do
    case $1 in
      --harness | --model | --as)
        need_val "$@"
        case $1 in
          --harness) raw_h=$2 ;;
          --model) m=$2 ;;
          --as) re=$2 ;;
        esac
        shift 2
        ;;
      -h | --help)
        usage_print join
        exit 0
        ;;
      *) usage_die "неизвестный параметр: $1" ;;
    esac
  done
  # a full name is fine: the key is dropped (a new one is issued anyway)
  [ -n "$re" ] && valid_name "$re" && re=${re%%.*}
  [ -z "$re" ] || NEXT_ON_ERR="$BRG join --as $re --harness <тот же харнесс> (или новое имя: $BRG join --harness <харнесс> --model <модель>)"
  [ -n "$raw_h" ] || usage_die "нужен --harness (claude, codex, opencode или короткое имя своего харнесса)"
  [ -n "$m" ] || [ -n "$re" ] || usage_die "нужна --model (если не знаешь — --model unknown)"
  need_root
  norm_harness_v h "$raw_h"
  [ -n "$h" ] || usage_die "недопустимый --harness: $raw_h"
  m=${m//[[:cntrl:]]/}
  m=${m:0:100}
  if [ -n "$re" ] && { ! valid_name "$re" || [ ! -f "$ROOT/agents/$re" ]; }; then
    die "нет агента $re — вернуться можно только под именем, которое уже выдавал join" \
      "Новое подключение: $BRG join --harness $h --model ${m:-<модель>}"
  fi
  detect_platform
  get_now_iso
  lock_acquire roster
  # One platform per .brigada: pids, locks and paths differ between WSL and Git Bash.
  list_agents
  for k in $AGENT_NAMES; do
    [ "$k" = "$re" ] && continue
    agent_state "$k"
    [ "$ST" = gone ] && continue
    [ "$P_PLATFORM" = "$PLATFORM" ] && continue
    conflicts="$conflicts${conflicts:+, }$k ($P_PLATFORM, $ST)"
  done
  if [ -n "$conflicts" ]; then
    lock_release roster
    NEXT_ON_ERR="подключайся из той же среды, что и остальные (bash той же платформы)"
    die "платформа $PLATFORM не совпадает с подключёнными агентами: $conflicts" \
      "Смешивать WSL, Git Bash и т.п. в одном .brigada нельзя." \
      "Если они больше не работают: $BRG leave --as <имя> (или подождать, пока станут gone)."
  fi
  if [ -n "$re" ]; then
    profile_read "$ROOT/agents/$re"
    if [ "$P_HARNESS" != "$h" ]; then
      lock_release roster
      die "агент $re подключался из харнесса ${P_HARNESS:-?}, а ты — $h" \
        "Вернуться под старым именем можно только из того же харнесса." \
        "Новое имя: $BRG join --harness $h --model ${m:-<модель>}"
    fi
    wait_info "$re"
    if [ -n "$WI_ALIVE" ]; then
      lock_release roster
      wait_timeout_v T "$P_HARNESS" "$P_PLATFORM"
      idle_calc "$re"
      NEXT_ON_ERR="если это твой wait и ключ потерян — дождись его конца (обычно ≤ $T с) и через $ID_P с после него повтори $BRG join --as $re --harness $h; иначе $BRG join --harness $h --model ${m:-<модель>}"
      die "имя $re занято: его wait сейчас работает (pid $WI_PID)" \
        "Если это твой wait и ты знаешь своё полное имя (с ключом; оно в последней строке NEXT:) — переподключаться не нужно, продолжай под ним. Если ключ потерян — дождись конца этого wait (обычно ≤ $T с) и повтори $BRG join --as $re --harness $h через $ID_P с после него." \
        "Если это другой агент — подключись под новым именем: $BRG join --harness $h --model ${m:-<модель>}"
    fi
    # Back only once the agent has dropped out (as "возможно выпал" in who) or is
    # asleep/gone/left. The stop flag does not matter.
    if [ -z "$P_LEFT" ]; then
      agent_state "$re"
      if [ "$ST" = working ]; then
        idle_calc "$re"
        q=$((NOW - ST_SEEN))
        [ "$ID_D" -ge 0 ] && [ "$ID_D" -lt "$q" ] && q=$ID_D
        if [ "$q" -le "$ID_P" ]; then
          lock_release roster
          NEXT_ON_ERR="$BRG join --harness $h --model ${m:-<модель>} (новое имя) — или, если $re это ты, продолжай под полным именем из последней строки NEXT:"
          die "$re активен (последний вызов $q с назад)" \
            "Если это ты и ключ потерян — он в последней строке NEXT: (имя вида $re.<ключ>); иначе подожди $((ID_P - q + 1)) с и повтори $BRG join --as $re --harness $h или подключись под новым именем: $BRG join --harness $h --model ${m:-<модель>}"
        fi
      fi
    fi
    [ -n "$m" ] || m=$P_MODEL
    was_left=$P_LEFT
    AGENT=$re
    key_gen_v key
    prof=
    while IFS= read -r line || [ -n "$line" ]; do
      case $line in
        '') break ;;
        Key:* | Model:* | Platform:* | Left:* | Rejoined:*) ;;
        *) prof=$prof$line$NL ;;
      esac
    done <"$ROOT/agents/$re"
    prof="${prof}Model: $m${NL}Platform: $PLATFORM${NL}Rejoined: $ISO${NL}Key: $key$NL"
  else
    n=0
    for f in "$ROOT/agents/$h"-*; do
      [ -f "$f" ] || continue
      k=${f##*/}
      k=${k#"$h"-}
      is_uint "$k" && [ "$k" -gt "$n" ] && n=$k
    done
    AGENT=$h-$((n + 1))
    key_gen_v key
    printf -v prof 'Name: %s\nKey: %s\nHarness: %s\nModel: %s\nPlatform: %s\nJoined: %s\nJoined-Epoch: %s\n' \
      "$AGENT" "$key" "$h" "$m" "$PLATFORM" "$ISO" "$NOW"
  fi
  ASN=$AGENT.$key
  f=$ROOT/agents/.tmp.$AGENT.$$
  if ! printf '%s' "$prof" >"$f" || ! mv_retry "$f" "$ROOT/agents/$AGENT"; then
    rm -f "$f"
    lock_release roster
    die "не удалось записать $ROOT/agents/$AGENT"
  fi
  lock_release roster
  touch_seen
  wait_last_mark
  # Cursors: a new agent starts from the current end of lobby and of the active
  # task (it joined mid-task: history via read --since 0). A returning agent keeps
  # its cursors; if it had left, a task it has no cursor in counts as joined
  # mid-task (from the end). Agents present when a task is created (and returning
  # agents that never left) have no cursor in it: their wait starts from 0.
  if [ -z "$re" ] || [ ! -f "$ROOT/lobby/cursors/$AGENT" ]; then
    seq_read_v s "$ROOT/lobby"
    cursor_write "$ROOT/lobby/cursors/$AGENT" "$s" "$s"
  fi
  if active_task && { [ -z "$re" ] || { [ -n "$was_left" ] && [ ! -f "$ACT_DIR/cursors/$AGENT" ]; }; }; then
    seq_read_v s "$ACT_DIR"
    cursor_write "$ACT_DIR/cursors/$AGENT" "$s" "$s"
  fi
  # back after leave: tasks finished meanwhile are not drained to it
  [ -n "$was_left" ] && skip_finished_tasks
  if [ -n "$re" ]; then BODY="$AGENT переподключён новой сессией ($h, $m, $PLATFORM); прежний ключ недействителен"; else BODY="$AGENT подключился ($h, $m, $PLATFORM)"; fi
  # Quiet for everyone but the host of the active task: it is the one to bring a
  # newcomer (or a returning agent) into the work.
  MSG_EXTRA=$QUIET
  if active_task && task_read "$ACT_DIR"; then
    wake_extra_v MSG_EXTRA "$TK_HOST"
    [ "$TK_HOST" = "$AGENT" ] || BODY="$BODY · host $TK_HOST: учти его в задаче $ACT_ID"
  fi
  msg_write lobby "$AGENT" all system ""
  MSG_EXTRA=
  wait_timeout_v T "$h" "$PLATFORM"
  harness_hint_v hint "$h" "$T" "$PLATFORM"
  online_v online "$AGENT"
  metric join harness="$h" model="${m// /_}" platform="$PLATFORM" rejoin="${re:+1}"
  if [ -n "$re" ]; then
    echo "── переподключён: $ASN ($h · $m · $PLATFORM). Ключ новый, прежний недействителен. Твоё имя — целиком, с ключом после точки: передавай его в каждой команде (--as $ASN). Курсоры сохранены — непрочитанное придёт в wait."
  else
    echo "── подключён: $ASN ($h · $m · $PLATFORM). Твоё имя — целиком, с ключом после точки: передавай его в каждой команде (--as $ASN). Другие видят тебя как $AGENT, но без ключа команды, меняющие состояние, не примут."
  fi
  echo "Онлайн: ${online:-никого}"
  if active_task; then
    task_read "$ACT_DIR"
    task_info_lines "$AGENT"
  else
    echo "Активная задача: нет — её создаст агент, которому человек даст задачу (task new)."
  fi
  echo "Правила совместной работы: $RROOT/PROTOCOL.md — прочитай один раз сейчас."
  [ -e "$RUN/stopped.$AGENT" ] && echo "ВНИМАНИЕ: человек остановил $AGENT (stop) — wait вернёт STOP. Снять может только человек: $BRG resume $AGENT"
  echo "Ожидание: $BRG wait --as $ASN — возвращается при сообщениях или через $T с."
  echo "Таймаут инструмента: $hint"
  win_note
  echo "Правило: подключиться — значит работать в бригаде до STOP. Человеку о подключении не отчитывайся — сразу выполни NEXT (дал задачу в той же просьбе — сначала task new). Последнее действие каждого шага — wait; ход не завершай (кроме STOP). Ты только координатор: любую работу (код, исследование, проверку) делает твой подагент — одновременно один; больше — только с разрешения человека; сам держишь цикл wait (PROTOCOL.md, раздел 2)."
  echo "── NEXT: $BRG wait --as $ASN"
}

# roles_note_v VAR NAME — "lead задачи T001" etc. for an agent holding a role ("" otherwise)
roles_note_v() {
  local _rn_r=
  if active_task && task_read "$ACT_DIR"; then
    role_v _rn_r "$2"
    [ "$_rn_r" = участник ] && _rn_r=
  fi
  eval "$1=\${_rn_r:+\$_rn_r задачи \$ACT_ID}"
}

cmd_leave() {
  local f note take=
  NEXT_ON_ERR=
  while [ $# -gt 0 ]; do
    case $1 in
      --as)
        need_val "$@"
        OPT_AS=$2
        shift 2
        ;;
      -h | --help)
        usage_print leave
        exit 0
        ;;
      *) usage_die "неизвестный параметр: $1" ;;
    esac
  done
  need_root
  need_agent write
  get_now_iso
  lock_acquire roster
  f=$ROOT/agents/.tmp.$AGENT.$$
  { cat "$AGENT_FILE" && printf 'Left: %s\n' "$NOW"; } >"$f" && mv_retry "$f" "$AGENT_FILE"
  lock_release roster
  touch_seen
  roles_note_v note "$AGENT"
  if [ -n "$note" ]; then
    [ "$TK_HOST" = "$AGENT" ] && take="$BRG host take"
    [ "$TK_LEAD" = "$AGENT" ] && take="${take:+$take, }$BRG lead take"
  fi
  BODY="$AGENT отключился${note:+ (был $note — роль может взять любой: $take --as <имя>)}"
  # an ordinary leave is quiet; losing the host/lead is news for everyone (wakes)
  MSG_EXTRA=
  [ -n "$note" ] || MSG_EXTRA=$QUIET
  msg_write lobby "$AGENT" all system ""
  MSG_EXTRA=
  metric leave
  echo "── $AGENT отключён. Живой wait этого агента завершится на ближайшем тике. Цикл больше не нужен — заверши ход."
  [ -n "$note" ] && echo "Ты был $note: остальные увидят это и смогут взять роль ($take)."
  return 0
}

# ── deadlines (DESIGN §8) ──────────────────────────────────────────────────
# send --reply-by: headers Reply-By (epoch) and Expect (whose answer is expected:
# the named addressees, or for `all` every agent not gone except the sender, as
# of sending). Index for the sender's wait: run/deadlines/<sender>/<epoch>-<ch>-<id>
# (the epoch in the name lets each tick check expiry without reading files).
# A reply is a later non-system message in the same channel from an addressee
# with Re: <id>, or to the sender, or to all. The summary is given once: the
# marker run/deadlines/<ch>-<id>.done is created atomically (noclobber) first.

# expect_v VAR TO_NORM — addressees whose reply is expected (sender excluded)
expect_v() {
  local _ex_r= _ex_x _ex_rest
  if [ "$2" = all ]; then
    list_agents
    for _ex_x in $AGENT_NAMES; do
      [ "$_ex_x" = "$AGENT" ] && continue
      agent_state "$_ex_x"
      [ "$ST" = gone ] && continue
      _ex_r=$_ex_r${_ex_r:+,}$_ex_x
    done
  else
    _ex_rest=$2,
    while [ -n "$_ex_rest" ]; do
      _ex_x=${_ex_rest%%,*}
      _ex_rest=${_ex_rest#*,}
      [ -n "$_ex_x" ] && [ "$_ex_x" != "$AGENT" ] && _ex_r=$_ex_r${_ex_r:+,}$_ex_x
    done
  fi
  eval "$1=\$_ex_r"
}
dl_register() { # CHANNEL ID EPOCH EXPECT
  local dd=$RUN/deadlines/$AGENT t
  [ -d "$dd" ] || mkdir -p "$dd" 2>/dev/null
  t=$dd/.tmp.$$
  printf 'Channel: %s\nId: %s\nReply-By: %s\nExpect: %s\n' "$1" "$2" "$3" "$4" >"$t" &&
    mv_retry "$t" "$dd/$3-$1-$2"
}
dl_read() { # FILE → DL_CH DL_ID DL_BY DL_EXPECT
  local line
  DL_CH= DL_ID= DL_BY= DL_EXPECT=
  while IFS= read -r line || [ -n "$line" ]; do
    case $line in
      'Channel: '*) DL_CH=${line#Channel: } ;;
      'Id: '*) DL_ID=${line#Id: } ;;
      'Reply-By: '*) DL_BY=${line#Reply-By: } ;;
      'Expect: '*) DL_EXPECT=${line#Expect: } ;;
    esac
  done <"$1"
  is_uint "$DL_ID" && is_uint "$DL_BY" && [ -n "$DL_CH" ]
}
AWK_REPLIES='
{
  f = $0; split("", h)
  while ((getline line < f) > 0) {
    if (line == "") break
    k = line; sub(/:.*$/, "", k); v = line; sub(/^[^:]*:[ \t]*/, "", v); h[k] = v
  }
  close(f)
  if (h["Kind"] == "system" || h["From"] == me || h["From"] == "" || (h["From"] in seen)) next
  ok = (h["Re"] == id) || (h["To"] == "all")
  if (!ok) { n = split(h["To"], to, ","); for (i = 1; i <= n; i++) if (to[i] == me) ok = 1 }
  if (ok) { seen[h["From"]] = 1; printf "%s%s", (c++ ? "," : ""), h["From"] }
}'
# dl_replied_v VAR CHANNEL_DIR ID SENDER — who replied to #ID (comma list)
dl_replied_v() {
  local _dr_r=
  scan_new "$2" "$3"
  [ "$SCAN_N" -gt 0 ] && _dr_r=$(printf '%s\n' "${SCAN_FILES[@]}" | awk -v me="$4" -v id="$3" "$AWK_REPLIES")
  eval "$1=\$_dr_r"
}
dl_split() { # EXPECT REPLIED → DL_YES DL_NO (", "-separated)
  local x rest=$1,
  DL_YES= DL_NO=
  while [ -n "$rest" ]; do
    x=${rest%%,*}
    rest=${rest#*,}
    [ -n "$x" ] || continue
    case ",$2," in
      *",$x,"*) DL_YES="$DL_YES${DL_YES:+, }$x" ;;
      *) DL_NO="$DL_NO${DL_NO:+, }$x" ;;
    esac
  done
}

# ── send / say ─────────────────────────────────────────────────────────────
cmd_send() {
  local to=all re= c= file= d rb= rbs= exp= by= x o od rf t dd
  NEXT_ON_ERR="исправь команду и повтори: $BRG send --as $AS_HINT [--to all|<имя>|human] <<'BRG_EOF' … BRG_EOF; закончив шаг — $BRG wait --as $AS_HINT"
  while [ $# -gt 0 ]; do
    case $1 in
      --as | --to | --re | --channel | --file | --reply-by)
        need_val "$@"
        case $1 in
          --as) OPT_AS=$2 ;;
          --to) to=$2 ;;
          --re) re=$2 ;;
          --channel) c=$2 ;;
          --file) file=$2 ;;
          --reply-by) rb=$2 ;;
        esac
        shift 2
        ;;
      -h | --help)
        usage_print send
        exit 0
        ;;
      *) usage_die "неизвестный параметр: $1 (текст сообщения — через stdin/heredoc или --file)" ;;
    esac
  done
  need_root
  need_agent write
  NEXT_ON_ERR="исправь команду и повтори: $BRG send --as $ASN [--to all|<имя>|human] <<'BRG_EOF' … BRG_EOF; закончив шаг — $BRG wait --as $ASN"
  default_channel
  chan_writable "${c:-$DEFCHAN}"
  c=$CHAN_ID
  d=$CHAN_DIR
  get_now
  check_to "$to" 1
  if [ -n "$rb" ]; then
    parse_dur_v rbs "$rb" || usage_die "--reply-by — срок вида 90s, 5m, 1h (от 1 с до 24 ч): $rb"
  fi
  if [ -n "$re" ]; then
    is_uint "$re" || die "--re — номер сообщения: $re"
    printf -v rf '%s/messages/%06d.msg' "$d" "$re"
    if [ ! -f "$rf" ]; then
      # numbering is per channel: point at the other channel if #re is there
      x=
      for o in lobby $ACT_ID; do
        [ "$o" = "$c" ] && continue
        chan_dir od "$o" && printf -v rf '%s/messages/%06d.msg' "$od" "$re" && [ -f "$rf" ] && x=$CHAN_ID
      done
      die "в канале $c нет сообщения #$re" ${x:+"#$re есть в $x — ответ туда: добавь --channel $x"}
    fi
  fi
  read_body "$file"
  get_now_iso
  MSG_EXTRA=
  if [ -n "$rbs" ]; then
    expect_v exp "$TO_NORM"
    if [ -n "$exp" ]; then
      by=$((NOW + rbs))
      MSG_EXTRA="Reply-By: $by${NL}Expect: $exp$NL"
    fi
  fi
  msg_write "$c" "$AGENT" "$TO_NORM" msg "$re"
  MSG_EXTRA=
  [ -n "$by" ] && dl_register "$c" "$MSG_ID" "$by" "$exp"
  touch_seen
  metric send id="$MSG_ID" channel="$c" to="$TO_NORM" bytes=$((${#BODY} + 1)) ${by:+reply_by=$by}
  echo "── отправлено #$MSG_ID → $TO_NORM ($c)${re:+ · re #$re}"
  if [ -n "$by" ]; then
    hm_v t "$by"
    dur_v dd "$rbs"
    echo "Дедлайн: ответ до $t (через $dd), ждём: ${exp//,/, }. По сроку твой wait вернёт сводку, кто ответил; ответят все раньше — сводка придёт сразу."
  elif [ -n "$rbs" ]; then
    echo "Внимание: дедлайн не установлен — кроме тебя адресатов нет."
  fi
  [ -n "$TO_WARN" ] && echo "Внимание: $TO_WARN"
  echo "── NEXT: продолжай; закончив шаг — $BRG wait --as $ASN"
}

cmd_say() {
  local to=all c= file= text= have= cleared=
  while [ $# -gt 0 ]; do
    case $1 in
      --to | --channel | --file)
        need_val "$@"
        case $1 in
          --to) to=$2 ;;
          --channel) c=$2 ;;
          --file) file=$2 ;;
        esac
        shift 2
        ;;
      -h | --help)
        usage_print say
        exit 0
        ;;
      --)
        shift
        while [ $# -gt 0 ]; do
          text=$text${have:+ }$1
          have=1
          shift
        done
        ;;
      -*) usage_die "неизвестный параметр: $1" ;;
      *)
        text=$text${have:+ }$1
        have=1
        shift
        ;;
    esac
  done
  need_root
  AGENT=human
  default_channel
  chan_writable "${c:-$DEFCHAN}"
  c=$CHAN_ID
  get_now
  check_to "$to" 0
  if [ -n "$have" ]; then
    BODY=${text//"$CR"/}
    body_check
  else
    read_body "$file"
  fi
  get_now_iso
  if [ -e "$RUN/stopped" ]; then
    rm -f "$RUN/stopped"
    cleared=" Общий стоп снят."
  fi
  if [ "$TO_NORM" != all ]; then
    local x rest=$TO_NORM,
    while [ -n "$rest" ]; do
      x=${rest%%,*}
      rest=${rest#*,}
      if [ -e "$RUN/stopped.$x" ]; then
        rm -f "$RUN/stopped.$x"
        cleared="$cleared Стоп $x снят."
      fi
    done
  fi
  msg_write "$c" human "$TO_NORM" msg ""
  metric say id="$MSG_ID" channel="$c" to="$TO_NORM" bytes=$((${#BODY} + 1))
  echo "── отправлено #$MSG_ID от human → $TO_NORM ($c).$cleared"
  [ -n "$TO_WARN" ] && echo "Внимание: $TO_WARN"
  [ -n "$cleared" ] && echo "Остановленные агенты завершили ход — напиши им в харнессе «продолжай»."
  return 0
}

# ── read / tail ────────────────────────────────────────────────────────────
# read: by default every channel wait listens to, from Acked (so the batch issued
# by the last wait is shown again); --channel C — one channel; --since N — one
# channel (C or the default one: the active task, else lobby).
cmd_read() {
  local since= all= c= d mode=read chans x s last budget force=1 nt
  NEXT_ON_ERR="$BRG read --as $AS_HINT [--channel C] [--since N] [--all]"
  while [ $# -gt 0 ]; do
    case $1 in
      --as | --since | --channel)
        need_val "$@"
        case $1 in
          --as) OPT_AS=$2 ;;
          --since) since=$2 ;;
          --channel) c=$2 ;;
        esac
        shift 2
        ;;
      --all)
        all=1
        shift
        ;;
      -h | --help)
        usage_print read
        exit 0
        ;;
      *) usage_die "неизвестный параметр: $1" ;;
    esac
  done
  need_root
  need_agent read
  NEXT_ON_ERR="$BRG read --as $ASN [--channel C] [--since N] [--all]"
  [ -z "$since" ] || { is_uint "$since" && [ ${#since} -le 15 ]; } || usage_die "--since — номер сообщения: $since"
  if [ -n "$c" ]; then
    chan_dir d "$c" || die "нет канала: $c"
    chans=$CHAN_ID
  elif [ -n "$since" ]; then
    default_channel
    chans=$DEFCHAN
  else
    listen_set
    chans="${LS_CH[*]}"
  fi
  [ -n "$all" ] && mode=readall
  get_now
  touch_seen
  budget=$OUTMAX
  for x in $chans; do
    chan_dir d "$x" || continue
    ls_note_v nt "$x"
    if [ -n "$since" ]; then
      s=$since
    else
      cursor_read "$d/cursors/$AGENT"
      s=$CUR_ACK
    fi
    scan_new "$d" "$s"
    FMT_SHOWN=0 FMT_REST=0 FMT_TEXT=
    if [ "$SCAN_N" -gt 0 ]; then fmt_msgs "$mode" "$budget" "$force"; fi
    if [ "$FMT_SHOWN" -eq 0 ] && [ "$FMT_REST" -eq 0 ]; then
      echo "── $x$nt: после #$s сообщений для тебя нет${all:+ (включая чужие личные)}"
      continue
    fi
    last=$s
    if [ "$FMT_SHOWN" -gt 0 ]; then
      printf '── %s%s · после #%s: %s ──────────────────\n%s' "$x" "$nt" "$s" "$FMT_SHOWN" "$FMT_TEXT"
      last=$FMT_LAST
      budget=$((budget - ${#FMT_TEXT}))
      force=0
    fi
    if [ "$FMT_REST" -gt 0 ]; then
      echo "── ещё $FMT_REST в $x не показано (лимит вывода): $BRG read --as $ASN --since $last --channel $x${all:+ --all}"
    fi
  done
  metric read channels="${chans// /,}" since="${since:-acked}"
  echo "── NEXT: курсор не сдвинут; закончив шаг — $BRG wait --as $ASN"
}

# tail: one channel, or (default) lobby + the active task, each header prefixed
# with its channel; -f follows, switching to a new task when it appears.
cmd_tail() {
  local follow= n= c= d since=0 s tick lob=0 tid= tdir= tsince=0 any=
  while [ $# -gt 0 ]; do
    case $1 in
      -f | --follow)
        follow=1
        shift
        ;;
      -n)
        need_val "$@"
        n=$2
        shift 2
        ;;
      --as)
        need_val "$@"
        shift 2
        ;;
      -h | --help)
        usage_print tail
        exit 0
        ;;
      -*) usage_die "неизвестный параметр: $1" ;;
      *)
        [ -z "$c" ] || usage_die "лишний аргумент: $1"
        c=$1
        shift
        ;;
    esac
  done
  need_root
  AGENT=human
  [ -z "$n" ] || { is_uint "$n" && [ ${#n} -le 9 ]; } || usage_die "-n — число сообщений: $n"
  get_now
  metric tail channel="${c:-all}" follow="${follow:-0}"
  SCAN_LIMIT=1000000
  tick=${BRG_TICK:-1}
  case $tick in '' | *[!0-9.]*) tick=1 ;; esac
  if [ -n "$c" ]; then
    chan_dir d "$c" || die "нет канала: $c"
    c=$CHAN_ID
    if [ -n "$n" ]; then
      seq_read_v s "$d"
      since=$((s - n))
      [ "$since" -ge 0 ] || since=0
    fi
    scan_new "$d" "$since"
    if [ "$SCAN_N" -gt 0 ]; then fmt_tail; else echo "── $c: сообщений нет${follow:+ (жду новых, Ctrl-C — выход)}"; fi
    since=$SCAN_MAX
    [ -n "$follow" ] || return 0
    trap 'exit 0' INT TERM HUP
    while :; do
      sleep "$tick"
      scan_new "$d" "$since"
      if [ "$SCAN_N" -gt 0 ]; then
        fmt_tail
        since=$SCAN_MAX
      fi
    done
  fi
  # lobby + the active task
  if [ -n "$n" ]; then
    seq_read_v s "$ROOT/lobby"
    lob=$((s - n))
    [ "$lob" -ge 0 ] || lob=0
  fi
  scan_new "$ROOT/lobby" "$lob"
  [ "$SCAN_N" -gt 0 ] && fmt_tail "lobby " && any=1
  lob=$SCAN_MAX
  if active_task; then
    tid=$ACT_ID tdir=$ACT_DIR
    if [ -n "$n" ]; then
      seq_read_v s "$tdir"
      tsince=$((s - n))
      [ "$tsince" -ge 0 ] || tsince=0
    fi
    scan_new "$tdir" "$tsince"
    [ "$SCAN_N" -gt 0 ] && fmt_tail "$tid " && any=1
    tsince=$SCAN_MAX
  fi
  [ -n "$any" ] || echo "── сообщений нет (lobby${tid:+, $tid})${follow:+ — жду новых, Ctrl-C — выход}"
  [ -n "$follow" ] || return 0
  trap 'exit 0' INT TERM HUP
  while :; do
    sleep "$tick"
    scan_new "$ROOT/lobby" "$lob"
    if [ "$SCAN_N" -gt 0 ]; then
      fmt_tail "lobby "
      lob=$SCAN_MAX
    fi
    active_task
    if [ "$ACT_ID" != "$tid" ]; then
      tid=$ACT_ID tdir=$ACT_DIR tsince=0
    fi
    [ -n "$tid" ] || continue
    scan_new "$tdir" "$tsince"
    if [ "$SCAN_N" -gt 0 ]; then
      fmt_tail "$tid "
      tsince=$SCAN_MAX
    fi
  done
}


# ── who / status ───────────────────────────────────────────────────────────
cmd_who() {
  local n ago cnt=0 flags claimed x st as rest k items idle drop=
  while [ $# -gt 0 ]; do
    case $1 in
      --as)
        need_val "$@"
        OPT_AS=$2
        shift 2
        ;;
      -h | --help)
        usage_print who
        exit 0
        ;;
      *) usage_die "неизвестный параметр: $1" ;;
    esac
  done
  need_root
  get_now
  if [ -n "${OPT_AS:-}" ]; then
    need_agent read
    touch_seen
  fi
  # items in work per agent: " name name name " (one word per claimed item)
  claimed=" "
  if active_task; then
    item_table "$ACT_DIR"
    while IFS=$US read -r x st as rest; do
      [ "$st" = claimed ] && [ -n "$as" ] && claimed="$claimed$as "
    done <<BRG_WHO_EOF
$IT_TABLE
BRG_WHO_EOF
  fi
  list_agents
  for n in $AGENT_NAMES; do
    agent_state "$n"
    ago_v ago $((NOW - ST_SEEN))
    flags=
    [ -n "$ST_LEFT" ] && flags=" (leave)"
    [ -e "$RUN/stopped.$n" ] && flags="$flags (stop)"
    [ "$ST_SEEN" -gt 0 ] || ago="—"
    k=0
    rest=$claimed
    while :; do
      case $rest in *" $n "*) ;; *) break ;; esac
      rest=${rest/ $n / }
      k=$((k + 1))
    done
    items=
    [ "$k" -gt 0 ] && items=" · подзадач в работе: $k"
    idle_note_v idle "$n" " · "
    case $idle in *"возможно выпал"*) drop=1 ;; esac
    echo "$n · $P_HARNESS · $P_MODEL · $ST$flags · активен $ago$items$idle"
    cnt=$((cnt + 1))
  done
  [ "$cnt" -gt 0 ] || echo "── агентов нет. Подключение: $BRG join --harness <харнесс> --model <модель>"
  if [ -n "$drop" ]; then
    dur_v x "$DROPOUT_AFTER"
    echo "── «возможно выпал»: ни wait, ни вызовов brg дольше $x (dropout_after; не меньше таймаута wait + 60 с) — модель могла завершить ход. Человеку: напиши этому агенту в его чат «продолжай»."
  fi
  if active_task && task_read "$ACT_DIR"; then
    echo "── задача $ACT_ID «$TK_TITLE» · host $TK_HOST · lead $TK_LEAD"
  else
    echo "── активной задачи нет"
  fi
  [ -e "$RUN/stopped" ] && [ -z "$STOP_SHOWN" ] && echo "── STOP: бригада остановлена (снять: $BRG resume)" # not twice for who --as
  metric who agents="$cnt"
  return 0
}

# my_deadlines_lines — pending deadlines of AGENT, one line each (for status)
my_deadlines_lines() {
  local f d r t w dd
  for f in "$RUN/deadlines/$AGENT"/*; do
    [ -f "$f" ] && dl_read "$f" || continue
    r=
    chan_dir d "$DL_CH" && dl_replied_v r "$d" "$DL_ID" "$AGENT"
    dl_split "$DL_EXPECT" "$r"
    hm_v t "$DL_BY"
    if [ "$DL_BY" -gt "$NOW" ]; then
      dur_v dd $((DL_BY - NOW))
      w="до $t (через $dd)"
    else
      w="истёк в $t — сводка придёт ближайшим wait"
    fi
    echo "Мой дедлайн по #$DL_ID ($DL_CH): $w · ответили: ${DL_YES:-никто} · ждём: ${DL_NO:-—}"
  done
}

cmd_status() {
  local T hint c d online new q pend_from nt idle
  NEXT_ON_ERR=
  while [ $# -gt 0 ]; do
    case $1 in
      --as)
        need_val "$@"
        OPT_AS=$2
        shift 2
        ;;
      -h | --help)
        usage_print status
        exit 0
        ;;
      *) usage_die "неизвестный параметр: $1" ;;
    esac
  done
  need_root
  STOP_SHOWN=1 # STOP is the last line of status (instead of NEXT)
  need_agent read
  if [ -n "$AS_NOKEY" ]; then # that line is not printed without the key
    STOP_SHOWN=
    stop_banner
  fi
  get_now
  touch_seen
  detect_platform
  wait_timeout_v T "$A_HARNESS" "$A_PLATFORM"
  harness_hint_v hint "$A_HARNESS" "$T" "$A_PLATFORM"
  echo "── status: $AGENT · $A_HARNESS · $A_MODEL · платформа $A_PLATFORM (сейчас $PLATFORM)"
  [ -z "$AS_NOKEY" ] || echo "Имя без ключа — только просмотр, это не подтверждение личности. Твоё имя — только из вывода твоего join в этом чате (полное, с ключом после точки: $AGENT.<ключ>)."
  [ "$A_PLATFORM" = "$PLATFORM" ] || echo "ВНИМАНИЕ: платформа не совпадает с записанной при join."
  echo "Таймаут wait: $T с. Таймаут инструмента: $hint"
  win_note
  agent_state "$AGENT"
  if [ -n "$AS_NOKEY" ]; then
    if [ -n "$WI_ALIVE" ]; then
      echo "wait агента $AGENT работает (pid $WI_PID). Если ты не делал join в этом чате — ты не $AGENT: сделай join."
    else
      idle_note_v idle "$AGENT" " · "
      echo "wait агента $AGENT: не запущен$idle"
    fi
  elif [ -n "$WI_ALIVE" ]; then
    echo "Мой wait: работает (pid $WI_PID) — второй не запускай, дождись его вывода."
  else
    idle_note_v idle "$AGENT" " · "
    echo "Мой wait: не запущен$idle"
  fi
  if active_task && task_read "$ACT_DIR"; then
    task_info_lines "$AGENT"
    my_items_lines
    my_runs_lines
  else
    echo "Активная задача: нет"
  fi
  listen_set
  FMT_COUNTONLY=1
  for c in ${LS_CH[*]}; do
    chan_dir d "$c" || continue
    ls_note_v nt "$c"
    cursor_read "$d/cursors/$AGENT"
    scan_new "$d" "$CUR_PEND"
    FMT_TOTAL=0 FMT_WAKE=0
    [ "$SCAN_N" -gt 0 ] && fmt_msgs wait 0 1
    new=$FMT_TOTAL
    q=$((FMT_TOTAL - FMT_WAKE))
    pend_from=
    [ "$CUR_PEND" -gt "$CUR_ACK" ] && pend_from=" · выдано последним wait и ждёт подтверждения: #$((CUR_ACK + 1))…#$CUR_PEND (повторить: $BRG read --as $ASN)"
    [ "$q" -gt 0 ] && new="$new (из них тихих $q — придут с ближайшей будящей пачкой)"
    echo "$c$nt: новых для тебя $new$pend_from"
  done
  FMT_COUNTONLY=
  my_deadlines_lines
  online_v online "$AGENT"
  echo "Онлайн: ${online:-никого}"
  metric status
  if [ -n "$AS_NOKEY" ]; then
    echo "── NEXT: если ты не делал join в этом чате — $BRG join --harness <харнесс> --model <модель>; иначе продолжай под полным именем из своего join"
  elif [ -e "$RUN/stopped" ] || [ -e "$RUN/stopped.$AGENT" ]; then
    echo "── STOP: человек остановил ${AGENT}/бригаду. Заверши ход."
  else
    echo "── NEXT: $BRG wait --as $ASN"
  fi
}

# ── stop / resume (DESIGN §9) ──────────────────────────────────────────────
# No signals: a live wait sees the flag on its next tick (≤ 1 s). Signalling
# pids from files risks hitting an unrelated process after pid reuse.
cmd_stop() {
  local name=
  while [ $# -gt 0 ]; do
    case $1 in
      -h | --help)
        usage_print stop
        exit 0
        ;;
      -*) usage_die "неизвестный параметр: $1" ;;
      *)
        [ -z "$name" ] || usage_die "лишний аргумент: $1"
        case $1 in ?*.*) name=${1%%.*} ;; *) name=$1 ;; esac # the key, if any, is dropped
        shift
        ;;
    esac
  done
  need_root
  AGENT=human
  get_now
  if [ -n "$name" ]; then
    valid_name "$name" && [ -f "$ROOT/agents/$name" ] || die "нет такого агента: $name" "Кто есть: $BRG who"
    : >"$RUN/stopped.$name" || die "не удалось создать $RUN/stopped.$name"
    metric stop target="$name"
    echo "── STOP для $name: его wait вернёт STOP на ближайшем тике, следующие — сразу. Снять: $BRG resume $name"
  else
    : >"$RUN/stopped" || die "не удалось создать $RUN/stopped"
    metric stop target=all
    echo "── STOP: все wait вернут STOP на ближайшем тике, следующие — сразу. Снять: $BRG resume (или $BRG say …)"
  fi
}

cmd_resume() {
  local name= f
  while [ $# -gt 0 ]; do
    case $1 in
      -h | --help)
        usage_print resume
        exit 0
        ;;
      -*) usage_die "неизвестный параметр: $1" ;;
      *)
        [ -z "$name" ] || usage_die "лишний аргумент: $1"
        case $1 in ?*.*) name=${1%%.*} ;; *) name=$1 ;; esac # the key, if any, is dropped
        shift
        ;;
    esac
  done
  need_root
  AGENT=human
  get_now
  if [ -n "$name" ]; then
    valid_name "$name" || die "недопустимое имя: $name"
    rm -f "$RUN/stopped.$name"
  else
    for f in "$RUN/stopped" "$RUN"/stopped.*; do
      [ -e "$f" ] && rm -f "$f"
    done
  fi
  metric resume target="${name:-all}"
  echo "── стоп снят${name:+ для $name}. Остановленные агенты завершили ход — напиши им в харнессе «продолжай» (они вернутся к wait)."
}

# ── doctor (DESIGN §10): checks the environment and the state, changes nothing ──
# One line per check: ✓ fine, ⚠ worth a look (not an error), ✗ error + hints "→".
# Exit code 1 if there is any ✗. Run from .brigada (bash .brigada/bin/brg doctor) or
# from the brigada repo for a project (… doctor <project>): the latter also works
# when the installed copy is broken (CRLF line endings).
DR_OK=0
DR_WARN=0
DR_FAIL=0
dr_hints() {
  local h
  for h in "$@"; do printf '    → %s\n' "$h"; done
}
dr_ok() {
  DR_OK=$((DR_OK + 1))
  printf '✓ %s\n' "$1"
}
dr_warn() {
  DR_WARN=$((DR_WARN + 1))
  printf '⚠ %s\n' "$1"
  shift
  dr_hints "$@"
}
dr_fail() {
  DR_FAIL=$((DR_FAIL + 1))
  printf '✗ %s\n' "$1"
  shift
  dr_hints "$@"
}
# cr_count_v VAR FILE — "<lines> <lines ending with CR> <lines with non-ASCII bytes>"
cr_count_v() {
  local _cc_r
  _cc_r=$(awk -v cr="$CR" '{ t++; if (substr($0, length($0), 1) == cr) c++; if ($0 ~ /[\200-\377]/) u++ }
    END { print t + 0, c + 0, u + 0 }' "$2" 2>/dev/null)
  eval "$1=\${_cc_r:-0 0 0}"
}

dr_bash() {
  local v="${BASH_VERSINFO[0]:-0}.${BASH_VERSINFO[1]:-0}"
  if [ "${BASH_VERSINFO[0]:-0}" -gt 3 ] || { [ "${BASH_VERSINFO[0]:-0}" -eq 3 ] && [ "${BASH_VERSINFO[1]:-0}" -ge 2 ]; }; then
    dr_ok "bash $BASH_VERSION"
  else
    dr_fail "bash $v — нужен 3.2 или новее" "Windows: Git for Windows (Git Bash); macOS/Linux: системный bash"
  fi
}

DR_STATE=
dr_install() {
  local x missing= v=
  DR_STATE=
  if [ ! -d "$ROOT" ]; then
    dr_fail "нет каталога $ROOT" "Создай: bash /путь/к/brigada/bin/brg init $PROJ"
    return 0
  fi
  for x in VERSION config.default bin/brg README.md PROTOCOL.md lobby/messages agents tasks; do
    [ -e "$ROOT/$x" ] || missing="$missing $x"
  done
  if [ -n "$missing" ]; then
    dr_fail "в .brigada нет:$missing" "Повтори init (состояние и config он не трогает): bash /путь/к/brigada/bin/brg init $PROJ"
  else
    IFS= read -r v <"$ROOT/VERSION"
    v=${v%"$CR"}
    if [ "$v" = "$BRG_VERSION" ]; then
      dr_ok "установка: .brigada версии $v"
    else
      dr_warn "в .brigada версия $v, а этот brg — $BRG_VERSION" "Обнови установку: bash /путь/к/brigada/bin/brg init $PROJ"
    fi
  fi
  [ -d "$ROOT/lobby/messages" ] && DR_STATE=1
  return 0
}

dr_platform() {
  local n bad= cnt=0 via=
  [ -n "${BRG_VIA_CMD:-}" ] && via=", запуск через brg.cmd"
  case $PLATFORM in
    WSL) dr_warn "bash из WSL" "brg.cmd (PowerShell/cmd) запускает Git Bash, а не WSL; агенты одного .brigada должны работать в одной среде — выбери одну (для Windows-харнессов — Git Bash)." ;;
    MSYS)
      case ${BRG_BASH:-} in
        *[Ss]ystem32* | *[Ww]indows[Aa]pps*)
          dr_fail "BRG_BASH указывает на bash из WSL: $BRG_BASH" "Укажи bash.exe из Git for Windows (например, C:\\Program Files\\Git\\bin\\bash.exe) или убери переменную BRG_BASH."
          ;;
        *) dr_ok "платформа MSYS (Git Bash)$via" ;;
      esac
      ;;
    Cygwin) dr_warn "платформа Cygwin — не проверялась" "Рекомендуется Git Bash из Git for Windows (brg.cmd запускает именно его)." ;;
    *) dr_ok "платформа $PLATFORM$via" ;;
  esac
  [ -n "$DR_STATE" ] || return 0
  list_agents
  for n in $AGENT_NAMES; do
    agent_state "$n"
    [ "$ST" = gone ] && continue
    cnt=$((cnt + 1))
    [ "$P_PLATFORM" = "$PLATFORM" ] || bad="$bad${bad:+, }$n (${P_PLATFORM:-?}, $ST)"
  done
  if [ -n "$bad" ]; then
    dr_fail "подключены агенты другой платформы: $bad" \
      "Смешивать WSL, Git Bash и macOS/Linux в одном .brigada нельзя (pid, блокировки, пути — свои у каждой среды)." \
      "Запусти doctor из той среды, где работают агенты; на Windows — через .brigada\\bin\\brg.cmd doctor (Git Bash)."
  elif [ "$cnt" -gt 0 ]; then
    dr_ok "подключённые агенты ($cnt) — той же платформы"
  else
    dr_ok "подключённых агентов нет"
  fi
}

dr_files() {
  local f x crlf= tot cr na
  f=$ROOT/bin/brg
  if [ -f "$f" ]; then
    cr_count_v x "$f"
    set -- $x
    if [ "$2" -gt 0 ]; then
      dr_fail "bin/brg: окончания строк CRLF ($2 из $1 строк) — bash его не выполнит" \
        "Причина — git с core.autocrlf=true (Windows). В репозитории brigada есть .gitattributes: удали там bin/brg и восстанови git checkout -- bin/brg (запишется с LF) или скачай brigada заново." \
        "Затем переустанови: bash /путь/к/brigada/bin/brg init $PROJ"
    else
      dr_ok "bin/brg: окончания строк LF"
    fi
  fi
  f=$ROOT/bin/brg.cmd
  if [ -f "$f" ]; then
    cr_count_v x "$f"
    set -- $x
    if [ "$3" -gt 0 ]; then
      dr_fail "bin/brg.cmd: не-ASCII символы ($3 строк) — cmd.exe может прочитать их неверно" "Переустанови из репозитория brigada: bash /путь/к/brigada/bin/brg init $PROJ"
    elif [ "$2" -ne "$1" ]; then
      if [ "$PLATFORM" = MSYS ]; then
        dr_fail "bin/brg.cmd: окончания строк LF ($(($1 - $2)) из $1 строк) — cmd.exe нужен CRLF" "Переустанови из репозитория brigada с .gitattributes (*.cmd — eol=crlf): bash /путь/к/brigada/bin/brg init $PROJ"
      else
        dr_warn "bin/brg.cmd: окончания строк LF ($(($1 - $2)) из $1 строк) — на Windows cmd.exe нужен CRLF" "Репозиторий brigada должен отдавать его с CRLF (.gitattributes: *.cmd eol=crlf); переустанови: brg init."
      fi
    else
      dr_ok "bin/brg.cmd: окончания строк CRLF"
    fi
  elif [ "$PLATFORM" = MSYS ]; then
    dr_fail "нет bin/brg.cmd — из PowerShell/cmd brg не вызвать" "Переустанови из репозитория brigada: bash /путь/к/brigada/bin/brg init $PROJ"
  fi
  for f in README.md PROTOCOL.md config.default config; do
    [ -f "$ROOT/$f" ] || continue
    cr_count_v x "$ROOT/$f"
    set -- $x
    [ "$2" -gt 0 ] && crlf="$crlf${crlf:+, }$f"
  done
  if [ -n "$crlf" ]; then
    dr_warn "окончания строк CRLF: $crlf — работает, но это признак git с core.autocrlf=true" "Проверь bin/brg и репозиторий brigada (.gitattributes); config можно оставить как есть."
  else
    dr_ok "документы и config: окончания строк LF"
  fi
}

# dr_group_kill — set -m gives a background job its own process group, and a TERM
# to the group stops it (brg run: timeout and cancel)
dr_group_kill() {
  local sp i=0
  set -m
  sleep 30 &
  sp=$!
  set +m
  sleep 0.3 # let the child exec: before that it is bash with our TERM trap, which would swallow the signal
  kill -TERM -- -"$sp" 2>/dev/null
  while kill -0 "$sp" 2>/dev/null && [ $i -lt 30 ]; do
    sleep 0.1
    i=$((i + 1))
  done
  if kill -0 "$sp" 2>/dev/null; then
    kill -KILL "$sp" 2>/dev/null
    wait "$sp" 2>/dev/null
    return 1
  fi
  wait "$sp" 2>/dev/null
  return 0
}
dr_env() {
  local x missing= bad= notes=
  for x in mkdir mv rm cat sed awk date sleep kill ls head tail wc sort tr printf cp uname; do
    command -v "$x" >/dev/null 2>&1 || missing="$missing $x"
  done
  [ -z "$missing" ] || dr_fail "нет утилит:$missing" "Нужен полный Git Bash (Git for Windows) или coreutils."
  x=$(printf 'abcdef' | head -c 3 2>/dev/null)
  [ "$x" = abc ] || bad="$bad${bad:+; }head -c не работает (stdin сообщений)"
  x=$(date -u +%s 2>/dev/null)
  is_uint "$x" || bad="$bad${bad:+; }date -u +%s не даёт число"
  sleep 0.01 2>/dev/null || bad="$bad${bad:+; }sleep не понимает дробные секунды"
  kill -0 $$ 2>/dev/null || bad="$bad${bad:+; }kill -0 не работает (живость процессов)"
  dr_group_kill 2>/dev/null || bad="$bad${bad:+; }set -m / kill группе процессов не работают (brg run не остановит команду по таймауту и отмене)"
  if [ -n "$bad" ]; then
    dr_fail "утилиты: $bad" "Нужен Git Bash из Git for Windows (не WSL, не busybox) или обычный bash macOS/Linux."
  else
    dr_ok "утилиты: head -c, date +%s, дробный sleep, kill -0, set -m и kill группе процессов"
  fi
  if command -v nohup >/dev/null 2>&1; then
    dr_ok "nohup есть"
  else
    dr_warn "нет nohup" "brg run обойдётся без него (раннер сам игнорирует HUP), но лучше полный Git Bash."
  fi
}

# dr_procs — does kill -0 see other processes and their death? A sandbox (Codex)
# may answer EPERM for processes outside it: pid_alive calls them alive. A pid
# namespace that hides live processes (ESRCH) is not detected (DESIGN §12 п. 3).
dr_procs() {
  local c x bad=
  if [ "$PPID" != 1 ] && pid_alive "$PPID" && [ "$PA_WHY" = eperm ]; then
    bad=1
    dr_warn "песочница: чужие процессы недоступны (EPERM на родителя, pid $PPID) — brg считает их живыми; сироту wait не распознает (вернётся по таймауту)" \
      "Команды brg, меняющие состояние, — прежде всего wait и run — запускай вне песочницы (.brigada/README.md, про Codex)."
  fi
  (exit 0) &
  c=$!
  wait "$c" 2>/dev/null
  if pid_alive "$c"; then
    bad=1
    x=EPERM
    [ "$PA_WHY" = eperm ] || x="«жив»"
    dr_warn "смерть процессов не видна: kill -0 к завершённому процессу (pid $c) отвечает $x — раннер brg run снимается только по heartbeat (до runner_stale, $RUNNER_STALE с)" \
      "Запускай brg вне песочницы."
  fi
  [ -n "$bad" ] || dr_ok "процессы: kill -0 видит родителя и смерть процесса"
}

# dr_fs — file system semantics brg relies on, in a scratch dir of run/
dr_fs() {
  local t=$RUN/.doctor.$$ x y i n bad= rp tries notw=
  if ! mkdir -p "$t" 2>/dev/null; then
    dr_fail "нет записи в $RUN" "Проверь права на каталог .brigada (и что он не на сетевом/только-для-чтения диске)."
    return 0
  fi
  for x in "$ROOT" "$ROOT/lobby/messages" "$ROOT/tasks" "$ROOT/agents" "$ROOT/common"; do
    [ -d "$x" ] || continue
    if : >"$x/.doctor.$$" 2>/dev/null; then rm -f "$x/.doctor.$$"; else notw="$notw ${x#"$ROOT"/}"; fi
  done
  x='Проверка UTF-8 ✓'
  y=
  printf '%s\n' "$x" >"$t/utf8" 2>/dev/null && IFS= read -r y <"$t/utf8"
  if [ -n "$notw" ]; then
    dr_fail "нет записи в:$notw" "Проверь права на каталог .brigada."
  elif [ "$x" != "$y" ]; then
    dr_fail "запись в .brigada: текст UTF-8 не вернулся из файла без изменений" "Проверь файловую систему каталога проекта."
  else
    dr_ok "запись в .brigada (UTF-8 через файл без искажений)"
  fi
  # mkdir is atomic: of several racing mkdir exactly one succeeds (all locks rely on it)
  i=1
  while [ $i -le 10 ]; do
    (mkdir "$t/m$i" 2>/dev/null && : >"$t/a$i") &
    (mkdir "$t/m$i" 2>/dev/null && : >"$t/b$i") &
    (mkdir "$t/m$i" 2>/dev/null && : >"$t/c$i") &
    wait
    n=0
    for x in a b c; do [ -e "$t/$x$i" ] && n=$((n + 1)); done
    [ "$n" -eq 1 ] || bad="$bad r$i:$n"
    i=$((i + 1))
  done
  if [ -n "$bad" ]; then
    dr_fail "mkdir не атомарен: в гонке трёх mkdir успешных не ровно один ($bad)" "Блокировки brg на этой файловой системе ненадёжны: перенеси проект на локальный диск (не сетевой, не синхронизируемый облаком)."
  else
    dr_ok "mkdir атомарен (10 гонок по 3 процесса — ровно один успех)"
  fi
  # mv over a file another process holds open for reading (Windows: may be refused)
  printf 'old\n' >"$t/target"
  printf 'new\n' >"$t/src"
  sleep 3 <"$t/target" &
  rp=$!
  sleep 0.2
  tries=0
  while ! mv -f "$t/src" "$t/target" 2>/dev/null; do
    tries=$((tries + 1))
    [ $tries -ge 30 ] && break
    sleep 0.1
  done
  kill "$rp" 2>/dev/null
  wait "$rp" 2>/dev/null
  y=
  IFS= read -r y <"$t/target" 2>/dev/null
  if [ "$y" != new ]; then
    dr_fail "mv поверх файла, открытого другим процессом на чтение, не удался (3 с повторов)" "Запись сообщений и курсоров будет сбоить. Исключи каталог проекта из проверки антивирусом; проверь, что проект на локальном диске."
  elif [ "$tries" -gt 0 ]; then
    dr_warn "mv поверх открытого на чтение файла удался только с $tries повтор(ами)" "brg повторяет mv до 1 с; если ошибки записи будут — исключи каталог проекта из проверки антивирусом."
  else
    dr_ok "mv поверх файла, открытого другим процессом на чтение, — успешно"
  fi
  rm -rf "$t"
}

dr_git() {
  local gd x
  git_dir_v gd "$PROJ"
  if [ -z "$gd" ]; then
    dr_ok "git: $GD_NOTE"
    return 0
  fi
  git_exclude_scan "$gd/info/exclude"
  if [ -n "$GE_FOUND" ]; then
    dr_ok ".git/info/exclude: $GIT_EXCLUDE — каталог brigada не коммитится"
  else
    x="нет $GIT_EXCLUDE — git add -A закоммитит служебный каталог brigada (переписку, рантайм, копию brg)"
    [ -n "$GE_OLD" ] && x="исключены только переписка и рантайм (brg до 0.2.1), нет $GIT_EXCLUDE — git add -A закоммитит bin/, config, common/, README.md"
    dr_fail ".git/info/exclude: $x" "Повтори init (поправит сам): bash /путь/к/brigada/bin/brg init $PROJ"
  fi
}
# dr_agents_md — the brigada block in the project instruction files (DESIGN §3)
dr_agents_md() {
  local a=$PROJ/AGENTS.md c=$PROJ/CLAUDE.md
  AM_HAS=
  [ -f "$a" ] && am_scan "$a"
  if [ -n "$AM_HAS" ]; then
    dr_ok "AGENTS.md: блок brigada есть — агенту достаточно «подключись к бригаде»"
  else
    dr_warn "AGENTS.md: нет блока brigada — фразу «подключись к бригаде» агенты не поймут" \
      "Повтори init (допишет блок): bash /путь/к/brigada/bin/brg init $PROJ — или говори агенту полную фразу: $AM_FULL"
  fi
  [ -f "$c" ] || return 0
  [ -f "$a" ] && [ "$c" -ef "$a" ] && return 0
  am_scan "$c"
  [ -n "$AM_HAS$AM_IMPORT" ] && return 0
  dr_warn "CLAUDE.md: нет ни блока brigada, ни строки @AGENTS.md — Claude Code читает CLAUDE.md и блока из AGENTS.md не увидит" \
    "Повтори init (допишет блок в CLAUDE.md) или добавь в CLAUDE.md строку @AGENTS.md; иначе Claude Code — полную фразу: $AM_FULL"
}

# dr_locks — leftovers of crashes: locks of dead owners, hung holders, the exec
# lock of a dead or silent runner. A lock seen without a problem twice in a row
# (1 s apart) is in normal use.
DR_PIDS=" " # runner pids already reported (no duplicate lines for runs)
dr_lock_problem_v() { # VAR LOCKDIR — the problem with that lock ("" if none)
  local _lp_o _lp_r= _lp_f _lp_x=
  lock_owner_v _lp_o "$2"
  if [ -z "$_lp_o" ]; then
    [ -d "$2" ] && _lp_r=noowner
  elif ! pid_alive "${_lp_o%% *}"; then
    _lp_r="dead ${_lp_o%% *}"
    if [ "${2##*/}" = exec.lock ]; then # the verdict of brg itself (runner_gone)
      lock_hb_v _lp_f "$2" "$_lp_o"
      runner_gone "$_lp_f" || _lp_r=
    fi
  elif [ "${2##*/}" = exec.lock ]; then
    lock_hb_v _lp_f "$2" "$_lp_o"
    [ $((NOW - _lp_f)) -gt "$RUNNER_STALE" ] && _lp_r="silent ${_lp_o%% *} $((NOW - _lp_f))"
  else
    [ $((NOW - ${_lp_o#* })) -gt "$LOCK_STALE" ] && _lp_r="old ${_lp_o%% *} $((NOW - ${_lp_o#* }))"
  fi
  eval "$1=\$_lp_r"
}
dr_locks() {
  local d n p cand= junk= x r run before=$((DR_FAIL + DR_WARN))
  [ -d "$LOCKS" ] || {
    dr_ok "блокировок нет"
    return 0
  }
  for d in "$LOCKS"/*; do
    [ -d "$d" ] || continue
    n=${d##*/}
    case $n in
      *.lock) ;;
      *.brk | *.stale.*)
        junk="$junk $n"
        continue
        ;;
      *) continue ;;
    esac
    dr_lock_problem_v p "$d"
    [ -n "$p" ] && cand="$cand $n"
  done
  if [ -n "$cand$junk" ]; then
    sleep 1 # a lock in normal use changes hands or goes away
    get_now
  fi
  for n in $cand; do
    d=$LOCKS/$n
    dr_lock_problem_v p "$d"
    [ -n "$p" ] || continue
    set -- $p
    run=
    if [ "$n" = exec.lock ]; then
      x=
      [ -f "$d/run" ] && IFS= read -r x <"$d/run" 2>/dev/null
      run=${x%% *}
      [ -n "${2:-}" ] && DR_PIDS="$DR_PIDS$2 "
    fi
    case $1 in
      noowner) dr_warn "блокировка $n без файла владельца" "Если не исчезнет — brg снимет её сам через lock_stale ($LOCK_STALE с); вручную: rm -rf $RROOT/run/locks/$n" ;;
      dead)
        if [ -n "$run" ]; then
          dr_fail "exec-блокировка у мёртвого раннера (pid $2, прогон $run)" "Её снимет следующий brg run; прогон отметит killed (и сообщит инициатору) $BRG run show $run."
        else
          dr_fail "протухшая блокировка $n: владелец (pid $2) мёртв" "brg снимет её сам при следующем обращении; если команды brg «висят» — удали: rm -rf $RROOT/run/locks/$n"
        fi
        ;;
      silent) dr_fail "раннер прогона ${run:-?} (pid $2) держит exec-блокировку, но не подаёт признаков жизни $3 с" "Завис или его pid занят другим процессом. Следующий прогон в очереди снимет его сам; остановить сейчас: $BRG run cancel ${run:-R00N} --as <имя>." ;;
      old) dr_fail "блокировка $n держится $3 с (владелец pid $2 жив) — завис brg?" "brg снимет её по возрасту (lock_stale $LOCK_STALE с); если повторяется — посмотри, что за процесс $2." ;;
    esac
  done
  r=
  for n in $junk; do [ -e "$LOCKS/$n" ] && r="$r $n"; done
  [ -n "$r" ] && dr_warn "остатки после сбоя в run/locks:$r" "Безвредно; можно удалить: rm -rf $RROOT/run/locks/<имя>"
  [ $((DR_FAIL + DR_WARN)) -eq "$before" ] && dr_ok "блокировки: протухших и зависших нет"
  return 0
}

# dr_runs — the queue of brg run and runs in progress whose runner is dead or silent
dr_runs() {
  local f line a x hf tn bad=0
  for f in "$RUN"/execq/[0-9]*; do
    [ -f "$f" ] || continue
    case ${f##*/} in *.*) continue ;; esac
    line=
    IFS= read -r line <"$f" 2>/dev/null
    eq_parse "$line"
    is_uint "$EQ_P" || continue
    if ! pid_alive "$EQ_P"; then
      runner_gone "$EQ_E" || continue # just died, or alive in another pid namespace
      dr_fail "очередь brg run: $EQ_R — раннер (pid $EQ_P) мёртв" "Запись уберёт следующий brg run или $BRG run list (прогон отметится killed, инициатор получит сообщение)."
      DR_PIDS="$DR_PIDS$EQ_P "
      bad=1
      continue
    fi
    a=
    is_uint "$EQ_E" && a=$((NOW - EQ_E))
    if [ -z "$a" ] || [ "$a" -gt "$RUNNER_STALE" ]; then
      dr_fail "очередь brg run: $EQ_R — раннер (pid $EQ_P) не подаёт признаков жизни${a:+ $a с}" "Завис или pid занят другим процессом: следующий в очереди снимет его сам; остановить сейчас: $BRG run cancel $EQ_R --as <имя>."
      DR_PIDS="$DR_PIDS$EQ_P "
      bad=1
    fi
  done
  for hf in "$ROOT"/tasks/T[0-9]*/shared/runs/R[0-9]*; do
    [ -f "$hf" ] || continue
    case ${hf##*/} in *.*) continue ;; esac
    run_read "$hf" || continue
    run_is_final "$RN_STATUS" && continue
    case "$DR_PIDS" in *" ${RN_RUNNER:-none} "*) continue ;; esac
    run_health
    case $RH in
      dead | nostart)
        x="раннер мёртв${RN_RUNNER:+ (pid $RN_RUNNER)}"
        [ "$RH" = nostart ] && x="раннер не запустился"
        dr_fail "прогон $RN_ID (задача $RN_TASK, $RN_AGENT) — $RN_STATUS, но $x" "$BRG run show $RN_ID отметит его killed и сообщит инициатору."
        bad=1
        ;;
      stale)
        dr_fail "прогон $RN_ID (задача $RN_TASK, $RN_AGENT) — $RN_STATUS, раннер (pid $RN_RUNNER) не подаёт признаков жизни $RH_AGE с" "Завис или pid занят другим процессом: остановить — $BRG run cancel $RN_ID --as <имя>."
        bad=1
        ;;
    esac
  done
  [ "$bad" = 1 ] || dr_ok "brg run: мёртвых и зависших раннеров нет"
}

dr_waits() {
  local f n live=0 tails=0 hb= age x
  for f in "$RUN"/wait/*.pid; do
    [ -f "$f" ] || continue
    n=${f##*/}
    n=${n%.pid}
    valid_name "$n" || continue
    wait_info "$n"
    if [ -n "$WI_ALIVE" ]; then
      live=$((live + 1))
      continue
    fi
    [ -n "$WI_PID" ] || continue
    if pid_alive "$WI_PID"; then
      hb=
      [ -f "$RUN/wait/$n.hb" ] && IFS= read -r hb <"$RUN/wait/$n.hb"
      age=
      is_uint "${hb#* }" && age=" $((NOW - ${hb#* })) с"
      dr_fail "wait агента $n: pid $WI_PID жив, но heartbeat не обновляется${age:- (нет файла heartbeat)}" \
        "Завис или pid занят другим процессом. Агенту достаточно снова вызвать wait (старый завершится с SUPERSEDED); процесс $WI_PID, если это brg, можно завершить."
    else
      tails=$((tails + 1))
    fi
  done
  x=
  [ "$tails" -gt 0 ] && x=", остались pid-файлы завершённых: $tails (безвредно)"
  dr_ok "wait: живых $live$x"
}

dr_stops() {
  local f n=
  [ -e "$RUN/stopped" ] && dr_warn "бригада остановлена (stop): wait всех агентов возвращает STOP" "Снять: $BRG resume"
  for f in "$RUN"/stopped.*; do
    [ -e "$f" ] || continue
    n="$n${n:+, }${f##*/stopped.}"
  done
  [ -n "$n" ] && dr_warn "остановлены агенты: $n" "Снять: $BRG resume <имя>"
  return 0
}

# dr_config — wait timeouts must stay under the command limits of the harnesses
# (DESIGN §5.1): 120 s by default (Claude Code, OpenCode, Codex on Windows), up to
# 600 s when the agent passes a tool timeout; Codex elsewhere parks a command after
# 10–30 s.
dr_config() {
  local hs="claude opencode codex" h t okmax line= high= fail= low= pk n
  list_agents
  for n in $AGENT_NAMES; do
    profile_read "$ROOT/agents/$n"
    case " $hs " in *" $P_HARNESS "*) ;; *) [ -n "$P_HARNESS" ] && hs="$hs $P_HARNESS" ;; esac
  done
  platform_key_v pk "$PLATFORM"
  for h in $hs default; do
    wait_timeout_v t "$h" "$PLATFORM"
    okmax=110
    [ "$h" = codex ] && [ "$PLATFORM" != MSYS ] && okmax=25
    n=$h
    [ "$h" = default ] && n=прочие
    line="$line${line:+ · }$n $t"
    if [ "$t" -gt 540 ]; then
      fail="$fail${fail:+, }$n $t"
    elif [ "$t" -gt "$okmax" ]; then
      high="$high${high:+, }$n $t"
    elif [ "$t" -lt 5 ]; then
      low="$low${low:+, }$n $t"
    fi
  done
  [ -z "$fail" ] || dr_fail "wait_timeout ($pk) больше 540 с: $fail — харнесс прервёт wait (лимит команды — до 600 с)" \
    "Уменьши в $RROOT/config (ключи wait_timeout.<харнесс> и wait_timeout.<харнесс>.<платформа>)."
  [ -z "$high" ] || dr_warn "wait_timeout ($pk) выше рекомендованного: $high" \
    "Больше 110 с — только если агенты стабильно передают таймаут инструмента ≥ wait_timeout + 60 с, иначе харнесс прервёт wait на 120 с (DESIGN §5.1)." \
    "Codex вне Windows паркует команду через 10–30 с: wait дольше 25 с стоит опросов (write_stdin)."
  [ -z "$low" ] || dr_warn "wait_timeout ($pk) меньше 5 с: $low" "Каждый возврат wait — вызов модели: слишком частые пробуждения дорого стоят."
  [ -n "$fail$high$low" ] || dr_ok "wait_timeout ($pk): $line — ниже лимитов команд харнессов (DESIGN §5.1)"
  if [ "$RUNNER_STALE" -le "$LOCK_STALE" ]; then
    dr_warn "runner_stale ($RUNNER_STALE) не больше lock_stale ($LOCK_STALE)" "Раннер, ждущий блокировку runs до lock_stale, могут счесть зависшим: сделай runner_stale больше lock_stale."
  fi
  if [ "$RDG_CFG" != "$RUNNER_DEAD_GRACE" ]; then
    dr_warn "runner_dead_grace ($RDG_CFG) не меньше runner_stale ($RUNNER_STALE) — brg берёт $RUNNER_DEAD_GRACE" "Сделай runner_dead_grace меньше runner_stale (по умолчанию 5 с; 0 — верить одному pid)."
  fi
  return 0
}

cmd_doctor() {
  local p= d
  CMD=doctor
  while [ $# -gt 0 ]; do
    case $1 in
      -h | --help)
        usage_print doctor
        exit 0
        ;;
      --as)
        need_val "$@"
        shift 2
        ;;
      -*) usage_die "неизвестный параметр: $1" ;;
      *)
        [ -z "$p" ] || usage_die "лишний аргумент: $1"
        p=$1
        shift
        ;;
    esac
  done
  if [ -n "$p" ]; then
    [ -d "$p" ] || die "нет каталога: $p"
    p=$(cd "$p" && pwd) || die "нет доступа к каталогу: $p"
    case $p in */.brigada) d=$p ;; *) d=$p/.brigada ;; esac
  elif [ -f "$ROOT/VERSION" ] || [ "${ROOT##*/}" = .brigada ]; then
    d=$ROOT
  elif [ -d "$PWD/.brigada" ]; then
    d=$PWD/.brigada
  else
    die "не найден .brigada" "Укажи проект: bash $BRG_SELF doctor <каталог_проекта> (или запусти из корня проекта)"
  fi
  # the state checked: that .brigada (doctor may run from the brigada repo)
  ROOT=$d RUN=$d/run LOCKS=$d/run/locks PROJ=${d%/*}
  [ -n "$PROJ" ] || PROJ=/
  if [ "$BIN_DIR" != "$ROOT/bin" ] && [ -z "${BRG_VIA_CMD:-}" ]; then
    # run from another copy (the brigada repo): hints name the project's own brg
    if [ "$PWD" = "$PROJ" ]; then
      RROOT=.brigada
      BRG="bash .brigada/bin/brg"
    else
      RROOT=$ROOT
      shq_v p "$ROOT/bin/brg"
      BRG="bash $p"
    fi
  fi
  cfg_load
  detect_platform
  get_now
  echo "── brg doctor $BRG_VERSION · $d"
  dr_bash
  dr_install
  dr_platform
  [ -d "$ROOT" ] && dr_files
  dr_env
  dr_procs
  if [ -n "$DR_STATE" ]; then
    dr_fs
    dr_git
    dr_agents_md
    get_now
    dr_locks
    get_now
    dr_runs
    dr_waits
    dr_stops
    dr_config
  fi
  metric doctor ok="$DR_OK" warn="$DR_WARN" fail="$DR_FAIL" platform="$PLATFORM"
  echo "── итого: ✓ $DR_OK · ⚠ $DR_WARN · ✗ $DR_FAIL"
  if [ "$DR_FAIL" -gt 0 ]; then
    echo "Есть ошибки (✗): исправь по подсказкам «→» и запусти doctor снова."
    exit 1
  fi
  if [ "$DR_WARN" -gt 0 ]; then echo "Ошибок нет; строки ⚠ — посмотри."; else echo "Всё в порядке."; fi
  exit 0
}

# ── tasks: commands (DESIGN §6, §6.1) ──────────────────────────────────────
# slug_v VAR TITLE — lowercase latin letters/digits/dashes, ≤ 40 bytes; other
# characters (incl. non-ASCII) separate words; may be empty (dir is then T00N).
slug_v() {
  local _sl_s
  _sl_s=$(printf '%s' "$2" | tr 'A-Z' 'a-z')
  _sl_s=${_sl_s//[!a-z0-9]/-}
  while :; do
    case $_sl_s in *--*) _sl_s=${_sl_s//--/-} ;; *) break ;; esac
  done
  _sl_s=${_sl_s#-}
  _sl_s=${_sl_s:0:40}
  _sl_s=${_sl_s%-}
  eval "$1=\$_sl_s"
}
task_next_id_v() { # VAR — T<highest existing number + 1>
  local _tx_f _tx_b _tx_m=0
  for _tx_f in "$ROOT"/tasks/T[0-9]*; do
    [ -d "$_tx_f" ] || continue
    _tx_b=${_tx_f##*/}
    _tx_b=${_tx_b%%-*}
    _tx_b=${_tx_b#T}
    is_uint "$_tx_b" && [ ${#_tx_b} -le 6 ] || continue
    _tx_b=$((10#$_tx_b))
    [ "$_tx_b" -gt "$_tx_m" ] && _tx_m=$_tx_b
  done
  printf -v _tx_b 'T%03d' $((_tx_m + 1))
  eval "$1=\$_tx_b"
}
# summary_line_v VAR FILE — the one-line result for history.md: the first non-empty
# line that is not a markdown heading (else the first heading), without leading
# markdown marks, ≤ 200 bytes; 1 if the file has no text
summary_line_v() {
  local _sm_l _sm_r= _sm_h= _sm_head
  [ -f "$2" ] || return 1
  while IFS= read -r _sm_l || [ -n "$_sm_l" ]; do
    _sm_l=${_sm_l//[[:cntrl:]]/ }
    _sm_head=
    case $_sm_l in '#'*) _sm_head=1 ;; esac
    while :; do
      case $_sm_l in '#'* | '*'* | '-'* | '>'* | ' '*) _sm_l=${_sm_l#?} ;; *) break ;; esac
    done
    while :; do
      case $_sm_l in *' ') _sm_l=${_sm_l%?} ;; *) break ;; esac
    done
    [ -n "$_sm_l" ] || continue
    if [ -z "$_sm_head" ]; then
      _sm_r=$_sm_l
      break
    fi
    [ -n "$_sm_h" ] || _sm_h=$_sm_l
  done <"$2"
  [ -n "$_sm_r" ] || _sm_r=$_sm_h
  [ -n "$_sm_r" ] || return 1
  trunc_v _sm_r "$_sm_r" 200
  eval "$1=\$_sm_r"
}
# Items: see "items" below. Used by task close/cancel.
task_claimed_v() { # VAR DIR — ids of items with "Status: claimed"; TC_DESC: "I001 (codex-1), …"
  local _tc_f _tc_l _tc_r= _tc_s _tc_a
  TC_DESC=
  for _tc_f in "$2"/items/I[0-9]*; do
    [ -f "$_tc_f" ] || continue
    case ${_tc_f##*/} in *.*) continue ;; esac
    _tc_s= _tc_a=
    while IFS= read -r _tc_l || [ -n "$_tc_l" ]; do
      case $_tc_l in
        '') break ;;
        'Status: '*) _tc_s=${_tc_l#Status: } ;;
        'Assignee: '*) _tc_a=${_tc_l#Assignee: } ;;
      esac
    done <"$_tc_f"
    [ "$_tc_s" = claimed ] || continue
    _tc_r="$_tc_r${_tc_r:+, }${_tc_f##*/}"
    TC_DESC="$TC_DESC${TC_DESC:+, }${_tc_f##*/}${_tc_a:+ ($_tc_a)}"
  done
  eval "$1=\$_tc_r"
}
# task_unreviewed_v VAR DIR — items handed in but not accepted (DESIGN §7.1.1):
# "I003 (на проверке), I004 (правки)"; "" if none
task_unreviewed_v() {
  local _tu_id _tu_st _tu_as _tu_ti _tu_pa _tu_ce _tu_cr _tu_no _tu_re _tu_hi _tu_rv _tu_dr _tu_ri _tu_rn _tu_v _tu_r _tu_s _tu_o=
  item_table "$2"
  while IFS=$US read -r _tu_id _tu_st _tu_as _tu_ti _tu_pa _tu_ce _tu_cr _tu_no _tu_re _tu_hi _tu_rv _tu_dr _tu_ri _tu_rn _tu_v _tu_r; do
    [ -n "$_tu_id" ] || continue
    item_stage_v _tu_s "$_tu_st" "$_tu_rv" "$_tu_dr" "$_tu_rn" "$_tu_v" "$_tu_ri"
    case $_tu_s in review | fix) ;; *) continue ;; esac
    stage_name_v _tu_s "$_tu_s"
    _tu_o="$_tu_o${_tu_o:+, }$_tu_id ($_tu_s)"
  done <<BRG_TU_EOF
$IT_TABLE
BRG_TU_EOF
  eval "$1=\$_tu_o"
}
# task_cancel_items DIR BY — claimed items → cancelled (DESIGN §6), with the headers
# of item cancel (Cancelled, Cancelled-By; Reviewing cleared); ISO set
task_cancel_items() {
  local f c x rest
  task_claimed_v c "$1"
  rest="$c, "
  while [ -n "$c" ] && [ -n "$rest" ]; do
    x=${rest%%, *}
    rest=${rest#*, }
    f=$1/items/$x
    item_read "$f" || continue
    [ "$IT_STATUS" = claimed ] || continue
    IT_STATUS=cancelled IT_CANCELLED=$ISO IT_CANCELLED_BY=$2 IT_REVIEWING=
    item_write "$f"
  done
}
task_release_reservations() { rm -rf "$1"/reservations/* 2>/dev/null; } # DIR
# history_append STATUS — a line about the loaded task (TK_*, ACT_*) → common/history.md
history_append() {
  local h=$ROOT/common/history.md sum=— path=$RROOT/tasks/$ACT_NAME/ line
  summary_line_v sum "$ACT_DIR/summary.md" || sum=—
  [ "$1" = done ] && path=$RROOT/tasks/$ACT_NAME/summary.md
  if [ ! -f "$h" ]; then
    printf '%s\n' "# История задач" "" \
      "Пишет brg при закрытии и отмене задачи. Подробности — в каталоге задачи." "" >"$h" 2>/dev/null
  fi
  line="- $TK_ID · $1 · «$TK_TITLE» · $TK_CREATED → $TK_CLOSED · host $TK_HOST · lead $TK_LEAD"
  [ "$1" = cancelled ] && line="$line · отменил $TK_CLOSED_BY"
  printf '%s\n' "$line · итог: $sum · $path" >>"$h" 2>/dev/null ||
    say_err "Внимание: не удалось дописать $h"
}
# task_do_cancel ACTOR — cancel the loaded active task (task lock held; NOW/ISO set).
# Its runs in the queue or running are stopped (DESIGN §7): TD_DIR/TD_RUNS for the
# caller to wait for them (runs_await) after releasing the lock.
task_do_cancel() {
  local c r t=$NOW i=$ISO
  task_claimed_v c "$ACT_DIR"
  task_runs_v r "$ACT_DIR"
  task_cancel_items "$ACT_DIR" "$1"
  task_release_reservations "$ACT_DIR"
  [ -n "$r" ] && task_stop_runs "$ACT_DIR" "$1" "при отмене задачи $ACT_ID" "$r"
  NOW=$t ISO=$i
  TD_DIR=$ACT_DIR TD_RUNS=$r
  TK_STATUS=cancelled TK_CLOSED=$ISO TK_CLOSED_EPOCH=$NOW TK_CLOSED_BY=$1
  task_write "$ACT_DIR"
  rm -f "$ROOT/tasks/active"
  history_append cancelled
  BODY="задача $ACT_ID «$TK_TITLE» отменена ($1): прекрати правки, не продолжай работу по ней. Незавершённые правки остаются в рабочем дереве — их судьбу решит lead новой задачи или человек."
  [ -n "$c" ] && BODY="$BODY Подзадачи в работе отменены, резервирования сняты: $TC_DESC."
  [ -n "$r" ] && BODY="$BODY Прогоны задачи остановлены: $TR_DESC."
  msg_write lobby "$1" all system ""
  metric task.cancel id="$ACT_ID" by="$1" runs="${r// /,}"
}
TD_DIR=
TD_RUNS=

cmd_task() {
  local sub=${1:-}
  [ $# -gt 0 ] && shift
  case $sub in
    new | close | cancel | show | list) "task_$sub" "$@" ;;
    -h | --help | help)
      usage_print task
      exit 0
      ;;
    '') usage_die "нужна подкоманда: new | close | cancel | show | list" ;;
    *) usage_die "неизвестная подкоманда: task $sub" ;;
  esac
}

task_new() {
  local title= file= cc= n slug name d brief cleared= cancelled=
  NEXT_ON_ERR="исправь команду и повтори: $BRG task new --as $AS_HINT --title \"…\" <<'BRG_EOF' (постановка человека дословно) BRG_EOF; закончив шаг — $BRG wait --as $AS_HINT"
  while [ $# -gt 0 ]; do
    case $1 in
      --as | --title | --file)
        need_val "$@"
        case $1 in
          --as) OPT_AS=$2 ;;
          --title) title=$2 ;;
          --file) file=$2 ;;
        esac
        shift 2
        ;;
      --cancel-current)
        cc=1
        shift
        ;;
      -h | --help)
        usage_print task
        exit 0
        ;;
      *) usage_die "неизвестный параметр: $1 (постановка — через stdin/heredoc или --file)" ;;
    esac
  done
  need_root
  STOP_SHOWN=1 # a new task lifts the stop (below)
  need_agent write
  NEXT_ON_ERR="исправь команду и повтори: $BRG task new --as $ASN --title \"…\" <<'BRG_EOF' (постановка человека дословно) BRG_EOF; закончив шаг — $BRG wait --as $ASN"
  title=${title//[[:cntrl:]]/ }
  while :; do
    case $title in ' '*) title=${title# } ;; *' ') title=${title% } ;; *) break ;; esac
  done
  [ -n "$title" ] || usage_die "нужен --title \"…\": коротко, о чём задача (одна строка)"
  fit_v title "$title" 200 "--title" "Подробности — в постановке."
  read_body "$file" brief
  brief=$BODY
  get_now_iso
  lock_acquire task
  if active_task && task_read "$ACT_DIR"; then
    if [ -z "$cc" ]; then
      die "уже есть активная задача $ACT_ID «$TK_TITLE» (host $TK_HOST, lead $TK_LEAD)" \
        "В проекте одна активная задача. Если человек сказал бросить её и взяться за новую — повтори с --cancel-current (текущая будет отменена)." \
        "Если это часть текущей задачи — обсуди её в канале $ACT_ID."
    fi
    task_do_cancel "$AGENT"
    cancelled=$ACT_ID
  fi
  task_next_id_v n
  slug_v slug "$title"
  name=$n${slug:+-$slug}
  d=$ROOT/tasks/$name
  mkdir "$d" 2>/dev/null && mkdir -p "$d/messages" "$d/cursors" "$d/items" "$d/reservations" "$d/shared" ||
    die "не удалось создать $d"
  { printf '%s\n' "$brief" >"$d/.tmp.brief.$$" && mv_retry "$d/.tmp.brief.$$" "$d/brief.md"; } ||
    die "не удалось записать $d/brief.md"
  printf '0\n' >"$d/seq"
  TK_ID=$n TK_TITLE=$title TK_STATUS=active TK_HOST=$AGENT TK_LEAD=$AGENT
  TK_CREATED=$ISO TK_CREATED_EPOCH=$NOW TK_CREATED_BY=$AGENT
  TK_CLOSED= TK_CLOSED_EPOCH= TK_CLOSED_BY= TK_EXTRA=
  task_write "$d"
  { printf '%s\n' "$name" >"$ROOT/tasks/.tmp.active.$$" && mv_retry "$ROOT/tasks/.tmp.active.$$" "$ROOT/tasks/active"; } ||
    die "не удалось записать $ROOT/tasks/active"
  # DESIGN §9: a new task lifts the stop — the human has just given work.
  if [ -e "$RUN/stopped" ]; then
    rm -f "$RUN/stopped"
    cleared=1
  fi
  if [ -e "$RUN/stopped.$AGENT" ]; then
    rm -f "$RUN/stopped.$AGENT"
    cleared="$cleared${cleared:+ }me"
  fi
  BODY="новая задача $n: «$title» · host и lead: $AGENT. Прочитай постановку: $RROOT/tasks/$name/brief.md. Переписка по задаче — в канале $n (send по умолчанию идёт туда). Цель, рамки и рекомендованный порядок работы — $RROOT/PROTOCOL.md."
  msg_write lobby "$AGENT" all system ""
  lock_release task
  touch_seen
  metric task.new id="$n" cancel_current="${cc:-0}" brief_bytes=$((${#brief} + 1))
  [ -n "$cancelled" ] && echo "── задача $cancelled отменена: всем отправлено «прекрати правки»."
  if [ -n "$cancelled" ] && [ -n "$TD_RUNS" ]; then
    runs_await "$TD_DIR" "$TD_RUNS"
    echo "$RA_TEXT"
  fi
  echo "── создана задача $n «$title»: ты host и lead."
  echo "Каталог: $RROOT/tasks/$name/ — brief.md (постановка), shared/ (план, решения, артефакты), summary.md (итог; нужен для task close, первая строка — итог одной фразой)."
  echo "Всем отправлено системное «новая задача» (lobby). Переписка по задаче — канал $n: send по умолчанию идёт туда."
  case $cleared in 1*) echo "Общий стоп снят. Остановленные агенты завершили ход — попроси человека написать им «продолжай»." ;; esac
  case $cleared in *me) echo "Стоп, поставленный тебе человеком, снят: он дал новую задачу." ;; esac
  echo "Как работать — решаете сообща; проверенный порядок (PROTOCOL.md, не обязателен): перекличка с --reply-by 10m (каждый один раз ответит: модель, сильные стороны, загрузка), затем план в shared/plan.md."
  echo "Lead — фасилитатор: план и подзадачи — вместе с бригадой, работу раздай участникам. Ты, как и все, только координатор: исследование и любую работу по своей части делает твой подагент — одновременно один; больше — только с разрешения человека; сам держи цикл wait. Как проверять подзадачи (другим участником — рекомендуется) — решаете сами; обязательно одно: стадии подзадач в brg — как на деле, человек смотрит их на доске (README, раздел 5)."
  echo "Человек читает твой чат, а не переписку brg: отчёты и вопросы ему пиши обычным текстом в своём чате перед очередным wait (копия для протокола — send --to human)."
  fit_warn_print
  echo "── NEXT: продолжай; закончив шаг — $BRG wait --as $ASN"
}

# close_unread — DESIGN §6, "refusal = delivery": what would wake the lead's wait
# (after Pending in its wait channels) is delivered by task close itself: printed
# like wait prints it (quiet ones too, capped at wait_output_max), then Pending :=
# the last shown, Acked untouched (the next wait confirms the batch). Deadline
# reports are left to wait. 0 if something was shown (CU_COUNT messages).
close_unread() {
  local i c d wake= out= budget=$OUTMAX force=1 pl n=0 x
  local -a dirs acks shows
  CU_COUNT=0
  listen_set
  i=0
  while [ $i -lt "$LS_N" ]; do
    c=${LS_CH[i]}
    i=$((i + 1))
    chan_dir d "$c" || continue
    cursor_read "$d/cursors/$AGENT"
    scan_new "$d" "$CUR_PEND"
    [ "$SCAN_N" -gt 0 ] || continue
    FMT_COUNTONLY=1
    fmt_msgs wait 0 1
    FMT_COUNTONLY=
    [ "$FMT_WAKE" -gt 0 ] && wake=1
  done
  [ -n "$wake" ] || return 1
  i=0
  while [ $i -lt "$LS_N" ]; do
    c=${LS_CH[i]}
    i=$((i + 1))
    chan_dir d "$c" || continue
    cursor_read "$d/cursors/$AGENT"
    scan_new "$d" "$CUR_PEND"
    [ "$SCAN_N" -gt 0 ] || continue
    fmt_msgs wait "$budget" "$force"
    [ "$FMT_SHOWN" -gt 0 ] || continue
    plural_new_v pl "$FMT_SHOWN"
    out="$out── $c${LS_NOTE[i - 1]} · $FMT_SHOWN $pl ─────────────────────────────$NL$FMT_TEXT"
    x=$SCAN_MAX
    if [ "$FMT_REST" -gt 0 ]; then
      out="$out── ещё $FMT_REST в $c не вошло (лимит вывода): покажет следующий task close$NL"
      x=$FMT_LAST
    fi
    dirs[n]=$d acks[n]=$CUR_ACK shows[n]=$x
    n=$((n + 1))
    budget=$((budget - ${#FMT_TEXT}))
    force=0
    CU_COUNT=$((CU_COUNT + FMT_SHOWN))
  done
  [ "$n" -gt 0 ] || return 1
  lock_release task # the task is not changed from here on
  if printf '%s' "$out"; then
    # at-least-once: issued (Pending) only after the output was written
    i=0
    while [ $i -lt "$n" ]; do
      [ -d "${dirs[i]}/cursors" ] || mkdir -p "${dirs[i]}/cursors"
      cursor_write "${dirs[i]}/cursors/$AGENT" "${acks[i]}" "${shows[i]}"
      i=$((i + 1))
    done
  fi
  metric task.close.unread shown="$CU_COUNT"
  return 0
}

task_close() {
  local force= sum c r t x
  NEXT_ON_ERR="$BRG task close --as $AS_HINT [--force]; закончив шаг — $BRG wait --as $AS_HINT"
  while [ $# -gt 0 ]; do
    case $1 in
      --as)
        need_val "$@"
        OPT_AS=$2
        shift 2
        ;;
      --force)
        force=1
        shift
        ;;
      -h | --help)
        usage_print task
        exit 0
        ;;
      *) usage_die "неизвестный параметр: $1" ;;
    esac
  done
  need_root
  need_agent write
  NEXT_ON_ERR="исправь и повтори $BRG task close --as $ASN; закончив шаг — $BRG wait --as $ASN"
  get_now_iso
  lock_acquire task
  active_task && task_read "$ACT_DIR" || die "нет активной задачи" "Все задачи: $BRG task list"
  if [ "$TK_LEAD" != "$AGENT" ]; then
    die "закрыть задачу $ACT_ID может только lead ($TK_LEAD)" \
      "Если $TK_LEAD asleep/gone — сначала возьми роль: $BRG lead take --as $ASN; иначе напиши ему: $BRG send --as $ASN --to $TK_LEAD"
  fi
  # before summary.md: the lead sees what came in before writing the result
  if close_unread; then
    NEXT_ON_ERR="учти сообщения выше (ответь, если нужно; поправь summary.md), затем повтори: $BRG task close --as $ASN${force:+ --force}"
    die "задача $ACT_ID не закрыта: тебе пришли сообщения (выше, $CU_COUNT) — учти их и повтори task close" \
      "Показанное считается доставленным: повтор пройдёт, если нового не придёт (read не нужен)."
  fi
  if ! summary_line_v sum "$ACT_DIR/summary.md"; then
    die "нет итога: $RROOT/tasks/$ACT_NAME/summary.md пуст или не создан" \
      "Напиши итог: первая строка — итог одной фразой (попадёт в $RROOT/common/history.md), дальше — что сделано, где, как проверено, что осталось. Затем повтори task close."
  fi
  task_claimed_v c "$ACT_DIR"
  if [ -n "$c" ] && [ -z "$force" ]; then
    die "подзадачи ещё в работе (claimed): $c" \
      "Дождись их завершения или закрой принудительно (claimed → cancelled): $BRG task close --as $ASN --force"
  fi
  t=$NOW
  x=$ISO
  task_runs_v r "$ACT_DIR"
  if [ -n "$r" ] && [ -z "$force" ]; then
    die "прогоны задачи ещё идут: $TR_DESC" \
      "Дождись результатов (придут инициаторам сообщением; список: $BRG run list) или закрой принудительно — прогоны будут остановлены: $BRG task close --as $ASN --force"
  fi
  [ -n "$c" ] && task_cancel_items "$ACT_DIR" "$AGENT"
  [ -n "$r" ] && task_stop_runs "$ACT_DIR" "$AGENT" "при закрытии задачи $ACT_ID (--force)" "$r"
  NOW=$t ISO=$x
  task_release_reservations "$ACT_DIR"
  TK_STATUS=done TK_CLOSED=$ISO TK_CLOSED_EPOCH=$NOW TK_CLOSED_BY=$AGENT
  task_write "$ACT_DIR"
  rm -f "$ROOT/tasks/active"
  history_append done
  BODY="задача $ACT_ID «$TK_TITLE» закрыта (lead $AGENT). Итог: $sum. Подробно: $RROOT/tasks/$ACT_NAME/summary.md"
  [ -n "$c" ] && BODY="$BODY${NL}Закрыта с --force: подзадачи в работе отменены — $TC_DESC; прекрати правки по ним."
  [ -n "$r" ] && BODY="$BODY${NL}Закрыта с --force: прогоны остановлены — $TR_DESC."
  msg_write lobby "$AGENT" all system ""
  lock_release task
  touch_seen
  metric task.close id="$ACT_ID" force="${force:-0}" runs="${r// /,}"
  echo "── задача $ACT_ID «$TK_TITLE» закрыта. Строка добавлена в $RROOT/common/history.md; всем отправлено системное сообщение."
  [ -n "$c" ] && echo "Внимание: закрыта с --force; подзадачи $c отменены."
  # not a refusal (DESIGN §7.1.1): brg does not require reviews, it only names them
  task_unreviewed_v x "$ACT_DIR"
  [ -n "$x" ] && echo "Внимание: не приняты: $x — brg закрытию не мешает, но скажи о них человеку в отчёте."
  if [ -n "$r" ]; then
    runs_await "$ACT_DIR" "$r"
    echo "$RA_TEXT"
  fi
  echo "── NEXT: $BRG wait --as $ASN"
}

# task cancel: host, lead or the human (--as human: explicit, so an agent that
# forgot --as gets an error instead of acting as the human).
task_cancel() {
  NEXT_ON_ERR="$BRG task cancel --as $AS_HINT; закончив шаг — $BRG wait --as $AS_HINT"
  while [ $# -gt 0 ]; do
    case $1 in
      --as)
        need_val "$@"
        OPT_AS=$2
        shift 2
        ;;
      -h | --help)
        usage_print task
        exit 0
        ;;
      *) usage_die "неизвестный параметр: $1" ;;
    esac
  done
  need_root
  if [ "$OPT_AS" = human ]; then
    AGENT=human
    NEXT_ON_ERR=
  else
    need_agent write
    NEXT_ON_ERR="$BRG wait --as $ASN"
  fi
  get_now_iso
  lock_acquire task
  active_task && task_read "$ACT_DIR" || die "нет активной задачи" "Все задачи: $BRG task list"
  if [ "$AGENT" != human ] && [ "$AGENT" != "$TK_HOST" ] && [ "$AGENT" != "$TK_LEAD" ]; then
    die "отменить задачу $ACT_ID может host ($TK_HOST), lead ($TK_LEAD) или человек" \
      "Предложи отмену host: $BRG send --as $ASN --to $TK_HOST"
  fi
  task_do_cancel "$AGENT"
  lock_release task
  [ "$AGENT" = human ] || touch_seen
  echo "── задача $ACT_ID «$TK_TITLE» отменена: всем отправлено «прекрати правки». Строка добавлена в $RROOT/common/history.md."
  if [ -n "$TD_RUNS" ]; then
    runs_await "$TD_DIR" "$TD_RUNS"
    echo "$RA_TEXT"
  fi
  [ "$AGENT" = human ] || echo "── NEXT: $BRG wait --as $ASN"
  return 0
}

task_show() {
  local id= n d name role brief plan sum
  while [ $# -gt 0 ]; do
    case $1 in
      --as)
        need_val "$@"
        OPT_AS=$2
        shift 2
        ;;
      -h | --help)
        usage_print task
        exit 0
        ;;
      -*) usage_die "неизвестный параметр: $1" ;;
      *)
        [ -z "$id" ] || usage_die "лишний аргумент: $1"
        id=$1
        shift
        ;;
    esac
  done
  need_root
  get_now
  if [ -n "$OPT_AS" ]; then
    need_agent read
    touch_seen
  fi
  if [ -n "$id" ]; then
    task_norm_id_v n "$id" || usage_die "номер задачи вида T001: $id"
    task_dir_v d "$n" || die "нет задачи $n" "Все задачи: $BRG task list"
  else
    active_task || die "активной задачи нет" "Все задачи: $BRG task list · показать одну: $BRG task show T00N"
    d=$ACT_DIR
  fi
  task_read "$d"
  name=${d##*/}
  echo "── $TK_ID «$TK_TITLE» · $TK_STATUS"
  echo "host $TK_HOST · lead $TK_LEAD · создана $TK_CREATED ($TK_CREATED_BY)${TK_CLOSED:+ · завершена $TK_CLOSED ($TK_CLOSED_BY)}"
  if [ -n "$AGENT" ]; then
    role_v role "$AGENT"
    if [ -n "${AS_NOKEY:-}" ]; then echo "Роль $AGENT: $role"; else echo "Твоя роль: $role"; fi
  fi
  echo "Каталог: $RROOT/tasks/$name/"
  plan="нет (его пишет lead: shared/plan.md)"
  [ -f "$d/shared/plan.md" ] && plan=$RROOT/tasks/$name/shared/plan.md
  echo "План: $plan"
  if summary_line_v sum "$d/summary.md"; then
    echo "Итог: $sum ($RROOT/tasks/$name/summary.md)"
  else
    echo "Итог: нет (summary.md)"
  fi
  echo "Переписка: $BRG read --as ${ASN:-<имя>} --channel $TK_ID --since 0"
  echo "── brief.md ($RROOT/tasks/$name/brief.md) ──"
  brief=$(cat "$d/brief.md" 2>/dev/null)
  if [ ${#brief} -gt "$OUTMAX" ]; then
    trunc_v brief "$brief" "$OUTMAX"
    printf '%s\n' "$brief"
    echo "── постановка обрезана (лимит вывода) — целиком: $RROOT/tasks/$name/brief.md"
  else
    printf '%s\n' "$brief"
    echo "── конец постановки"
  fi
  metric task.show id="$TK_ID"
  [ -n "$AGENT" ] && echo "── NEXT: продолжай; закончив шаг — $BRG wait --as $ASN"
  return 0
}

task_list() {
  local f cnt=0
  while [ $# -gt 0 ]; do
    case $1 in
      --as)
        need_val "$@"
        shift 2
        ;;
      -h | --help)
        usage_print task
        exit 0
        ;;
      *) usage_die "неизвестный параметр: $1" ;;
    esac
  done
  need_root
  for f in "$ROOT"/tasks/T[0-9]*; do
    task_read "$f" || continue
    echo "$TK_ID · $TK_STATUS · «$TK_TITLE» · host $TK_HOST · lead $TK_LEAD · $TK_CREATED${TK_CLOSED:+ → $TK_CLOSED}"
    cnt=$((cnt + 1))
  done
  [ "$cnt" -gt 0 ] || echo "── задач ещё не было"
  return 0
}

# lead|host give <name> (only the current holder) | take (only if the holder is
# asleep/gone, DESIGN §5.2). A system message goes to the task channel.
cmd_role() {
  local role=$1 sub= target= cur new how warn=
  shift
  sub=${1:-}
  [ $# -gt 0 ] && shift
  NEXT_ON_ERR="$BRG $role give <имя> --as $AS_HINT | $BRG $role take --as $AS_HINT; закончив шаг — $BRG wait --as $AS_HINT"
  case $sub in
    give | take) ;;
    -h | --help | help)
      usage_print "$role"
      exit 0
      ;;
    '') usage_die "нужна подкоманда: give <имя> | take" ;;
    *) usage_die "неизвестная подкоманда: $role $sub" ;;
  esac
  while [ $# -gt 0 ]; do
    case $1 in
      --as)
        need_val "$@"
        OPT_AS=$2
        shift 2
        ;;
      -h | --help)
        usage_print "$role"
        exit 0
        ;;
      -*) usage_die "неизвестный параметр: $1" ;;
      *)
        [ "$sub" = give ] && [ -z "$target" ] || usage_die "лишний аргумент: $1"
        case $1 in ?*.*) target=${1%%.*} ;; *) target=$1 ;; esac # the key, if any, is dropped
        shift
        ;;
    esac
  done
  [ "$sub" = take ] || [ -n "$target" ] || usage_die "кому передать: $role give <имя>"
  need_root
  need_agent write
  NEXT_ON_ERR="$BRG wait --as $ASN"
  get_now_iso
  lock_acquire task
  active_task && task_read "$ACT_DIR" || die "нет активной задачи — роли бывают только у неё"
  if [ "$role" = lead ]; then cur=$TK_LEAD; else cur=$TK_HOST; fi
  if [ "$sub" = give ]; then
    [ "$cur" = "$AGENT" ] || die "передать $role может только текущий $role ($cur)" \
      "Если $cur asleep/gone — возьми роль: $BRG $role take --as $ASN; иначе договорись с ним: $BRG send --as $ASN --to $cur"
    valid_name "$target" && [ -f "$ROOT/agents/$target" ] || die "нет такого агента: $target" "Кто подключён: $BRG who"
    [ "$target" != "$AGENT" ] || die "ты уже $role задачи $ACT_ID"
    agent_state "$target"
    [ "$ST" != gone ] || die "$target — gone: передавать роль некому" "Кто онлайн: $BRG who"
    [ "$ST" = asleep ] && warn="Внимание: $target сейчас asleep — может не скоро ответить."
    new=$target
    how="передал $AGENT"
  else
    if [ "$cur" = "$AGENT" ]; then
      lock_release task
      echo "── ты уже $role задачи $ACT_ID"
      echo "── NEXT: $BRG wait --as $ASN"
      return 0
    fi
    ST=gone
    valid_name "$cur" && [ -f "$ROOT/agents/$cur" ] && agent_state "$cur"
    case $ST in
      asleep | gone) ;;
      *)
        die "$role $cur активен ($ST) — взять роль можно, только если он asleep или gone" \
          "Договорись с ним: $BRG send --as $ASN --to $cur; передать роль может он сам: $BRG $role give $AGENT --as <его полное имя>"
        ;;
    esac
    new=$AGENT
    how="взял $AGENT: $cur — $ST"
  fi
  if [ "$role" = lead ]; then TK_LEAD=$new; else TK_HOST=$new; fi
  task_write "$ACT_DIR"
  BODY="$role задачи $ACT_ID: $cur → $new ($how)"
  msg_write "$ACT_ID" "$AGENT" all system ""
  lock_release task
  touch_seen
  metric "$role.$sub" id="$ACT_ID" from="$cur" to="$new"
  echo "── $role задачи $ACT_ID: $cur → $new. Участникам — системное сообщение в канале $ACT_ID."
  [ -n "$warn" ] && echo "$warn"
  if [ "$new" = "$AGENT" ]; then
    if [ "$role" = lead ]; then
      echo "Теперь ты ведёшь работу: план (shared/plan.md), распределение, приёмка, summary.md и task close."
    else
      echo "Теперь ты host: только ты сам пишешь человеку — ход работы, вопросы, итог: обычным текстом в своём чате перед очередным wait (копия для протокола — send --to human)."
    fi
  fi
  echo "── NEXT: продолжай; закончив шаг — $BRG wait --as $ASN"
}

# ── items: subtasks and path reservations (DESIGN §7) ─────────────────────
# tasks/<T>/items/I001 — headers (Id, Title, Status todo|claimed|done|cancelled,
# Creator, Assignee, Paths, Created, Claimed, Claimed-Epoch, Done, Result, Note)
# + blank line + description. Reviews: items/I001.reviews/<n> (one immutable file
# per review: headers + comment). Reservations: reservations/I001 — headers (Item,
# Agent, Time) + one normalized path per line; written and removed together with
# the item under the "task" lock. A reservation counts only while its item is
# claimed by that agent (a leftover of a crash between the two writes is ignored).
# Paths are relative to the project root (the parent of .brigada); "." = all of it.
# Two paths overlap when one is a prefix of the other at a component boundary
# (src/a and src/ab do not; src and src/a do), compared case-insensitively (macOS
# and Windows file systems are).
US=$'\037' # field separator of the item table (never in titles/paths: control chars are rejected)

item_norm_id_v() { # VAR RAW — I1 | i001 | 1 → I001; 1 if not an item id
  local _in_n=$2
  case $_in_n in [Ii]*) _in_n=${_in_n#?} ;; esac
  is_uint "$_in_n" && [ ${#_in_n} -le 6 ] || return 1
  _in_n=$((10#$_in_n))
  [ "$_in_n" -gt 0 ] || return 1
  printf -v _in_n 'I%03d' "$_in_n"
  eval "$1=\$_in_n"
}
item_files() { # DIR → ITEM_FILES[] (glob order: by number up to I999)
  local f n
  ITEM_FILES=()
  for f in "$1"/items/I[0-9]*; do
    [ -f "$f" ] || continue
    n=${f##*/}
    is_uint "${n#I}" || continue # I + digits only: not I001.reviews, I002~, I003.bak
    ITEM_FILES[${#ITEM_FILES[@]}]=$f
  done
}
item_next_id_v() { # VAR DIR
  local _ix_f _ix_n _ix_m=0
  item_files "$2"
  for _ix_f in "${ITEM_FILES[@]}"; do
    _ix_n=${_ix_f##*/I}
    is_uint "$_ix_n" && [ ${#_ix_n} -le 6 ] || continue
    _ix_n=$((10#$_ix_n))
    [ "$_ix_n" -gt "$_ix_m" ] && _ix_m=$_ix_n
  done
  printf -v _ix_n 'I%03d' $((_ix_m + 1))
  eval "$1=\$_ix_n"
}

item_read() { # FILE → IT_* (IT_BODY: the description)
  local line hdr=1
  IT_ID= IT_TITLE= IT_STATUS= IT_CREATOR= IT_ASSIGNEE= IT_PATHS= IT_HINT= IT_CREATED= IT_CLAIMED= IT_CLAIMED_EPOCH=
  IT_DONE= IT_RESULT= IT_NOTE= IT_EXTRA= IT_BODY= IT_REVIEW= IT_DONE_REVIEWS= IT_REVIEWING= IT_CANCELLED= IT_CANCELLED_BY=
  [ -f "$1" ] || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    if [ -z "$hdr" ]; then
      IT_BODY=$IT_BODY$line$NL
      continue
    fi
    case $line in
      '') hdr= ;;
      'Id: '*) IT_ID=${line#Id: } ;;
      'Title: '*) IT_TITLE=${line#Title: } ;;
      'Status: '*) IT_STATUS=${line#Status: } ;;
      'Creator: '*) IT_CREATOR=${line#Creator: } ;;
      'Assignee: '*) IT_ASSIGNEE=${line#Assignee: } ;;
      'Paths: '*) IT_PATHS=${line#Paths: } ;;
      'Paths-Hint: '*) IT_HINT=${line#Paths-Hint: } ;;
      'Created: '*) IT_CREATED=${line#Created: } ;;
      'Claimed: '*) IT_CLAIMED=${line#Claimed: } ;;
      'Claimed-Epoch: '*) IT_CLAIMED_EPOCH=${line#Claimed-Epoch: } ;;
      'Done: '*) IT_DONE=${line#Done: } ;;
      'Result: '*) IT_RESULT=${line#Result: } ;;
      'Note: '*) IT_NOTE=${line#Note: } ;;
      'Review: '*) IT_REVIEW=${line#Review: } ;;
      'Done-Reviews: '*) IT_DONE_REVIEWS=${line#Done-Reviews: } ;;
      'Reviewing: '*) IT_REVIEWING=${line#Reviewing: } ;;
      'Cancelled: '*) IT_CANCELLED=${line#Cancelled: } ;;
      'Cancelled-By: '*) IT_CANCELLED_BY=${line#Cancelled-By: } ;;
      *) IT_EXTRA=$IT_EXTRA$line$NL ;;
    esac
  done <"$1"
  IT_BODY=${IT_BODY%"$NL"}
  [ -n "$IT_ID" ] || IT_ID=${1##*/}
  return 0
}
item_write() { # FILE — IT_* → FILE (tmp + mv)
  local t=${1%/*}/.tmp.${1##*/}.$$
  if ! {
    printf 'Id: %s\nTitle: %s\nStatus: %s\nCreator: %s\n' "$IT_ID" "$IT_TITLE" "$IT_STATUS" "$IT_CREATOR"
    [ -z "$IT_ASSIGNEE" ] || printf 'Assignee: %s\n' "$IT_ASSIGNEE"
    [ -z "$IT_PATHS" ] || printf 'Paths: %s\n' "$IT_PATHS"
    [ -z "$IT_HINT" ] || printf 'Paths-Hint: %s\n' "$IT_HINT"
    [ -z "$IT_REVIEW" ] || printf 'Review: %s\n' "$IT_REVIEW"
    printf 'Created: %s\n' "$IT_CREATED"
    [ -z "$IT_CLAIMED" ] || printf 'Claimed: %s\nClaimed-Epoch: %s\n' "$IT_CLAIMED" "$IT_CLAIMED_EPOCH"
    [ -z "$IT_DONE" ] || printf 'Done: %s\n' "$IT_DONE"
    [ -z "$IT_DONE_REVIEWS" ] || printf 'Done-Reviews: %s\n' "$IT_DONE_REVIEWS"
    [ -z "$IT_RESULT" ] || printf 'Result: %s\n' "$IT_RESULT"
    [ -z "$IT_NOTE" ] || printf 'Note: %s\n' "$IT_NOTE"
    [ -z "$IT_REVIEWING" ] || printf 'Reviewing: %s\n' "$IT_REVIEWING"
    [ -z "$IT_CANCELLED" ] || printf 'Cancelled: %s\nCancelled-By: %s\n' "$IT_CANCELLED" "$IT_CANCELLED_BY"
    printf '%s\n%s\n' "$IT_EXTRA" "$IT_BODY"
  } >"$t" || ! mv_retry "$t" "$1"; then
    rm -f "$t"
    die "не удалось записать $1"
  fi
}

# one_line_v VAR TEXT MAX — control chars → spaces, trimmed, ≤ MAX bytes (cut with "…")
one_line_v() {
  local _ol_s=${2//[[:cntrl:]]/ }
  while :; do
    case $_ol_s in ' '*) _ol_s=${_ol_s# } ;; *' ') _ol_s=${_ol_s% } ;; *) break ;; esac
  done
  trunc_v _ol_s "$_ol_s" "$3"
  eval "$1=\$_ol_s"
}
first_line_v() { # VAR TEXT MAX — the first non-blank line of TEXT, one_line_v'd
  local _fl_l _fl_r=
  while IFS= read -r _fl_l || [ -n "$_fl_l" ]; do
    case $_fl_l in *[![:space:]]*)
      _fl_r=$_fl_l
      break
      ;;
    esac
  done <<BRG_FL_EOF
$2
BRG_FL_EOF
  one_line_v "$1" "$_fl_r" "$3"
}

# path_norm_v VAR RAW — a path relative to the project root: "\" → "/", no "./",
# no repeated or trailing "/", "." for the whole project. 1 + PN_ERR if absolute,
# with "..", "~", a glob or control characters.
path_norm_v() {
  local _pn_p=${2//\\//} _pn_r= _pn_c _pn_rest
  PN_ERR=
  while :; do
    case $_pn_p in ' '*) _pn_p=${_pn_p# } ;; *' ') _pn_p=${_pn_p% } ;; *) break ;; esac
  done
  case $_pn_p in
    *[[:cntrl:]]*) PN_ERR="управляющие символы в пути" ;;
    /* | [A-Za-z]:*) PN_ERR="абсолютный путь — нужен путь от корня проекта ($PROJ)" ;;
    '~'*) PN_ERR="~ — нужен путь от корня проекта" ;;
    *[*?[]*) PN_ERR="маски (*, ?, [) не поддерживаются — укажи файл или каталог" ;;
  esac
  [ -z "$PN_ERR" ] || return 1
  _pn_rest=$_pn_p/
  while [ -n "$_pn_rest" ]; do
    _pn_c=${_pn_rest%%/*}
    _pn_rest=${_pn_rest#*/}
    case $_pn_c in
      '' | .) continue ;;
      ..)
        PN_ERR=".. — выход за корень проекта запрещён"
        return 1
        ;;
    esac
    _pn_r=$_pn_r${_pn_r:+/}$_pn_c
  done
  [ ${#_pn_r} -le 300 ] || {
    PN_ERR="путь длиннее 300 байт"
    return 1
  }
  eval "$1=\${_pn_r:-.}"
}
# paths_parse RAW → PP_LIST: "none", or normalized paths joined by "," (no
# duplicates; "." alone if the whole project is among them). Dies on a bad path.
paths_parse() {
  local rest=$1, x n=0 out= y
  case $1 in none | NONE | None)
    PP_LIST=none
    return 0
    ;;
  esac
  while [ -n "$rest" ]; do
    x=${rest%%,*}
    rest=${rest#*,}
    case $x in *[![:space:]]*) ;; *) continue ;; esac
    path_norm_v y "$x" || die "недопустимый путь в --paths: «$x» — $PN_ERR" \
      "Пути — от корня проекта, через запятую: --paths \"src/auth,tests/auth\"; весь проект — --paths .; без правок файлов — --paths none."
    [ "$y" != none ] || die "none нельзя смешивать с путями: $1"
    case ",$out," in *",$y,"*) continue ;; esac
    out=$out${out:+,}$y
    n=$((n + 1))
  done
  [ -n "$out" ] || die "пустой --paths: $1" "Пример: --paths \"src/auth,tests/auth\" (без правок файлов — --paths none)"
  [ "$n" -le 50 ] || die "в --paths больше 50 путей — укажи общие каталоги"
  case ",$out," in *,.,*) out=. ;; esac
  PP_LIST=$out
}

# Reservations of a task: AWK_RES reads reservation files (names on stdin), keeps
# those whose item is claimed by the same agent and prints, per mode:
#   list:     item US agent US path            (every valid reserved path)
#   conflict: mine US agent US item US path    (overlaps of `mine` with others'
#             paths; the agent `me` and the item `skip` are not others)
#   own:      the same fields, overlaps with `me`'s own other items (not `skip`)
AWK_RES='
function ov(a, b) {
  a = tolower(a); b = tolower(b)
  return a == "." || b == "." || a == b || index(b, a "/") == 1 || index(a, b "/") == 1
}
BEGIN { nm = split(mine, m, ",") }
{
  f = $0; id = f; sub(/^.*\//, "", id)
  ag = ""; hdr = 1; np = 0
  while ((getline l < f) > 0) {
    if (hdr) { if (l == "") hdr = 0; else if (index(l, "Agent: ") == 1) ag = substr(l, 8); continue }
    if (l != "") p[++np] = l
  }
  close(f)
  st = ""; as = ""; itf = items "/" id
  while ((getline l < itf) > 0) {
    if (l == "") break
    if (index(l, "Status: ") == 1) st = substr(l, 9)
    if (index(l, "Assignee: ") == 1) as = substr(l, 11)
  }
  close(itf)
  if (st != "claimed" || as != ag || ag == "") next
  if (mode == "list") { for (i = 1; i <= np; i++) print id US ag US p[i]; next }
  if (mode == "own") { if (ag != me || id == skip) next }
  else if (ag == me || id == skip) next
  for (j = 1; j <= nm; j++) for (i = 1; i <= np; i++) if (ov(m[j], p[i])) print m[j] US ag US id US p[i]
}'
res_awk() { # DIR MODE MINE ME SKIP → RES_OUT
  local f l=
  RES_OUT=
  for f in "$1"/reservations/I[0-9]*; do
    [ -f "$f" ] || continue
    case ${f##*/} in *.*) continue ;; esac
    l=$l$f$NL
  done
  [ -n "$l" ] || return 0
  RES_OUT=$(printf '%s' "$l" | awk -v mode="$2" -v mine="$3" -v me="$4" -v skip="$5" -v items="$1/items" -v US="$US" "$AWK_RES")
}
# res_conflicts DIR PATHS AGENT ITEM → RC_LINES (human-readable, one per conflict; "" if none)
res_conflicts() {
  local mine ag id path st t
  RC_LINES=
  [ "$2" = none ] && return 0
  res_awk "$1" conflict "$2" "$3" "$4"
  [ -n "$RES_OUT" ] || return 0
  while IFS=$US read -r mine ag id path; do
    [ -n "$id" ] || continue
    agent_state "$ag"
    t=$(sed -n 's/^Title: //p; /^$/q' "$1/items/$id" 2>/dev/null)
    RC_LINES="$RC_LINES  $mine ↔ $path — $id «$t», $ag ($ST)$NL"
  done <<BRG_RC_EOF
$RES_OUT
BRG_RC_EOF
  RC_LINES=${RC_LINES%"$NL"}
}
# res_own DIR PATHS AGENT ITEM → RO_LINES (overlaps with AGENT's other claimed
# items, one per line; "" if none), RO_IDS ("I001, I003")
res_own() {
  local mine ag id path t
  RO_LINES= RO_IDS=
  [ "$2" = none ] && return 0
  res_awk "$1" own "$2" "$3" "$4"
  [ -n "$RES_OUT" ] || return 0
  while IFS=$US read -r mine ag id path; do
    [ -n "$id" ] || continue
    t=$(sed -n 's/^Title: //p; /^$/q' "$1/items/$id" 2>/dev/null)
    RO_LINES="$RO_LINES  $mine ↔ $path — $id «$t»$NL"
    case ", $RO_IDS," in *", $id,"*) ;; *) RO_IDS="$RO_IDS${RO_IDS:+, }$id" ;; esac
  done <<BRG_RO_EOF
$RES_OUT
BRG_RO_EOF
  RO_LINES=${RO_LINES%"$NL"}
}
res_write() { # DIR ITEM AGENT PATHS — reservation file (removed for "none")
  local f=$1/reservations/$2 t x rest=$4,
  if [ "$4" = none ]; then
    rm -f "$f"
    return 0
  fi
  [ -d "$1/reservations" ] || mkdir -p "$1/reservations"
  t=$1/reservations/.tmp.$2.$$
  if ! {
    printf 'Item: %s\nAgent: %s\nTime: %s\n\n' "$2" "$3" "$ISO"
    while [ -n "$rest" ]; do
      x=${rest%%,*}
      rest=${rest#*,}
      [ -n "$x" ] && printf '%s\n' "$x"
    done
  } >"$t" || ! mv_retry "$t" "$f"; then
    rm -f "$t"
    die "не удалось записать $f"
  fi
}
res_remove() { rm -f "$1/reservations/$2"; } # DIR ITEM
paths_show_v() { # VAR PATHS — "src/a, tests/a" | "— (без правок файлов)"
  local _ps_s=${2//,/, }
  [ "$2" = none ] && _ps_s="— (без правок файлов)"
  [ "$2" = . ] && _ps_s=". (весь проект)"
  eval "$1=\$_ps_s"
}

# Verdict records of an item: items/I001.reviews/<n>, n — a number from 1 (DESIGN
# §7.1.1). Anything else there (2.bak, 3~, 0, an editor's backup) is not a record:
# every reader skips it — the item table, review_info, item show, the board.
# review_files DIR_OF_REVIEWS → RF_LIST: the names of the records in the order of
# their numbers (space-separated), RF_N — how many
review_files() {
  local f x y r l= n2 skip
  RF_LIST= RF_N=0
  for f in "$1"/[0-9]*; do
    [ -f "$f" ] || continue
    x=${f##*/}
    is_uint "$x" && [ ${#x} -le 9 ] && [ $((10#$x)) -ge 1 ] || continue
    l="$l $x"
    RF_N=$((RF_N + 1))
  done
  while [ -n "$l" ]; do # selection sort by number: an item has few records
    r=
    for y in $l; do [ -z "$r" ] || [ $((10#$y)) -lt $((10#$r)) ] && r=$y; done
    RF_LIST="$RF_LIST${RF_LIST:+ }$r"
    n2= skip=1
    for y in $l; do
      if [ -n "$skip" ] && [ "$y" = "$r" ]; then skip=; else n2="$n2 $y"; fi
    done
    l=$n2
  done
}

# The item table of a task: one line per item, fields separated by US:
# id status assignee title paths claimed_epoch creator note result paths_hint
# review done_reviews reviewing rv_n rv_verdict rv_reviewer — the last three: the
# number of verdict records, the verdict and the reviewer of the newest one. Input:
# the item files, then their records (only the newest is read, at the end); a path
# in a .reviews directory that is not a record is skipped (never an item).
AWK_ITEMS='
function hdrs(f,   l, k, v) {
  split("", h)
  while ((getline l < f) > 0) {
    if (l == "") break
    k = l; sub(/:.*$/, "", k); v = l; sub(/^[^:]*:[ \t]*/, "", v); h[k] = v
  }
  close(f)
}
{
  f = $0
  if (f ~ /\.reviews\/[^\/]*$/) {
    b = f; sub(/^.*\//, "", b)
    if (b !~ /^[0-9]+$/ || length(b) > 9 || b + 0 < 1) next
    id = f; sub(/\.reviews\/[^\/]*$/, "", id); sub(/^.*\//, "", id)
    cnt[id]++
    if (b + 0 > mx[id] + 0) { mx[id] = b + 0; nm[id] = b }
    next
  }
  hdrs(f)
  id = f; sub(/^.*\//, "", id)
  ids[++ni] = id; path[id] = f
  row[id] = id US h["Status"] US h["Assignee"] US h["Title"] US h["Paths"] US h["Claimed-Epoch"] US h["Creator"] US h["Note"] US h["Result"] US h["Paths-Hint"] US h["Review"] US h["Done-Reviews"] US h["Reviewing"]
}
END {
  for (i = 1; i <= ni; i++) {
    id = ids[i]; v = ""; r = ""
    if (nm[id] != "") { hdrs(path[id] ".reviews/" nm[id]); v = h["Verdict"]; r = h["Reviewer"] }
    print row[id] US (cnt[id] + 0) US v US r
  }
}'
item_table() { # DIR → IT_TABLE
  local f x l=
  IT_TABLE=
  item_files "$1"
  [ ${#ITEM_FILES[@]} -gt 0 ] || return 0
  for f in "$1"/items/I[0-9]*.reviews/[0-9]*; do
    [ -f "$f" ] || continue
    x=${f##*/}
    is_uint "$x" && [ ${#x} -le 9 ] && [ $((10#$x)) -ge 1 ] || continue # records only
    l=$l$f$NL
  done
  IT_TABLE=$({
    printf '%s\n' "${ITEM_FILES[@]}"
    printf '%s' "$l"
  } | awk -v US="$US" "$AWK_ITEMS")
}
# review_info DIR ITEM → RI_N (verdict records), RI_NUM (the number of the newest;
# 0 if none), RI_V / RI_R (its verdict and reviewer) — as in the item table
review_info() {
  local l nm
  RI_N=0 RI_NUM=0 RI_V= RI_R=
  review_files "$1/items/$2.reviews"
  RI_N=$RF_N
  [ "$RF_N" -gt 0 ] || return 0
  nm=${RF_LIST##* }
  RI_NUM=$((10#$nm))
  while IFS= read -r l || [ -n "$l" ]; do
    case $l in
      '') break ;;
      'Verdict: '*) RI_V=${l#Verdict: } ;;
      'Reviewer: '*) RI_R=${l#Reviewer: } ;;
    esac
  done <"$1/items/$2.reviews/$nm"
}
# item_stage_v VAR STATUS REVIEW DONE_REVIEWS N VERDICT REVIEWING — the stage of an
# item (DESIGN §7.1.1), one rule for wait, item list|show, status, task close (and,
# in JS, the board): todo | work | fix | review | accepted | cancelled (an unknown
# status as is). REVIEW — its Review header ("no" exactly: no review needed),
# DONE_REVIEWS — the verdicts when it was handed in (none: 0), N — the verdicts now,
# VERDICT — of the newest one, REVIEWING — who is reviewing it now. IS_NOTE: work →
# "rework" (the newest verdict is changes); review → "again" (handed in again after
# changes), "after" (handed in after an ok: the work may have changed — reviewed in
# work, an accepted item redone); accepted → "noreview" (Review: no, or the verdict
# skip — a decision, not a review: always accepted).
item_stage_v() {
  local _is_s=$2 _is_d=$4 _is_n=$5
  IS_NOTE=
  is_uint "$_is_d" || _is_d=0
  is_uint "$_is_n" || _is_n=0
  case $2 in
    claimed)
      _is_s=work
      [ "$6" = changes ] && IS_NOTE=rework
      ;;
    done)
      if [ "$_is_n" -gt 0 ]; then
        case $6 in
          skip) _is_s=accepted IS_NOTE=noreview ;;
          changes) # after it was handed in: changes to make; before: handed in again
            if [ "$_is_n" -gt "$_is_d" ]; then _is_s=fix; else _is_s=review IS_NOTE=again; fi
            ;;
          *) # ok, or anything unexpected: after it was handed in — accepted; before —
            # the work handed in since has not been reviewed
            if [ "$_is_n" -gt "$_is_d" ]; then _is_s=accepted; else _is_s=review IS_NOTE=after; fi
            ;;
        esac
      elif [ "$3" = no ]; then
        _is_s=accepted IS_NOTE=noreview
      else
        _is_s=review
      fi
      # somebody is reviewing it: the review goes on ("changed our minds")
      if [ "$_is_s" = accepted ] && [ -n "$7" ]; then _is_s=review IS_NOTE=; fi
      ;;
  esac
  eval "$1=\$_is_s"
}
stage_name_v() { # VAR STAGE — for people: "в работе", "на проверке", …
  local _sn_s=$2
  case $2 in
    work) _sn_s="в работе" ;;
    fix) _sn_s="правки" ;;
    review) _sn_s="на проверке" ;;
    accepted) _sn_s="готово" ;;
    cancelled) _sn_s="отменено" ;;
  esac
  eval "$1=\$_sn_s"
}
# stage_desc_v VAR STAGE REVIEWING REVIEWER — after item_stage_v (IS_NOTE), for
# people: "в работе · правки по ревью от X", "на проверке (проверяет claude-2)",
# "правки по ревью от X", "готово · без проверки", … (REVIEWER — of the newest verdict)
stage_desc_v() {
  local _sd_s _sd_w
  stage_name_v _sd_s "$2"
  case $2 in
    work) [ "$IS_NOTE" = rework ] && _sd_s="$_sd_s · правки по ревью от ${4:-?}" ;;
    fix) _sd_s="правки по ревью от ${4:-?}" ;;
    review)
      _sd_w="проверяет"
      case $3 in *,*) _sd_w="проверяют" ;; esac
      if [ -n "$3" ]; then _sd_w="$_sd_w ${3//,/, }"; else _sd_w="ждёт проверяющего"; fi
      [ "$IS_NOTE" = again ] && _sd_w="пересдана, $_sd_w"
      [ "$IS_NOTE" = after ] && _sd_w="сдана после ревью, $_sd_w"
      _sd_s="$_sd_s ($_sd_w)"
      ;;
    accepted) [ "$IS_NOTE" = noreview ] && _sd_s="$_sd_s · без проверки" ;;
  esac
  eval "$1=\$_sd_s"
}
# item_stage_now_v VAR — the stage of the loaded item (IT_* as written, its review
# records) for people; IS_STAGE — the stage, IS_NOTE, RI_* — as set on the way
item_stage_now_v() {
  local _sn_t
  review_info "$ACT_DIR" "$IT_ID"
  item_stage_v IS_STAGE "$IT_STATUS" "$IT_REVIEW" "$IT_DONE_REVIEWS" "$RI_N" "$RI_V" "$IT_REVIEWING"
  stage_desc_v _sn_t "$IS_STAGE" "$IT_REVIEWING" "$RI_R"
  eval "$1=\$_sn_t"
}
# list_drop_v VAR LIST NAME — a ","-list without NAME
list_drop_v() {
  local _ld_x=",$2,"
  _ld_x=${_ld_x//",$3,"/,}
  _ld_x=${_ld_x#,}
  _ld_x=${_ld_x%,}
  eval "$1=\$_ld_x"
}
# list_cap_v VAR LIST N [SEP] — a LIST of entries separated by SEP (default ", ")
# cut to N entries, joined by ", ": "a, b, … +3"
list_cap_v() {
  local _lc_r= _lc_n=0 _lc_x _lc_rest=$2 _lc_s=${4:-, }
  while [ -n "$_lc_rest" ]; do
    case $_lc_rest in
      *"$_lc_s"*) _lc_x=${_lc_rest%%"$_lc_s"*} _lc_rest=${_lc_rest#*"$_lc_s"} ;;
      *) _lc_x=$_lc_rest _lc_rest= ;;
    esac
    _lc_n=$((_lc_n + 1))
    [ "$_lc_n" -le "$3" ] && _lc_r="$_lc_r${_lc_r:+, }$_lc_x"
  done
  [ "$_lc_n" -gt "$3" ] && _lc_r="$_lc_r … +$((_lc_n - $3))"
  eval "$1=\$_lc_r"
}
# task_digest_v VAR — one line about the active task (ACT_*), parts without content
# left out: "T001: todo 2 · в работе I001 codex-1 · на проверке I003 (claude-2), I005 ·
# правки I004 codex-1 · готово I002 · прогонов идёт 1" (stages — DESIGN §7.1.1;
# "(names)" — who is reviewing) — shown by wait on a timeout, so the lead sees the
# state without polling who / item list.
task_digest_v() {
  local _dg_id _dg_st _dg_as _dg_ti _dg_pa _dg_ce _dg_cr _dg_no _dg_re _dg_hi _dg_rv _dg_dr _dg_ri _dg_rn _dg_v _dg_r
  local _dg_s _dg_t=0 _dg_w= _dg_c= _dg_x= _dg_d= _dg_n=0 _dg_f _dg_l _dg_o=
  item_table "$ACT_DIR"
  while IFS=$US read -r _dg_id _dg_st _dg_as _dg_ti _dg_pa _dg_ce _dg_cr _dg_no _dg_re _dg_hi _dg_rv _dg_dr _dg_ri _dg_rn _dg_v _dg_r; do
    [ -n "$_dg_id" ] || continue
    item_stage_v _dg_s "$_dg_st" "$_dg_rv" "$_dg_dr" "$_dg_rn" "$_dg_v" "$_dg_ri"
    case $_dg_s in
      todo) _dg_t=$((_dg_t + 1)) ;;
      work) _dg_w="$_dg_w$US$_dg_id ${_dg_as:-?}" ;;
      review) _dg_c="$_dg_c$US$_dg_id${_dg_ri:+ (${_dg_ri//,/, })}" ;;
      fix) _dg_x="$_dg_x$US$_dg_id ${_dg_as:-?}" ;;
      accepted) _dg_d="$_dg_d$US$_dg_id" ;;
    esac
  done <<BRG_DG_EOF
$IT_TABLE
BRG_DG_EOF
  for _dg_f in "$ACT_DIR"/shared/runs/R[0-9]*; do
    [ -f "$_dg_f" ] || continue
    case ${_dg_f##*/} in *.*) continue ;; esac
    _dg_s=
    while IFS= read -r _dg_l; do
      case $_dg_l in
        '') break ;;
        'Status: '*)
          _dg_s=${_dg_l#Status: }
          break
          ;;
      esac
    done <"$_dg_f"
    case $_dg_s in queued | running) _dg_n=$((_dg_n + 1)) ;; esac
  done
  [ "$_dg_t" -gt 0 ] && _dg_o="todo $_dg_t"
  list_cap_v _dg_w "${_dg_w#"$US"}" 6 "$US"
  list_cap_v _dg_c "${_dg_c#"$US"}" 8 "$US"
  list_cap_v _dg_x "${_dg_x#"$US"}" 6 "$US"
  list_cap_v _dg_d "${_dg_d#"$US"}" 8 "$US"
  [ -n "$_dg_w" ] && _dg_o="$_dg_o${_dg_o:+ · }в работе $_dg_w"
  [ -n "$_dg_c" ] && _dg_o="$_dg_o${_dg_o:+ · }на проверке $_dg_c"
  [ -n "$_dg_x" ] && _dg_o="$_dg_o${_dg_o:+ · }правки $_dg_x"
  [ -n "$_dg_d" ] && _dg_o="$_dg_o${_dg_o:+ · }готово $_dg_d"
  [ "$_dg_n" -gt 0 ] && _dg_o="$_dg_o${_dg_o:+ · }прогонов идёт $_dg_n"
  eval "$1=\"\$ACT_ID: \${_dg_o:-подзадач пока нет}\""
}

# model_key_v VAR MODEL — comparable model name ("" if unknown)
model_key_v() {
  local _mk_m
  _mk_m=$(printf '%s' "$2" | tr 'A-Z' 'a-z')
  _mk_m=${_mk_m//[!a-z0-9]/}
  [ "$_mk_m" = unknown ] && _mk_m=
  eval "$1=\$_mk_m"
}

# item_begin — common start of the item subcommands that change state: agent,
# the task lock, the active task (TK_*, ACT_*).
item_begin() {
  need_root
  need_agent write
  case $ISUB in claim | reassign) stop_refuse "item $ISUB" ;; esac
  NEXT_ON_ERR="исправь команду и повтори (справка: $BRG item --help); закончив шаг — $BRG wait --as $ASN"
  get_now_iso
  lock_acquire task
  active_task && task_read "$ACT_DIR" ||
    die "нет активной задачи — подзадачи бывают только у неё" "Задачу создаёт агент, которому человек её дал: $BRG task new …"
  [ -d "$ACT_DIR/items" ] || mkdir -p "$ACT_DIR/items" "$ACT_DIR/reservations"
}
# item_load RAW → IT_FILE + IT_* of the item in the active task; dies if absent
item_load() {
  local id
  [ -n "$1" ] || usage_die "укажи подзадачу: item $ISUB I00N …"
  item_norm_id_v id "$1" || usage_die "номер подзадачи вида I001: $1"
  IT_FILE=$ACT_DIR/items/$id
  item_read "$IT_FILE" || die "нет подзадачи $id в задаче $ACT_ID" "Все подзадачи: $BRG item list"
  IT_ID=$id
}
# item_say TO WAKE — system message about an item in the task channel (body in BODY);
# WAKE: "" (wakes every addressee) or names to wake (the others get it quietly)
item_say() {
  case $2 in
    -) MSG_EXTRA= ;;
    no) MSG_EXTRA=$QUIET ;;
    *) wake_extra_v MSG_EXTRA "$2" ;;
  esac
  msg_write "$ACT_ID" "$AGENT" "$1" system ""
  MSG_EXTRA=
}

# item_opts ALLOWED "$@" — options of an item subcommand → IO_*; ALLOWED lists the
# options it takes (without "--"); "id" — a positional item id.
item_opts() {
  local allowed=" $1 as " o
  shift
  IO_ID= IO_TITLE= IO_FILE= IO_PATHS= IO_TO= IO_RESULT= IO_NOTE= IO_VERDICT= IO_MINE= IO_STATUS= IO_TEXT=
  IO_NOREVIEW= IO_START=
  while [ $# -gt 0 ]; do
    case $1 in
      -h | --help)
        usage_print item
        exit 0
        ;;
      --mine | --no-review | --start) # flags without a value
        o=${1#--}
        case $allowed in *" $o "*) ;; *) usage_die "item $ISUB не принимает $1" ;; esac
        case $o in
          mine) IO_MINE=1 ;;
          no-review) IO_NOREVIEW=1 ;;
          start) IO_START=1 ;;
        esac
        shift
        ;;
      --*)
        o=${1#--}
        case $allowed in *" $o "*) ;; *) usage_die "неизвестный параметр для item $ISUB: $1" ;; esac
        need_val "$@"
        case $o in
          as) OPT_AS=$2 ;;
          title) IO_TITLE=$2 ;;
          file) IO_FILE=$2 ;;
          paths) IO_PATHS=$2 ;;
          to) IO_TO=$2 ;;
          result) IO_RESULT=$2 ;;
          note) IO_NOTE=$2 ;;
          verdict) IO_VERDICT=$2 ;;
          status) IO_STATUS=$2 ;;
          desc | comment) IO_TEXT=$2 ;;
        esac
        shift 2
        ;;
      *)
        case $allowed in *" id "*) ;; *) usage_die "лишний аргумент: $1" ;; esac
        [ -z "$IO_ID" ] || usage_die "лишний аргумент: $1"
        IO_ID=$1
        shift
        ;;
    esac
  done
}

ISUB=
cmd_item() {
  ISUB=${1:-}
  [ $# -gt 0 ] && shift
  NEXT_ON_ERR="исправь команду и повтори (справка: $BRG item --help); закончив шаг — $BRG wait --as $AS_HINT"
  case $ISUB in
    add | claim | done | release | reassign | review | cancel | list | show) "item_$ISUB" "$@" ;;
    -h | --help | help)
      usage_print item
      exit 0
      ;;
    '') usage_die "нужна подкоманда: add | claim | done | release | reassign | review | cancel | list | show" ;;
    *) usage_die "неизвестная подкоманда: item $ISUB" ;;
  esac
}

# item_body WHAT — the text of item add/review: --desc/--comment (stdin is not read
# then; for one-liners and PowerShell, where there is no heredoc), --file or stdin → BODY
item_body() {
  if [ -n "$IO_TEXT" ]; then
    [ -z "$IO_FILE" ] || usage_die "$1 и --file вместе нельзя — текст передай чем-то одним"
    BODY=${IO_TEXT//"$CR"/}
    BODY=${BODY#$'\xef\xbb\xbf'}
    # an option is lenient (cut, with a warning); stdin/--file keep the hard limit
    fit_v BODY "$BODY" $((MSG_MAX - 1)) "$1" "Полный текст положи файлом в shared/ задачи и дай в $1 путь и суть."
    body_check
  else
    read_body "$IO_FILE"
  fi
}

# item_opt_body WHAT — an optional text (the comment of verdict skip, item cancel)
# → BODY ("" if none): --comment / --file; stdin only if it is a regular file — a
# heredoc in bash 3.2 or < file — read at once; a pipe or a terminal is not read
# at all: nothing to wait for (a heredoc is a pipe in bash ≥ 5.1 — the docs say
# --comment or --file)
item_opt_body() {
  BODY=
  if [ -n "$IO_TEXT$IO_FILE" ]; then
    item_body "$1"
  elif [ ! -t 0 ] && [ -f /dev/stdin ]; then
    read_body "" opt
  fi
}

item_add() {
  local title id gist w hint= hshown= norev=
  item_opts "title file desc paths no-review" "$@"
  [ -z "$IO_ID" ] || usage_die "лишний аргумент: $IO_ID"
  one_line_v title "$IO_TITLE" 100000
  [ -n "$title" ] || usage_die "нужен --title \"…\": коротко, что сделать (одна строка)"
  fit_v title "$title" 200 "--title" "Подробности — в описании."
  # --paths: the proposed paths (header Paths-Hint), checked like claim's; claim
  # without --paths takes them
  if [ -n "$IO_PATHS" ]; then
    paths_parse "$IO_PATHS"
    hint=$PP_LIST
    paths_show_v hshown "$hint"
  fi
  need_root
  need_agent write
  stop_refuse "item add"
  NEXT_ON_ERR="исправь команду и повтори: $BRG item add --as $ASN --title \"…\" --desc \"что сделать, критерий готовности\" [--paths \"предлагаемые пути\"] [--no-review] (длинное — heredoc <<'BRG_EOF' или --file); закончив шаг — $BRG wait --as $ASN"
  item_body --desc
  IT_BODY=$BODY
  item_begin
  item_next_id_v id "$ACT_DIR"
  [ -n "$IO_NOREVIEW" ] && norev=no
  IT_ID=$id IT_TITLE=$title IT_STATUS=todo IT_CREATOR=$AGENT IT_ASSIGNEE= IT_PATHS= IT_HINT=$hint IT_CREATED=$ISO
  IT_CLAIMED= IT_CLAIMED_EPOCH= IT_DONE= IT_RESULT= IT_NOTE= IT_EXTRA= IT_REVIEW=$norev IT_DONE_REVIEWS= IT_REVIEWING=
  IT_CANCELLED= IT_CANCELLED_BY=
  item_write "$ACT_DIR/items/$id"
  first_line_v gist "$IT_BODY" 200
  if [ -n "$hint" ]; then
    BODY="$AGENT добавил подзадачу $id «$title»: $gist${NL}Предлагаемые пути: $hshown${NL}Подробно: $BRG item show $id · взять: $BRG item claim $id --as <имя> (возьмёт предлагаемые пути; свои — --paths …)"
  else
    BODY="$AGENT добавил подзадачу $id «$title»: $gist${NL}Подробно: $BRG item show $id · взять: $BRG item claim $id --as <имя> --paths <пути|none>"
  fi
  if [ -n "$norev" ]; then
    BODY="$BODY${NL}Стадия: todo; проверка не нужна (решение бригады, --no-review) — после item done сразу «готово · без проверки»."
  else
    BODY="$BODY${NL}Стадия: todo."
  fi
  # news for the lead (wakes it); the others see it with their next batch
  item_say all "$TK_LEAD"
  lock_release task
  touch_seen
  metric item.add task="$ACT_ID" id="$id" hint="${hint// /_}" review="${norev:-yes}"
  echo "── добавлена подзадача $id «$title» ($ACT_ID, todo)."
  if [ -n "$hint" ]; then
    echo "Предлагаемые пути: $hshown. Взять в работу: $BRG item claim $id --as <имя> — возьмёт их (другие — --paths \"…\")."
  else
    echo "Взять в работу: $BRG item claim $id --as <имя> --paths \"<файлы и каталоги через запятую>\" (только чтение — --paths none)."
  fi
  if [ -n "$norev" ]; then
    echo "Проверка не нужна (--no-review): после item done подзадача сразу «готово · без проверки»."
  else
    echo "После item done — «на проверке», «готово» — после ревью ok (проверка другим участником — рекомендация; решили не проверять — item done --no-review или item review --verdict skip)."
  fi
  if [ "$TK_LEAD" != "$AGENT" ]; then
    echo "Lead $TK_LEAD получил уведомление (будящее); остальные увидят его вместе со следующими сообщениями."
  else
    echo "Уведомление тихое: участники увидят его вместе со следующими сообщениями. Раздав подзадачи, напиши им одно сообщение."
  fi
  fit_warn_print
  echo "── NEXT: продолжай; закончив шаг — $BRG wait --as $ASN"
}

# item_last_v VAR — "последний вердикт: ok от X" of the loaded item (after
# review_info), "вердиктов нет" if none
item_last_v() {
  local _il_s="вердиктов нет"
  [ "$RI_NUM" -gt 0 ] && _il_s="последний вердикт: #$RI_NUM ${RI_V:-?} от ${RI_R:-?}"
  eval "$1=\$_il_s"
}

item_claim() {
  local renew= back= fix= prev= old shown x was= last hinted= nopaths="нужен --paths: файлы и каталоги, которые будешь менять (через запятую, от корня проекта); без правок файлов — --paths none"
  item_opts "id paths" "$@"
  [ -z "$IO_PATHS" ] || paths_parse "$IO_PATHS"
  item_begin
  item_load "$IO_ID"
  case $IT_STATUS in
    todo) ;;
    claimed)
      [ "$IT_ASSIGNEE" = "$AGENT" ] || die "$IT_ID уже в работе у $IT_ASSIGNEE (с $IT_CLAIMED)" \
        "Свободные подзадачи: $BRG item list --status todo"
      renew=1
      ;;
    done)
      # back to work (DESIGN §7.1.1): changes after a review, redoing an accepted or
      # unreviewed one, taking it off review — only by its assignee
      item_stage_now_v was
      item_last_v last
      [ "$IT_ASSIGNEE" = "$AGENT" ] || die "$IT_ID — сдана ($IT_ASSIGNEE), стадия: $was; $last. Вернуть её в работу может только исполнитель $IT_ASSIGNEE" \
        "Договорись с ним ($BRG send --as $ASN --to $IT_ASSIGNEE) или с lead; исполнитель asleep/gone — lead может передать правки: $BRG item reassign $IT_ID --to <имя> --as <lead>; свободные подзадачи: $BRG item list --status todo"
      back=1
      [ "$IS_STAGE" = fix ] && fix=1
      ;;
    cancelled) die "$IT_ID отменена${IT_CANCELLED_BY:+ ($IT_CANCELLED_BY)}: из cancelled пути назад нет" "Нужна снова — добавь новую подзадачу: $BRG item add --as $ASN --title \"…\"" ;;
    *) die "$IT_ID — $IT_STATUS: брать нечего" "Свободные подзадачи: $BRG item list --status todo" ;;
  esac
  # without --paths: back to work — its previous paths; otherwise the proposed paths
  # of the item (item add --paths), if any; an explicit --paths always wins
  if [ -z "$IO_PATHS" ]; then
    [ -z "$renew" ] || usage_die "$nopaths — повторный claim меняет пути $IT_ID, укажи полный список (сейчас: ${IT_PATHS:-none})"
    if [ -n "$back" ] && [ -n "$IT_PATHS" ]; then
      paths_parse "$IT_PATHS"
      prev=1
    else
      [ -n "$IT_HINT" ] || usage_die "$nopaths (у $IT_ID нет предлагаемых путей)"
      paths_parse "$IT_HINT"
      hinted=1
    fi
  fi
  res_conflicts "$ACT_DIR" "$PP_LIST" "$AGENT" "$IT_ID"
  if [ -n "$RC_LINES" ]; then
    if [ -n "$renew" ]; then
      x="оставлена с прежними путями"
    elif [ -n "$back" ]; then
      x="не возвращена в работу"
    else
      x="не взята"
    fi
    [ -n "$hinted" ] && x="$x (предлагаемые пути заняты — укажи свои: --paths …)"
    [ -n "$prev" ] && x="$x (прежние пути заняты — укажи свои: --paths …)"
    die "пути пересекаются с чужими резервированиями — $IT_ID $x" \
      "Конфликты (твой путь ↔ занятый):" "$RC_LINES" \
      "Что делать: сузь --paths, возьми другую подзадачу или договорись с держателем ($BRG send --as $ASN --to <имя>) или с lead; держатель asleep/gone — lead может $BRG item reassign."
  fi
  paths_show_v old "${IT_PATHS:-none}"
  res_write "$ACT_DIR" "$IT_ID" "$AGENT" "$PP_LIST"
  # overlaps with my own other items: not a refusal, but a warning (DESIGN §7.1) —
  # a second session under my name shows up here
  res_own "$ACT_DIR" "$PP_LIST" "$AGENT" "$IT_ID"
  IT_STATUS=claimed IT_ASSIGNEE=$AGENT IT_PATHS=$PP_LIST
  if [ -z "$renew" ]; then
    IT_CLAIMED=$ISO
    IT_CLAIMED_EPOCH=$NOW
  fi
  # handed in again by item done: a new Done, Done-Reviews, note, result; a new
  # round of review
  [ -n "$back" ] && IT_DONE= IT_DONE_REVIEWS= IT_NOTE= IT_RESULT= IT_REVIEWING=
  item_write "$IT_FILE"
  paths_show_v shown "$PP_LIST"
  if [ -n "$renew" ]; then
    BODY="$AGENT сменил пути подзадачи $IT_ID «$IT_TITLE»: $shown"
  elif [ -n "$fix" ]; then
    BODY="$AGENT вернул $IT_ID «$IT_TITLE» в работу — правки по ревью #$RI_NUM · пути: $shown${NL}Стадия: в работе."
  elif [ -n "$back" ]; then
    BODY="$AGENT вернул $IT_ID «$IT_TITLE» в работу (была: $was) · пути: $shown${NL}Стадия: в работе."
  else
    BODY="$AGENT взял $IT_ID «$IT_TITLE» · пути: $shown${NL}Стадия: в работе."
  fi
  if [ -n "$back" ]; then
    item_say all "$TK_LEAD" # handed-in work is back: the lead should know
  else
    item_say all no # informational: who edits what
  fi
  lock_release task
  touch_seen
  metric item.claim task="$ACT_ID" id="$IT_ID" paths="${PP_LIST// /_}" renew="${renew:-0}" hint="${hinted:-0}" own="${RO_IDS//, /,}" back="${back:-0}" fix="${fix:-0}"
  x="Резервирование: $shown"
  [ -n "$prev" ] && x="Резервирование — прежние пути: $shown (нужны другие — повтори claim с --paths)"
  if [ -n "$renew" ]; then
    echo "── пути $IT_ID обновлены: $shown (были: $old)."
  elif [ -n "$fix" ]; then
    echo "── $IT_ID «$IT_TITLE» снова в работе — правки по ревью #$RI_NUM от $RI_R (замечания: $BRG item show $IT_ID). $x."
  elif [ -n "$back" ]; then
    echo "── $IT_ID «$IT_TITLE» снова в работе (была: $was). $x."
    # skip is a decision, not a review: handed in again, the item is accepted at once
    if [ "$RI_V" = skip ]; then
      echo "Последний вердикт — skip (#$RI_NUM от $RI_R): после item done подзадача сразу станет «готово · без проверки»; нужна проверка — пусть проверяющий отметится: item review $IT_ID --as <имя> --start."
    fi
  elif [ -n "$hinted" ]; then
    echo "── $IT_ID «$IT_TITLE» — твоя. Взяты предлагаемые пути: $shown (нужны другие — повтори claim с --paths)."
    echo "Стадия: в работе."
  else
    echo "── $IT_ID «$IT_TITLE» — твоя. Резервирование: $shown."
    echo "Стадия: в работе."
  fi
  if [ -n "$RO_LINES" ]; then
    x="lead'у ($BRG send --as $ASN --to $TK_LEAD) и человеку (в своём чате)"
    [ "$TK_LEAD" = "$AGENT" ] && x="человеку (в своём чате)"
    printf '%s\n' "⚠ эти пути уже твои по $RO_IDS (твой путь ↔ твоё резервирование):" "$RO_LINES" \
      "Если $RO_IDS брал не ты — под твоим именем работает другая сессия: сообщи $x."
  fi
  [ -n "$renew" ] || echo "Работу выполняет твой подагент — поручи ему: $IT_ID и описание ($BRG item show $IT_ID), пути, критерий готовности, правила для подагента из README («Подагенты») и твоё полное имя $ASN. Сам вернись в wait; подагент закончит — прими результат (его отчёт, git diff --stat) и сдай."
  [ "$PP_LIST" = none ] || echo "Правки — только в этих путях; нужен ещё путь — повтори claim с полным списком. Тесты и сборка — через $BRG run --as $ASN --item $IT_ID -- <команда>."
  echo "Готово — $BRG item done $IT_ID --as $ASN --note \"что сделано, как проверено\"; бросаешь — item release; не нужна — item cancel."
  if [ -n "$renew" ]; then
    echo "── NEXT: продолжай; закончив шаг — $BRG wait --as $ASN"
  else
    echo "── NEXT: поручи $IT_ID подагенту, затем $BRG wait --as $ASN"
  fi
}

# review_write VERDICT BODY ASSIGNEE_MODEL — a verdict record of the loaded item
# (IT_*) by AGENT, immutable → RW_N (its number)
review_write() {
  local x t
  RW_N=0
  mkdir -p "$IT_FILE.reviews" 2>/dev/null
  review_files "$IT_FILE.reviews"
  [ "$RF_N" -gt 0 ] && x=${RF_LIST##* } && RW_N=$((10#$x))
  RW_N=$((RW_N + 1))
  t=$IT_FILE.reviews/.tmp.$$
  if ! printf 'Item: %s\nReviewer: %s\nModel: %s\nVerdict: %s\nAssignee: %s\nAssignee-Model: %s\nStatus: %s\nTime: %s\nEpoch: %s\n\n%s\n' \
    "$IT_ID" "$AGENT" "$A_MODEL" "$1" "$IT_ASSIGNEE" "$3" "$IT_STATUS" "$ISO" "$NOW" "$2" >"$t" ||
    ! mv_retry "$t" "$IT_FILE.reviews/$RW_N"; then
    rm -f "$t"
    die "не удалось записать ревью $IT_FILE.reviews/$RW_N"
  fi
}

item_done() {
  local res= note shown x st resub= pnum
  item_opts "id result note no-review" "$@"
  if [ -n "$IO_RESULT" ]; then
    path_norm_v res "$IO_RESULT" || usage_die "--result: «$IO_RESULT» — $PN_ERR"
    [ -e "$PROJ/$res" ] || usage_die "--result: нет файла $res (путь от корня проекта)" \
      "Подробный итог положи в файл (например, $RROOT/tasks/<задача>/shared/…) и дай путь."
  fi
  one_line_v note "$IO_NOTE" 100000
  fit_v note "$note" 500 "--note" "--note — одна-две фразы; подробности — файлом (например, в shared/ задачи) и --result <путь>."
  item_begin
  item_load "$IO_ID"
  if [ "$IT_STATUS" = done ] && [ "$IT_ASSIGNEE" = "$AGENT" ]; then
    item_stage_now_v x
    [ "$IS_STAGE" = fix ] && die "$IT_ID ждёт правок по ревью #$RI_NUM от $RI_R — сначала верни её в работу: $BRG item claim $IT_ID --as $ASN (прежние пути), затем правки и item done" \
      "Замечания: $BRG item show $IT_ID"
  fi
  [ "$IT_STATUS" = claimed ] || die "$IT_ID — $IT_STATUS, а не в работе (claimed)"
  [ "$IT_ASSIGNEE" = "$AGENT" ] || die "завершить $IT_ID может только исполнитель ($IT_ASSIGNEE)" \
    "Если $IT_ASSIGNEE asleep/gone, lead может переназначить: $BRG item reassign $IT_ID --to <имя> --as <lead>"
  review_info "$ACT_DIR" "$IT_ID"
  [ "$RI_V" = changes ] && resub=1
  pnum=$RI_NUM
  paths_show_v shown "$IT_PATHS"
  res_remove "$ACT_DIR" "$IT_ID"
  # Done-Reviews: the verdicts before handing in (not the skip below)
  IT_STATUS=done IT_DONE=$ISO IT_DONE_REVIEWS=$RI_N IT_RESULT=$res IT_NOTE=$note
  # --no-review: handed in and the verdict skip at once — a verdict on a done item
  # ends the round of review
  [ -n "$IO_NOREVIEW" ] && IT_REVIEWING=
  item_write "$IT_FILE"
  [ -n "$IO_NOREVIEW" ] && review_write skip "при сдаче (item done --no-review)" "$A_MODEL"
  item_stage_now_v st
  if [ -n "$resub" ]; then
    BODY="$AGENT пересдал $IT_ID «$IT_TITLE» после правок по ревью #$pnum${note:+: $note}${res:+${NL}Результат: $res}"
  else
    BODY="$AGENT завершил $IT_ID «$IT_TITLE»${note:+: $note}${res:+${NL}Результат: $res}"
  fi
  [ -n "$IO_NOREVIEW" ] && BODY="$BODY${NL}Проверка не нужна (item done --no-review)."
  BODY="$BODY${NL}Стадия: $st."
  [ "$IS_STAGE" = review ] && [ -z "$IT_REVIEWING" ] && BODY="$BODY Взяться за проверку: $BRG item review $IT_ID --as <имя> --start, затем --verdict ok|changes."
  item_say all "$TK_LEAD" # wakes the lead (acceptance); the others see it later
  lock_release task
  touch_seen
  metric item.done task="$ACT_ID" id="$IT_ID" stage="$IS_STAGE" reviews="$IT_DONE_REVIEWS" no_review="${IO_NOREVIEW:-0}"
  echo "── $IT_ID «$IT_TITLE» — done. Резервирование снято (${shown})."
  case $IS_STAGE/$IS_NOTE in
    accepted/noreview)
      if [ -n "$IO_NOREVIEW" ]; then
        echo "Стадия: $st — записан вердикт skip #$RW_N (проверка не нужна)."
      elif [ "$RI_V" = skip ]; then
        echo "Стадия: $st — проверку отменили раньше (вердикт skip #$RI_NUM от $RI_R)."
      else
        echo "Стадия: $st (item add --no-review)."
      fi
      ;;
    review/after) echo "Стадия: $st — ревью #$RI_NUM ($RI_V от $RI_R) было до сдачи: нужна новая проверка (решили не проверять — item review $IT_ID --as $ASN --verdict skip)." ;;
    *) echo "Стадия: $st. «Готово» — после ревью ok; замечания придут тебе ревью (changes — вернёшь её в работу item claim и пересдашь); решили не проверять — item review $IT_ID --as $ASN --verdict skip." ;;
  esac
  [ "$TK_LEAD" != "$AGENT" ] && echo "Lead $TK_LEAD получил уведомление."
  [ -n "$note$res" ] || echo "Итог не указан: если не очевиден — коротко напиши lead'у, что сделано и как проверено."
  fit_warn_print
  echo "── NEXT: возьми следующую подзадачу ($BRG item list --status todo) или $BRG wait --as $ASN"
}

item_release() {
  local by= shown
  item_opts "id" "$@"
  item_begin
  item_load "$IO_ID"
  [ "$IT_STATUS" = claimed ] || die "$IT_ID — $IT_STATUS, а не в работе (claimed)"
  if [ "$IT_ASSIGNEE" != "$AGENT" ]; then
    [ "$TK_LEAD" = "$AGENT" ] || die "вернуть $IT_ID в todo может исполнитель ($IT_ASSIGNEE) или lead ($TK_LEAD), если исполнитель asleep/gone"
    ST=gone
    valid_name "$IT_ASSIGNEE" && [ -f "$ROOT/agents/$IT_ASSIGNEE" ] && agent_state "$IT_ASSIGNEE"
    case $ST in
      asleep | gone) by=" (lead; $IT_ASSIGNEE — $ST)" ;;
      *) die "исполнитель $IT_ASSIGNEE активен ($ST) — lead возвращает подзадачу, только если исполнитель asleep или gone" \
        "Договорись с ним: $BRG send --as $ASN --to $IT_ASSIGNEE" ;;
    esac
  fi
  paths_show_v shown "$IT_PATHS"
  res_remove "$ACT_DIR" "$IT_ID"
  BODY="$AGENT вернул $IT_ID «$IT_TITLE» в todo$by; резервирование снято ($shown)."
  # the work starts over: whoever was reviewing it has nothing to review
  IT_STATUS=todo IT_ASSIGNEE= IT_PATHS= IT_CLAIMED= IT_CLAIMED_EPOCH= IT_REVIEWING=
  item_write "$IT_FILE"
  item_say all "$TK_LEAD"
  lock_release task
  touch_seen
  metric item.release task="$ACT_ID" id="$IT_ID"
  echo "── $IT_ID «$IT_TITLE» снова todo, резервирование снято."
  echo "── NEXT: продолжай; закончив шаг — $BRG wait --as $ASN"
}

item_reassign() {
  local cur shown warn= fix= x st
  item_opts "id to" "$@"
  [ -n "$IO_TO" ] || usage_die "кому: item reassign I00N --to <имя> --as <lead>"
  case $IO_TO in ?*.*) IO_TO=${IO_TO%%.*} ;; esac # the key, if any, is dropped
  item_begin
  item_load "$IO_ID"
  [ "$TK_LEAD" = "$AGENT" ] || die "переназначать подзадачи может только lead ($TK_LEAD)" \
    "Если lead asleep/gone — возьми роль: $BRG lead take --as $ASN"
  # done, waiting for changes after a review (DESIGN §7.1.1): its assignee is the only
  # one to claim it back, so the lead may hand the changes over like an item in work
  if [ "$IT_STATUS" = done ]; then
    item_stage_now_v x
    [ "$IS_STAGE" = fix ] && fix=1
  fi
  [ "$IT_STATUS" = claimed ] || [ -n "$fix" ] ||
    die "$IT_ID — $IT_STATUS, а не в работе: исполнитель берёт её сам ($BRG item claim $IT_ID --as <имя> --paths …)"
  valid_name "$IO_TO" && [ -f "$ROOT/agents/$IO_TO" ] || die "нет такого агента: $IO_TO" "Кто подключён: $BRG who"
  cur=$IT_ASSIGNEE
  [ "$IO_TO" != "$cur" ] || die "$IT_ID и так у $cur"
  agent_state "$IO_TO"
  [ "$ST" != gone ] || die "$IO_TO — gone: передавать некому" "Кто онлайн: $BRG who"
  [ "$ST" = asleep ] && warn="Внимание: $IO_TO сейчас asleep — может не скоро взяться."
  ST=gone
  valid_name "$cur" && [ -f "$ROOT/agents/$cur" ] && agent_state "$cur"
  case $ST in
    asleep | gone) ;;
    *) die "исполнитель $cur активен ($ST) — переназначить можно, только если он asleep или gone" \
      "Договорись с ним: $BRG send --as $ASN --to $cur; отдать подзадачу он может сам: $BRG item release $IT_ID --as <его полное имя>" ;;
  esac
  res_conflicts "$ACT_DIR" "${IT_PATHS:-none}" "$IO_TO" "$IT_ID"
  if [ -n "$RC_LINES" ]; then
    die "пути $IT_ID пересекаются с чужими резервированиями — не переназначена" \
      "Конфликты (путь $IT_ID ↔ занятый):" "$RC_LINES" \
      "Что делать: выбери другого исполнителя или освободи пути ($BRG item release …)."
  fi
  res_write "$ACT_DIR" "$IT_ID" "$IO_TO" "${IT_PATHS:-none}"
  IT_ASSIGNEE=$IO_TO IT_CLAIMED=$ISO IT_CLAIMED_EPOCH=$NOW
  # the new assignee does not review its own work
  list_drop_v IT_REVIEWING "$IT_REVIEWING" "$IO_TO"
  # changes after a review: back to work under the new assignee (as item claim does)
  [ -n "$fix" ] && IT_STATUS=claimed IT_DONE= IT_DONE_REVIEWS= IT_NOTE= IT_RESULT= IT_REVIEWING=
  item_write "$IT_FILE"
  item_stage_now_v st
  paths_show_v shown "${IT_PATHS:-none}"
  x=
  [ -n "$fix" ] && x=" (правки по ревью #$RI_NUM)"
  BODY="lead $AGENT переназначил $IT_ID «$IT_TITLE»$x: $cur ($ST) → $IO_TO. Пути: $shown.${NL}$IO_TO: подзадача теперь твоя — $BRG item show $IT_ID; незавершённые правки $cur — в рабочем дереве.${NL}Стадия: $st."
  item_say all "$IO_TO"
  lock_release task
  touch_seen
  metric item.reassign task="$ACT_ID" id="$IT_ID" from="$cur" to="$IO_TO" fix="${fix:-0}"
  echo "── $IT_ID «$IT_TITLE»$x: $cur → $IO_TO; резервирование ($shown) перешло к $IO_TO. Ему отправлено будящее сообщение. Стадия: $st."
  [ -n "$warn" ] && echo "$warn"
  echo "── NEXT: продолжай; закончив шаг — $BRG wait --as $ASN"
}

# item_to_v VAR — the assignee and the lead of the loaded item, minus AGENT
# (comma list; "" if nobody else)
item_to_v() {
  local _it_t=
  [ -n "$IT_ASSIGNEE" ] && [ "$IT_ASSIGNEE" != "$AGENT" ] && _it_t=$IT_ASSIGNEE
  [ "$TK_LEAD" != "$AGENT" ] && [ "$TK_LEAD" != "$IT_ASSIGNEE" ] && _it_t="$_it_t${_it_t:+,}$TK_LEAD"
  eval "$1=\$_it_t"
}

item_review() {
  local v= mk ak x t others= to body= warn= amodel= shown again= st was
  item_opts "id verdict file comment start" "$@"
  if [ -n "$IO_START" ]; then
    [ -z "$IO_VERDICT$IO_TEXT$IO_FILE" ] ||
      usage_die "--start — только отметка «взялся проверять»: без --verdict, --comment и --file (вердикт — отдельной командой, когда проверка закончена)"
  else
    case $IO_VERDICT in
      ok | changes | skip) v=$IO_VERDICT ;;
      '') usage_die "нужен --verdict ok|changes|skip (или --start — взялся проверять)" ;;
      *) usage_die "--verdict — ok или changes (или skip — проверка не нужна): $IO_VERDICT" ;;
    esac
  fi
  need_root
  need_agent write
  if [ -n "$IO_START" ]; then
    # starts work (DESIGN §9); no text: stdin is not read at all
    stop_refuse "item review --start"
    NEXT_ON_ERR="исправь команду и повтори: $BRG item review I00N --as $ASN --start; закончив шаг — $BRG wait --as $ASN"
  else
    NEXT_ON_ERR="исправь команду и повтори: $BRG item review I00N --as $ASN --verdict ok|changes|skip --comment \"…\" (длинное — heredoc <<'BRG_EOF' или --file); закончив шаг — $BRG wait --as $ASN"
    # skip: the comment is optional — never waited for (see item_opt_body)
    if [ "$v" = skip ]; then
      item_opt_body --comment
    else
      item_body --comment
    fi
    body=$BODY
  fi
  item_begin
  item_load "$IO_ID"
  case $IT_STATUS in
    claimed | done) ;;
    *) die "$IT_ID — $IT_STATUS: ревьюить нечего (ревью — для подзадач в работе или сданных)" ;;
  esac
  if [ "$v" != skip ]; then # skip is a decision of the brigade, not a review: anybody
    [ "$IT_ASSIGNEE" != "$AGENT" ] || die "$IT_ID делал ты — своё ревью не засчитывается" \
      "Попроси ревью другого агента, лучше другой модели: $BRG send --as $ASN --to <имя>; проверка не нужна — $BRG item review $IT_ID --as $ASN --verdict skip --comment \"почему\""
    # same model as the assignee while another model is online: a warning, not a refusal
    profile_read "$ROOT/agents/$IT_ASSIGNEE"
    amodel=$P_MODEL
    model_key_v ak "$amodel"
    model_key_v mk "$A_MODEL"
    if [ -n "$mk" ] && [ "$mk" = "$ak" ]; then
      list_agents
      for x in $AGENT_NAMES; do
        [ "$x" = "$AGENT" ] || [ "$x" = "$IT_ASSIGNEE" ] && continue
        agent_state "$x"
        case $ST in waiting | working) ;; *) continue ;; esac
        model_key_v t "$P_MODEL"
        [ -n "$t" ] && [ "$t" != "$mk" ] && others="$others${others:+, }$x ($P_MODEL)"
      done
      [ -n "$others" ] && warn="Внимание: ты на той же модели ($A_MODEL), что и исполнитель $IT_ASSIGNEE, а онлайн есть агент другой модели: $others. Ревью другой моделью ловит больше ошибок — по возможности попроси его (PROTOCOL)."
    fi
  else
    profile_read "$ROOT/agents/$IT_ASSIGNEE" && amodel=$P_MODEL
  fi
  if [ -n "$IO_START" ]; then # "I am reviewing it" (DESIGN §7.1.1): the name into Reviewing
    case ",$IT_REVIEWING," in
      *",$AGENT,"*) again=1 ;;
      *)
        IT_REVIEWING=$IT_REVIEWING${IT_REVIEWING:+,}$AGENT
        item_write "$IT_FILE"
        item_stage_now_v st
        BODY="$AGENT взялся проверять $IT_ID «$IT_TITLE» (исполнитель $IT_ASSIGNEE)${NL}Стадия: $st."
        item_say all no # informational, like claim
        ;;
    esac
    lock_release task
    touch_seen
    metric item.review.start task="$ACT_ID" id="$IT_ID" again="${again:-0}" same_model="${warn:+1}"
    [ -n "$again" ] && item_stage_now_v st
    paths_show_v shown "${IT_PATHS:-none}"
    if [ -n "$again" ]; then
      echo "── ты уже проверяешь $IT_ID «$IT_TITLE» — отметка есть (проверяют: ${IT_REVIEWING//,/, }). Стадия: $st."
    else
      echo "── ты проверяешь $IT_ID «$IT_TITLE» (исполнитель $IT_ASSIGNEE, $IT_STATUS): бригада видит это в сводке wait и в item list. Стадия: $st."
    fi
    [ -n "$warn" ] && echo "$warn"
    echo "Проверку делает твой подагент — поручи ему: смотреть сам diff, а не отчёт исполнителя — git diff -- <пути> (новые файлы — git status --short -- <пути> и целиком); пути $IT_ID: $shown; что и с каким критерием сделать — $BRG item show $IT_ID; при необходимости тесты — $BRG run --as $ASN --sync -- <команда>; правила для подагента — README («Подагенты») и твоё полное имя $ASN."
    echo "Вердикт пишешь ты: $BRG item review $IT_ID --as $ASN --verdict ok|changes --comment \"что не так и где\"."
    echo "── NEXT: поручи проверку $IT_ID подагенту, затем $BRG wait --as $ASN"
    return 0
  fi
  item_stage_now_v was
  was=$IS_STAGE
  review_write "$v" "$body" "$amodel"
  # a verdict on a done item ends the round of review (who still reviews — --start
  # again); on an item in work it takes only its author out
  if [ "$IT_STATUS" = done ]; then
    x=
  else
    list_drop_v x "$IT_REVIEWING" "$AGENT"
  fi
  if [ "$x" != "$IT_REVIEWING" ]; then
    IT_REVIEWING=$x
    item_write "$IT_FILE"
  fi
  item_stage_now_v st
  item_to_v to
  trunc_v x "$body" $((MSG_MAX - 900))
  case $v in
    ok) t="ok — замечаний нет" ;;
    changes) t="changes — нужны правки" ;;
    skip) t="skip — проверка не нужна" ;;
  esac
  if [ "$v" = skip ]; then
    BODY="$AGENT: $IT_ID «$IT_TITLE» — $t"
  else
    BODY="ревью $IT_ID «$IT_TITLE» от $AGENT ($A_MODEL): $t"
  fi
  [ -n "$x" ] && BODY="$BODY$NL$x"
  [ ${#x} -lt ${#body} ] && BODY="$BODY${NL}(обрезано; целиком: $BRG item show $IT_ID)"
  case $v/$IT_STATUS/$was in
    changes/done/*)
      BODY="$BODY${NL}$IT_ASSIGNEE, как пересдать: $BRG item claim $IT_ID --as <имя> (вернёт в работу с прежними путями) → правки (силами подагента) → $BRG item done $IT_ID --as <имя> --note \"что исправлено\"."
      ;;
    changes/*) BODY="$BODY${NL}$IT_ASSIGNEE: подзадача ещё в работе — внеси правки (силами подагента) и сдай: $BRG item done $IT_ID --as <имя>." ;;
    ok/done/fix) BODY="$BODY${NL}$IT_ASSIGNEE: правки не нужны — $IT_ID готова." ;;
    skip/done/fix) BODY="$BODY${NL}$IT_ASSIGNEE: правки не нужны — $IT_ID готова, без проверки." ;;
    skip/claimed/*) BODY="$BODY${NL}После item done — сразу «готово · без проверки»." ;;
  esac
  BODY="$BODY${NL}Стадия: $st."
  if [ -n "$to" ]; then
    item_say "$to" -
  else
    item_say all no # the assignee and the lead wrote it themselves: for the record
  fi
  lock_release task
  touch_seen
  metric item.review task="$ACT_ID" id="$IT_ID" verdict="$v" n="$RW_N" same_model="${warn:+1}" stage="$IS_STAGE"
  if [ "$v" = skip ]; then
    echo "── решение #$RW_N по $IT_ID записано (skip — проверка не нужна)${to:+; сообщение отправлено: ${to//,/, }}."
  else
    echo "── ревью #$RW_N по $IT_ID записано ($v); сообщение отправлено: ${to//,/, }."
  fi
  case $IS_STAGE in
    fix) echo "Стадия $IT_ID: $st — исполнитель вернёт её в работу (item claim) и пересдаст." ;;
    *) echo "Стадия $IT_ID: $st." ;;
  esac
  [ -n "$warn" ] && echo "$warn"
  fit_warn_print
  echo "── NEXT: продолжай; закончив шаг — $BRG wait --as $ASN"
}

# item cancel: the item is not needed (DESIGN §7.1.1) — todo: anybody; claimed/done:
# the assignee or the lead. Not starting work: allowed while stopped.
item_cancel() {
  local body= to x shown
  item_opts "id comment file" "$@"
  need_root
  need_agent write
  NEXT_ON_ERR="исправь команду и повтори: $BRG item cancel I00N --as $ASN [--comment \"почему\"]; закончив шаг — $BRG wait --as $ASN"
  item_opt_body --comment # optional: never waited for
  body=$BODY
  item_begin
  item_load "$IO_ID"
  case $IT_STATUS in
    todo) ;;
    claimed | done)
      [ "$IT_ASSIGNEE" = "$AGENT" ] || [ "$TK_LEAD" = "$AGENT" ] ||
        die "отменить $IT_ID ($IT_STATUS) может исполнитель ($IT_ASSIGNEE) или lead ($TK_LEAD)" \
          "Предложи им: $BRG send --as $ASN --to $IT_ASSIGNEE"
      ;;
    cancelled) die "$IT_ID уже отменена${IT_CANCELLED_BY:+ ($IT_CANCELLED_BY${IT_CANCELLED:+, $IT_CANCELLED})}: из cancelled пути назад нет" "Нужна снова — добавь новую подзадачу: $BRG item add --as $ASN --title \"…\"" ;;
    *) die "$IT_ID — $IT_STATUS: отменять нечего" ;;
  esac
  x=$IT_STATUS
  paths_show_v shown "${IT_PATHS:-none}"
  res_remove "$ACT_DIR" "$IT_ID"
  IT_STATUS=cancelled IT_CANCELLED=$ISO IT_CANCELLED_BY=$AGENT IT_REVIEWING=
  item_write "$IT_FILE"
  trunc_v body "$body" $((MSG_MAX - 600))
  BODY="$AGENT отменил $IT_ID «$IT_TITLE» (была: $x)${body:+: $body}"
  [ "$x" = claimed ] && BODY="$BODY${NL}Резервирование снято ($shown); $IT_ASSIGNEE: прекрати правки по $IT_ID — незавершённое остаётся в рабочем дереве."
  BODY="$BODY${NL}Стадия: отменено (из cancelled пути назад нет; нужна снова — новая подзадача: item add)."
  item_to_v to
  item_say all "${to:-no}" # wakes the lead and the assignee
  lock_release task
  touch_seen
  metric item.cancel task="$ACT_ID" id="$IT_ID" from="$x"
  echo "── $IT_ID «$IT_TITLE» отменена (была: $x). Стадия: отменено."
  [ "$x" = claimed ] && echo "Резервирование снято ($shown)."
  [ -n "$to" ] && echo "Уведомлены: ${to//,/, }."
  fit_warn_print
  echo "── NEXT: продолжай; закончив шаг — $BRG wait --as $ASN"
}

item_list() {
  local id st as ti pa ce cr no re hi rv dr ri rn rvv rvr line shown age ok cnt=0 x rest s sd
  local ct=0 cw=0 cf=0 cr_=0 ca=0 cx=0
  item_opts "mine status" "$@"
  [ -z "$IO_ID" ] || usage_die "лишний аргумент: $IO_ID (одну подзадачу покажет item show)"
  need_root
  get_now
  if [ -n "${OPT_AS:-}" ] || [ -n "$IO_MINE" ]; then
    need_agent read
    touch_seen
  fi
  rest=${IO_STATUS//[[:space:]]/},
  while [ -n "$IO_STATUS" ] && [ -n "$rest" ]; do
    x=${rest%%,*}
    rest=${rest#*,}
    case $x in todo | claimed | done | cancelled | '') ;; *) usage_die "--status — todo, claimed, done, cancelled (через запятую): $IO_STATUS" ;; esac
  done
  active_task && task_read "$ACT_DIR" || die "нет активной задачи — подзадач нет" "Все задачи: $BRG task list"
  item_table "$ACT_DIR"
  while IFS=$US read -r id st as ti pa ce cr no re hi rv dr ri rn rvv rvr; do
    [ -n "$id" ] || continue
    item_stage_v s "$st" "$rv" "$dr" "$rn" "$rvv" "$ri"
    case $s in
      todo) ct=$((ct + 1)) ;;
      work) cw=$((cw + 1)) ;;
      fix) cf=$((cf + 1)) ;;
      review) cr_=$((cr_ + 1)) ;;
      accepted) ca=$((ca + 1)) ;;
      cancelled) cx=$((cx + 1)) ;;
    esac
    [ -z "$IO_STATUS" ] || case ",${IO_STATUS//[[:space:]]/}," in *",$st,"*) ;; *) continue ;; esac
    [ -z "$IO_MINE" ] || [ "$as" = "$AGENT" ] || continue
    stage_desc_v sd "$s" "$ri" "$rvr"
    line="$id · $st"
    case $st in
      todo)
        line="$line · «$ti» · создал $cr"
        if [ -n "$hi" ]; then
          paths_show_v shown "$hi"
          line="$line · предлагаемые пути: $shown"
        fi
        [ "$rv" = no ] && line="$line · без проверки"
        ;;
      claimed)
        paths_show_v shown "$pa"
        age=
        is_uint "$ce" && dur_v age $((NOW - ce))
        line="$line · $as · «$ti» · пути: $shown${age:+ · $age}"
        [ "$IS_NOTE" = rework ] && line="$line · правки по ревью от $rvr"
        [ -n "$ri" ] && line="$line · проверяет ${ri//,/, }"
        [ "$rv" = no ] && line="$line · без проверки"
        ;;
      done) line="$line · $sd · ${as:-—} · «$ti»${no:+ · итог: $no}${re:+ · $re}" ;;
      *) line="$line · ${as:-—} · «$ti»${no:+ · итог: $no}${re:+ · $re}" ;;
    esac
    is_uint "$rn" || rn=0
    if [ "$rn" -gt 0 ]; then
      if [ "$rvv" = skip ]; then
        line="$line · решение: без проверки (${rvr:-?})"
      else
        line="$line · ревью: ${rvv:-?} от ${rvr:-?}"
      fi
    fi
    [ "$rn" -gt 1 ] && line="$line (всего $rn)"
    echo "$line"
    cnt=$((cnt + 1))
  done <<BRG_IL_EOF
$IT_TABLE
BRG_IL_EOF
  [ "$cnt" -gt 0 ] || echo "── подзадач${IO_MINE:+ твоих}${IO_STATUS:+ со статусом $IO_STATUS} нет"
  echo "── $ACT_ID: todo $ct · в работе $cw · правки $cf · на проверке $cr_ · готово $ca · отменено $cx"
  metric item.list task="$ACT_ID"
  [ -n "$AGENT" ] && echo "── NEXT: продолжай; закончив шаг — $BRG wait --as $ASN"
  return 0
}

item_show() {
  local shown f line r age runs= x s
  item_opts "id" "$@"
  need_root
  get_now
  if [ -n "${OPT_AS:-}" ]; then
    need_agent read
    touch_seen
  fi
  active_task && task_read "$ACT_DIR" || die "нет активной задачи — подзадач нет" "Все задачи: $BRG task list"
  item_load "$IO_ID"
  echo "── $IT_ID «$IT_TITLE» · $IT_STATUS · задача $ACT_ID"
  # the stage (DESIGN §7.1.1)
  item_stage_now_v x
  s=$IS_STAGE
  case $s/$IS_NOTE in
    work/rework) x="в работе — правки по ревью #$RI_NUM от $RI_R" ;;
    review/again) x="на проверке — пересдана после ревью #$RI_NUM (changes от $RI_R)" ;;
    review/after) x="на проверке — сдана после ревью #$RI_NUM (${RI_V:-?} от $RI_R): нужна новая проверка" ;;
    review/*) x="на проверке" ;; # who reviews — the next line
    fix/*) x="правки по ревью #$RI_NUM от $RI_R — исполнитель возвращает её в работу: $BRG item claim $IT_ID --as <имя> (прежние пути), затем item done" ;;
    accepted/noreview)
      if [ "$RI_V" = skip ]; then
        x="$x (решил $RI_R: вердикт skip #$RI_NUM)"
      else
        x="$x (решение при планировании: item add --no-review)"
      fi
      ;;
    accepted/*) [ "$RI_NUM" -gt 0 ] && x="$x (#$RI_NUM: ${RI_V:-?} от $RI_R)" ;;
    cancelled/*) x="$x (${IT_CANCELLED_BY:-?}${IT_CANCELLED:+, $IT_CANCELLED}; назад пути нет)" ;;
  esac
  echo "Стадия: $x"
  if [ -n "$IT_REVIEWING" ]; then
    echo "Проверяют: ${IT_REVIEWING//,/, }"
  elif [ "$s" = review ]; then
    echo "Проверяющего пока нет — взяться: $BRG item review $IT_ID --as <имя> --start"
  fi
  [ "$IT_REVIEW" = no ] && echo "Проверка не нужна (item add --no-review)"
  echo "Создал: $IT_CREATOR · $IT_CREATED"
  if [ -n "$IT_ASSIGNEE" ]; then
    age=
    [ "$IT_STATUS" = claimed ] && is_uint "$IT_CLAIMED_EPOCH" && dur_v age $((NOW - IT_CLAIMED_EPOCH))
    agent_state "$IT_ASSIGNEE"
    echo "Исполнитель: $IT_ASSIGNEE ($ST) · взята $IT_CLAIMED${age:+ ($age назад)}"
  fi
  if [ -n "$IT_PATHS" ]; then
    paths_show_v shown "$IT_PATHS"
    echo "Пути: $shown"
  fi
  if [ -n "$IT_HINT" ] && [ "$IT_HINT" != "$IT_PATHS" ]; then
    paths_show_v shown "$IT_HINT"
    x=
    [ "$IT_STATUS" = todo ] && x=" (claim без --paths возьмёт их)"
    echo "Предлагаемые пути: $shown$x"
  fi
  [ -n "$IT_DONE" ] && echo "Готово: $IT_DONE${IT_NOTE:+ · итог: $IT_NOTE}"
  [ -n "$IT_RESULT" ] && echo "Результат: $IT_RESULT"
  for f in "$ROOT"/tasks/"$ACT_NAME"/shared/runs/R[0-9]*; do
    [ -f "$f" ] || continue
    case ${f##*/} in *.*) continue ;; esac
    run_read "$f" || continue
    [ "$RN_ITEM" = "$IT_ID" ] || continue
    x=$RN_STATUS
    [ -n "$RN_EXIT" ] && x="$x, код $RN_EXIT"
    runs="$runs${runs:+, }$RN_ID ($x)"
  done
  [ -n "$runs" ] && echo "Прогоны: $runs"
  echo "── описание ──"
  printf '%s\n' "$IT_BODY"
  review_files "$IT_FILE.reviews"
  for x in $RF_LIST; do
    f=$IT_FILE.reviews/$x
    r=$(awk 'BEGIN { h = 1 } h && $0 == "" { h = 0; next } h { k = $0; sub(/:.*$/, "", k); v = $0; sub(/^[^:]*: /, "", v); a[k] = v; next }
      !h { b = b "  " $0 "\n" }
      END { printf "── ревью #%s: %s от %s (%s) · %s\n%s", n, a["Verdict"], a["Reviewer"], a["Model"], a["Time"], b }' n="${f##*/}" "$f")
    printf '%s\n' "$r"
  done
  metric item.show task="$ACT_ID" id="$IT_ID"
  [ -n "$AGENT" ] && echo "── NEXT: продолжай; закончив шаг — $BRG wait --as $ASN"
  return 0
}

# my_items_lines — for status: the stages of the task's items, AGENT's items in work
# (and their reservations) or waiting for its changes, the items it is reviewing
my_items_lines() {
  local id st as ti pa ce cr no re hi rv dr ri rn rvv rvr shown s mine= revs= age my="Мои подзадачи"
  local ct=0 cw=0 cf=0 cr_=0 ca=0
  [ -n "${AS_NOKEY:-}" ] && my="Подзадачи $AGENT" # no key: do not confirm the identity
  item_table "$ACT_DIR"
  [ -n "$IT_TABLE" ] || {
    echo "Подзадачи: нет (lead добавляет: $BRG item add)"
    return 0
  }
  while IFS=$US read -r id st as ti pa ce cr no re hi rv dr ri rn rvv rvr; do
    [ -n "$id" ] || continue
    item_stage_v s "$st" "$rv" "$dr" "$rn" "$rvv" "$ri"
    case $s in
      todo) ct=$((ct + 1)) ;;
      work) cw=$((cw + 1)) ;;
      fix) cf=$((cf + 1)) ;;
      review) cr_=$((cr_ + 1)) ;;
      accepted) ca=$((ca + 1)) ;;
    esac
    case $s in review | work) case ",$ri," in *",$AGENT,"*) revs="$revs  $id «$ti» · исполнитель $as$NL" ;; esac ;; esac
    [ "$as" = "$AGENT" ] || continue
    case $s in
      work)
        paths_show_v shown "$pa"
        age=
        is_uint "$ce" && dur_v age $((NOW - ce))
        mine="$mine  $id «$ti» · пути: $shown${age:+ · в работе $age}"
        [ "$IS_NOTE" = rework ] && mine="$mine · правки по ревью от $rvr"
        mine=$mine$NL
        ;;
      fix) mine="$mine  $id «$ti» · правки по ревью от $rvr — верни в работу: $BRG item claim $id --as $ASN (прежние пути)$NL" ;;
    esac
  done <<BRG_MI_EOF
$IT_TABLE
BRG_MI_EOF
  echo "Подзадачи $ACT_ID: todo $ct · в работе $cw · правки $cf · на проверке $cr_ · готово $ca ($BRG item list)"
  if [ -n "$mine" ]; then
    printf '%s и резервирования:\n%s' "$my" "$mine"
  else
    if [ "$ct" -gt 0 ]; then echo "$my: нет — свободные: $BRG item list --status todo"; else echo "$my: нет"; fi
  fi
  [ -z "$revs" ] || printf 'Проверяю (вердикт — %s):\n%s' "$BRG item review I00N --as $ASN --verdict ok|changes" "$revs"
  return 0
}

# ── run: tests/builds under the global exec lock (DESIGN §7) ──────────────
# Runs are numbered across the project (R001, …; counter run/runs.seq) and live in
# the task that started them: tasks/<T>/shared/runs/R003 (headers), R003.log
# (stdout+stderr of the command), R003.sync (pid of a --sync caller), R003.cancel
# (a cancel request: who, and on a second line how — "при отмене задачи T001"),
# R003.notified (the result was delivered; created once).
# Queue: run/execq/<n:06d> = "pid R003 <task dir> <epoch>", one per run waiting for
# its turn; the smallest number with a live runner is the head. The epoch is the
# heartbeat of the runner: it rewrites its entry every tick while it waits. The
# head starts once it holds run/locks/exec.lock (+ file "run": "R003 <task dir>",
# file "hb": "pid epoch" — the heartbeat, rewritten every tick while the command
# runs). That lock is held for the whole command, so it is never broken by age —
# only when its owner is dead, or alive but silent for longer than runner_stale
# (a reused pid, a hung runner). The same goes for queue entries. Silence is judged
# only by a runner waiting in the queue (it watches continuously, see hb_obs_tick);
# the views (run show/list, status) only report it. Nested locks: task → runs →
# chan; exec → runs → chan.
# Runner: a detached `brg __runner` (nohup, own process group, every fd
# redirected — the harness does not wait for it): waits its turn, runs the command
# in yet another process group (timeout/cancel → TERM, then KILL, to that group),
# writes the status, releases the lock, sends the result to the initiator. A runner
# that finds its run settled by someone else (it was judged dead) or its exec lock
# taken away stops its command and leaves.
RUN_FINAL=" done failed timeout killed cancelled "
RUN_KILL_GRACE=${BRG_KILL_GRACE:-5}
is_uint "$RUN_KILL_GRACE" || RUN_KILL_GRACE=5

run_norm_id_v() { # VAR RAW — R3 | r003 | 3 → R003; 1 if not a run id
  local _rn_n=$2
  case $_rn_n in [Rr]*) _rn_n=${_rn_n#?} ;; esac
  is_uint "$_rn_n" && [ ${#_rn_n} -le 6 ] || return 1
  _rn_n=$((10#$_rn_n))
  [ "$_rn_n" -gt 0 ] || return 1
  printf -v _rn_n 'R%03d' "$_rn_n"
  eval "$1=\$_rn_n"
}
run_read() { # FILE → RN_*
  local line
  RN_ID= RN_TASK= RN_AGENT= RN_ITEM= RN_CMD= RN_MODE= RN_TIMEOUT= RN_STATUS= RN_EXIT= RN_REQ= RN_REQ_E=
  RN_START= RN_START_E= RN_FIN= RN_FIN_E= RN_RUNNER= RN_PGID= RN_BY= RN_HOW= RN_NOTE=
  [ -f "$1" ] || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    case $line in
      '') break ;;
      'Id: '*) RN_ID=${line#Id: } ;;
      'Task: '*) RN_TASK=${line#Task: } ;;
      'Agent: '*) RN_AGENT=${line#Agent: } ;;
      'Item: '*) RN_ITEM=${line#Item: } ;;
      'Command: '*) RN_CMD=${line#Command: } ;;
      'Mode: '*) RN_MODE=${line#Mode: } ;;
      'Timeout: '*) RN_TIMEOUT=${line#Timeout: } ;;
      'Status: '*) RN_STATUS=${line#Status: } ;;
      'Exit: '*) RN_EXIT=${line#Exit: } ;;
      'Requested: '*) RN_REQ=${line#Requested: } ;;
      'Requested-Epoch: '*) RN_REQ_E=${line#Requested-Epoch: } ;;
      'Started: '*) RN_START=${line#Started: } ;;
      'Started-Epoch: '*) RN_START_E=${line#Started-Epoch: } ;;
      'Finished: '*) RN_FIN=${line#Finished: } ;;
      'Finished-Epoch: '*) RN_FIN_E=${line#Finished-Epoch: } ;;
      'Runner: '*) RN_RUNNER=${line#Runner: } ;;
      'Pgid: '*) RN_PGID=${line#Pgid: } ;;
      'By: '*) RN_BY=${line#By: } ;;
      'How: '*) RN_HOW=${line#How: } ;;
      'Note: '*) RN_NOTE=${line#Note: } ;;
    esac
  done <"$1"
  [ -n "$RN_ID" ]
}
run_write() { # FILE — RN_* → FILE (tmp + mv; under the "runs" lock)
  local t=${1%/*}/.tmp.${1##*/}.$$
  if ! {
    printf 'Id: %s\nTask: %s\nAgent: %s\n' "$RN_ID" "$RN_TASK" "$RN_AGENT"
    [ -z "$RN_ITEM" ] || printf 'Item: %s\n' "$RN_ITEM"
    printf 'Command: %s\nMode: %s\nTimeout: %s\nStatus: %s\n' "$RN_CMD" "$RN_MODE" "$RN_TIMEOUT" "$RN_STATUS"
    [ -z "$RN_EXIT" ] || printf 'Exit: %s\n' "$RN_EXIT"
    printf 'Requested: %s\nRequested-Epoch: %s\n' "$RN_REQ" "$RN_REQ_E"
    [ -z "$RN_START" ] || printf 'Started: %s\nStarted-Epoch: %s\n' "$RN_START" "$RN_START_E"
    [ -z "$RN_FIN" ] || printf 'Finished: %s\nFinished-Epoch: %s\n' "$RN_FIN" "$RN_FIN_E"
    [ -z "$RN_RUNNER" ] || printf 'Runner: %s\n' "$RN_RUNNER"
    [ -z "$RN_PGID" ] || printf 'Pgid: %s\n' "$RN_PGID"
    [ -z "$RN_BY" ] || printf 'By: %s\n' "$RN_BY"
    [ -z "$RN_HOW" ] || printf 'How: %s\n' "$RN_HOW"
    [ -z "$RN_NOTE" ] || printf 'Note: %s\n' "$RN_NOTE"
  } >"$t" || ! mv_retry "$t" "$1"; then
    rm -f "$t"
    say_err "Внимание: не удалось записать $1"
    return 1
  fi
}
run_is_final() { case $RUN_FINAL in *" $1 "*) return 0 ;; esac; return 1; }
run_file_v() { # VAR RID — the header file of RID in any task; 1 if none
  local _rf_f _rf_r=
  for _rf_f in "$ROOT"/tasks/T[0-9]*/shared/runs/"$2"; do
    if [ -f "$_rf_f" ]; then
      _rf_r=$_rf_f
      break
    fi
  done
  eval "$1=\$_rf_r"
  [ -n "$_rf_r" ]
}
run_next_num_v() { # VAR — next run number (under the "runs" lock)
  local _rx_s= _rx_f _rx_n
  [ -f "$RUN/runs.seq" ] && IFS= read -r _rx_s <"$RUN/runs.seq"
  if ! is_uint "$_rx_s" || [ ${#_rx_s} -gt 6 ]; then
    _rx_s=0
    for _rx_f in "$ROOT"/tasks/T[0-9]*/shared/runs/R[0-9]*; do
      _rx_n=${_rx_f##*/R}
      is_uint "$_rx_n" && [ ${#_rx_n} -le 6 ] || continue
      _rx_n=$((10#$_rx_n))
      [ "$_rx_n" -gt "$_rx_s" ] && _rx_s=$_rx_n
    done
  fi
  _rx_s=$((10#$_rx_s + 1))
  printf '%s\n' "$_rx_s" >"$RUN/.runs.seq.$$" && mv_retry "$RUN/.runs.seq.$$" "$RUN/runs.seq"
  eval "$1=\$_rx_s"
}
run_qfile_v() { # VAR RID — its queue entry
  local _rq_n=${2#R}
  printf -v _rq_n '%s/execq/%06d' "$RUN" "$((10#$_rq_n))"
  eval "$1=\$_rq_n"
}
# run_dur_v VAR — duration of the loaded run (RN_*): finished, or so far
run_dur_v() {
  local _rd_e=$NOW _rd_r=
  is_uint "$RN_FIN_E" && _rd_e=$RN_FIN_E
  is_uint "$RN_START_E" && dur_v _rd_r $((_rd_e - RN_START_E))
  eval "$1=\$_rd_r"
}
# run_line_v VAR — one line about the loaded run (RN_*), for lists
run_line_v() {
  local _rl_s=$RN_STATUS _rl_d
  run_dur_v _rl_d
  case $RN_STATUS in
    queued) ;;
    running)
      _rl_s="running ${_rl_d:-0 с}"
      _rl_d=
      ;;
    *) [ -n "$RN_EXIT" ] && _rl_s="$_rl_s (код $RN_EXIT)" ;;
  esac
  eval "$1=\"\$RN_ID · \$_rl_s · \$RN_AGENT\${_rl_d:+ · \$_rl_d}\${RN_ITEM:+ · \$RN_ITEM} · \$RN_CMD\""
}

# eq_parse LINE — a queue entry → EQ_P (pid) EQ_R (run id) EQ_T (task dir) EQ_E
# (heartbeat epoch; "" if absent)
eq_parse() {
  local r
  EQ_P=${1%% *} EQ_R= EQ_T= EQ_E=
  case $1 in *' '*) r=${1#* } ;; *) return 0 ;; esac
  EQ_R=${r%% *}
  case $r in *' '*) r=${r#* } ;; *) return 0 ;; esac
  EQ_T=${r%% *}
  case $r in *' '*) EQ_E=${r#* } ;; esac
}
eq_write() { # FILE PID RID TNAME — a queue entry with the heartbeat NOW (tmp + mv)
  printf '%s %s %s %s\n' "$2" "$3" "$4" "$NOW" >"$1.tmp.$$" && mv_retry "$1.tmp.$$" "$1"
}
# execq_scan [MYENTRY] [SHOW] — live queue entries before MYENTRY (all if none) →
# EQ_N, EQ_TEXT ("R004 · claude-1 · npm test; …" with SHOW). Entries of dead
# runners (pid dead and silent, see runner_gone) are removed and their runs marked
# killed (run_lost). So are entries silent for longer than runner_stale when
# HB_JUDGE is set (a runner waiting in the queue); without it such entries count as
# live and are flagged in EQ_TEXT.
execq_scan() {
  local f line hf a x w
  EQ_N=0 EQ_TEXT=
  get_now
  for f in "$RUN"/execq/[0-9]*; do
    [ -f "$f" ] || continue
    case ${f##*/} in *.*) continue ;; esac
    [ -n "${1:-}" ] && ! [[ $f < $1 ]] && break
    line=
    IFS= read -r line <"$f" 2>/dev/null
    eq_parse "$line"
    # a dead-looking pid whose entry still beats counts as live (runner_gone)
    if is_uint "$EQ_P" && { pid_alive "$EQ_P" || ! runner_gone "$EQ_E"; }; then
      a=999999 # no heartbeat in the entry: silent since forever
      is_uint "$EQ_E" && a=$((NOW - EQ_E))
      if [ "$a" -gt "$RUNNER_STALE" ] && [ -n "$HB_JUDGE" ]; then
        rm -f "$f"
        x=
        is_uint "$EQ_E" && x=" $a с"
        x="не подавал признаков жизни$x в очереди (pid жив — раннер завис или pid занят другим процессом)"
        w=hb
        [ "$PA_WHY" = dead ] && x="умер в очереди" w=dead # silent long after its pid died
        metric execq.drop run="$EQ_R" pid="$EQ_P" why=$w
        run_lost "$EQ_R" "$EQ_T" "$EQ_P" "$x"
        continue
      fi
      EQ_N=$((EQ_N + 1))
      if [ -n "${2:-}" ]; then
        hf=$ROOT/tasks/$EQ_T/shared/runs/$EQ_R
        x=
        [ "$a" -gt "$RUNNER_STALE" ] && x=" (раннер не отвечает)"
        if run_read "$hf"; then
          EQ_TEXT="$EQ_TEXT${EQ_TEXT:+; }$EQ_R · $RN_AGENT · $RN_CMD$x"
        else
          EQ_TEXT="$EQ_TEXT${EQ_TEXT:+; }${EQ_R:-?}$x"
        fi
      fi
      continue
    fi
    rm -f "$f"
    is_uint "$EQ_P" && run_lost "$EQ_R" "$EQ_T" "$EQ_P" "умер в очереди"
  done
}
# exec_running — the run holding the exec lock → ER_RID ER_TNAME ER_PID, ER_OWNER
# (owner line "pid epoch"); 1 if the lock is free
exec_running() {
  local x= o
  ER_RID= ER_TNAME= ER_PID= ER_OWNER=
  [ -d "$LOCKS/exec.lock" ] || return 1
  lock_owner_v o "$LOCKS/exec.lock"
  ER_OWNER=$o
  ER_PID=${o%% *}
  [ -f "$LOCKS/exec.lock/run" ] && IFS= read -r x <"$LOCKS/exec.lock/run" 2>/dev/null
  ER_RID=${x%% *}
  ER_TNAME=${x#* }
  [ -n "$ER_RID" ]
}

# run_lost RID TASKDIR PID WHAT — runner PID of RID is gone (kill -9, crash) or
# hung: if the run still looks alive and PID is its runner ("" — none recorded),
# mark it killed ("раннер (pid N) WHAT"), drop its queue entry, tell the initiator.
run_lost() {
  local hf=$ROOT/tasks/$2/shared/runs/$1 g= q line
  case $1 in R[0-9]*) ;; *) return 0 ;; esac
  case $2 in '' | */* | *..*) return 0 ;; esac
  [ -f "$hf" ] || return 0
  lock_acquire runs
  if ! run_read "$hf" || [ "$RN_RUNNER" != "$3" ] || run_is_final "$RN_STATUS"; then
    lock_release runs
    return 0
  fi
  get_now_iso
  [ -n "$RN_PGID" ] && g="; команда могла остаться работать (группа процессов $RN_PGID)"
  RN_NOTE="раннер${3:+ (pid $3)} $4$g"
  RN_STATUS=killed RN_FIN=$ISO RN_FIN_E=$NOW
  run_write "$hf"
  run_qfile_v q "$1"
  line=
  [ -f "$q" ] && IFS= read -r line <"$q" 2>/dev/null
  [ -n "$line" ] && [ "${line%% *}" = "$3" ] && rm -f "$q"
  lock_release runs
  metric run.lost id="$1" runner="${3:--}"
  run_notify "$hf"
}
# exec lock hook: its owner (a runner) is dead or silent (LS_WHY: dead | hb) —
# settle the run it was executing
run_exec_dead() { # LOCKDIR OWNER
  local x= w="умер во время выполнения"
  [ "$LS_WHY" = hb ] && w="не подавал признаков жизни $LS_HBAGE с во время выполнения (pid жив — раннер завис или pid занят другим процессом)"
  [ -f "$1/run" ] && IFS= read -r x <"$1/run" 2>/dev/null
  [ -n "$x" ] && run_lost "${x%% *}" "${x#* }" "${2%% *}" "$w"
}
exec_hb() { # the heartbeat of the exec lock holder (NOW set)
  printf '%s %s\n' "$$" "$NOW" >"$LOCKS/exec.lock/.hb.$$" 2>/dev/null &&
    mv_retry "$LOCKS/exec.lock/.hb.$$" "$LOCKS/exec.lock/hb"
}

# run_health — is the runner of the loaded run (RN_*) alive? (NOW set) → RH:
# ok | dead (its pid is gone and its heartbeat silent: runner_gone) | nostart (no
# runner recorded long after the request)
# | stale (pid alive, but silent for longer than runner_stale); RH_AGE — seconds
# since its last heartbeat ("" if unknown). Final runs: ok.
run_health() {
  local x= q line
  RH=ok RH_AGE=
  run_is_final "$RN_STATUS" && return 0
  if [ -z "$RN_RUNNER" ]; then
    is_uint "$RN_REQ_E" && [ $((NOW - RN_REQ_E)) -gt "$RUNNER_STALE" ] && RH=nostart
    return 0
  fi
  if [ "$RN_STATUS" = running ]; then
    exec_running && [ "$ER_RID" = "$RN_ID" ] && [ "$ER_PID" = "$RN_RUNNER" ] &&
      lock_hb_v x "$LOCKS/exec.lock" "$ER_OWNER"
  else
    run_qfile_v q "$RN_ID"
    line=
    [ -f "$q" ] && IFS= read -r line <"$q" 2>/dev/null
    eq_parse "$line"
    [ "$EQ_P" = "$RN_RUNNER" ] && x=$EQ_E
  fi
  is_uint "$x" && RH_AGE=$((NOW - x))
  if ! pid_alive "$RN_RUNNER"; then
    runner_gone "$x" && RH=dead # else: just died, or alive in another pid namespace
    return 0
  fi
  [ -n "$RH_AGE" ] && [ "$RH_AGE" -gt "$RUNNER_STALE" ] && RH=stale
  return 0
}
# run_check HF — load the run (RN_*, RH) and, if its runner is gone, settle it as
# killed at once (run_lost: the initiator is told). For run show/list, status and
# task close/cancel; a silent but alive runner is only reported (RH=stale).
run_check() {
  local tn w
  run_read "$1" || return 1
  run_health
  case $RH in dead | nostart) ;; *) return 0 ;; esac
  tn=${1#"$ROOT"/tasks/}
  tn=${tn%%/*}
  if [ "$RH" = nostart ]; then
    w="не запустился (нет записи о раннере через $((NOW - RN_REQ_E)) с после запроса)"
  elif [ "$RN_STATUS" = queued ]; then
    w="умер в очереди"
  else
    w="умер во время выполнения"
  fi
  run_lost "$RN_ID" "$tn" "$RN_RUNNER" "$w"
  get_now
  run_read "$1"
  run_health
  return 0
}

# log_tail_v VAR FILE N — last N lines of a log for a message: escape sequences and
# control characters dropped, a carriage-return line keeps its last state, each
# line ≤ 300 bytes, all ≤ 3000 bytes (the last lines are kept).
log_tail_v() {
  local _lt_r=
  [ -s "$2" ] && _lt_r=$(tail -n "$3" "$2" 2>/dev/null | awk '
    { s = $0; k = split(s, parts, "\r"); s = ""
      for (i = k; i >= 1; i--) if (parts[i] != "") { s = parts[i]; break }
      gsub(/\033\[[0-9;?]*[A-Za-z]/, "", s); gsub(/[\001-\010\013-\037\177]/, "", s)
      if (length(s) > 300) { s = substr(s, 1, 300); sub(/[\300-\377][\200-\277]*$/, "", s); s = s "…" }
      buf[NR] = "  " s }
    END { start = 1; tot = 0
      for (i = NR; i >= 1; i--) { tot += length(buf[i]) + 1; if (tot > 3000) { start = i + 1; break } }
      for (i = start; i <= NR; i++) print buf[i] }')
  eval "$1=\$_lt_r"
}
# run_head_v VAR — the result line of the loaded (finished) run
run_head_v() {
  local _rh_s=$RN_STATUS _rh_d _rh_t
  run_dur_v _rh_d
  case $RN_STATUS in
    done | failed) _rh_s="$_rh_s (код $RN_EXIT)" ;;
    timeout)
      dur_v _rh_t "$RN_TIMEOUT"
      _rh_s="timeout: остановлен по лимиту $_rh_t${RN_EXIT:+ (код $RN_EXIT)}"
      ;;
    killed) _rh_s="killed: ${RN_BY:+остановлен ${RN_HOW:-командой run cancel} ($RN_BY)}${RN_NOTE:+${RN_BY:+; }$RN_NOTE}" ;;
    cancelled) _rh_s="cancelled: отменён до запуска${RN_HOW:+ $RN_HOW}${RN_BY:+ ($RN_BY)}${RN_NOTE:+; $RN_NOTE}" ;;
  esac
  eval "$1=\"\$RN_ID · \$_rh_s\${_rh_d:+ · \$_rh_d} · \$RN_CMD\""
}

# run_notify HF — deliver the result of a finished run to its initiator, once
# (R003.notified). A --sync caller still waiting prints it itself: give it a moment.
run_notify() {
  local hf=$1 sp= i=0 head tail ch=lobby note= rd rel
  if [ -f "$hf.sync" ]; then
    IFS= read -r sp <"$hf.sync" 2>/dev/null
    while pid_alive "$sp" && [ -f "$hf.sync" ] && [ ! -e "$hf.notified" ] && [ $i -lt 30 ]; do
      sleep 0.1
      i=$((i + 1))
    done
  fi
  dl_claim "$hf.notified" || return 0
  run_read "$hf" || return 0
  # cancelled by the initiator itself: it already knows (run cancel said so)
  [ -n "$RN_BY" ] && [ "$RN_BY" = "$RN_AGENT" ] && return 0
  get_now_iso
  run_head_v head
  log_tail_v tail "$hf.log" 20
  rd=${hf%/*}
  rel=$RROOT/tasks/${hf#"$ROOT"/tasks/}
  if active_task && [ "$ACT_DIR" = "${rd%/shared/runs}" ]; then
    ch=$ACT_ID
  else
    note=" · задача $RN_TASK уже завершена"
  fi
  BODY="$head${NL}Лог: $rel.log${RN_ITEM:+ · подзадача $RN_ITEM}$note"
  if [ -n "$tail" ]; then
    BODY="$BODY${NL}── последние строки лога:$NL$tail"
  else
    BODY="$BODY${NL}(лог пуст)"
  fi
  MSG_EXTRA=
  msg_write "$ch" brg "$RN_AGENT" system ""
  metric run.notify id="$RN_ID" channel="$ch" msg="$MSG_ID"
}

# ── brg run (front): queue the command, start the runner, return at once ──
cmd_run() {
  local sync= topt= item= to T n rid q rd hf rpid disp x line pos t0 step gave= rc
  case ${1:-} in
    list | show | cancel)
      x=$1
      shift
      "run_$x" "$@"
      return
      ;;
  esac
  NEXT_ON_ERR="исправь команду и повтори: $BRG run --as $AS_HINT -- <команда> [аргументы]; закончив шаг — $BRG wait --as $AS_HINT"
  while [ $# -gt 0 ]; do
    case $1 in
      --as | --timeout | --item)
        need_val "$@"
        case $1 in
          --as) OPT_AS=$2 ;;
          --timeout) topt=$2 ;;
          --item) item=$2 ;;
        esac
        shift 2
        ;;
      --sync)
        sync=1
        shift
        ;;
      -h | --help)
        usage_print run
        exit 0
        ;;
      --)
        shift
        break
        ;;
      -*) usage_die "неизвестный параметр: $1 (команда — после --: $BRG run --as <имя> -- npm test)" ;;
      list | show | cancel) # "run --as X list" means the subcommand, not a command named list
        x=$1
        shift
        "run_$x" ${OPT_AS:+--as "$OPT_AS"} "$@"
        return
        ;;
      *) break ;;
    esac
  done
  [ $# -gt 0 ] || usage_die "нужна команда: $BRG run --as <имя> -- <команда> [аргументы…]"
  need_root
  need_agent write
  stop_refuse run
  NEXT_ON_ERR="исправь команду и повтори: $BRG run --as $ASN -- <команда>; закончив шаг — $BRG wait --as $ASN"
  # under the task lock: a run is not created in a task being closed (close refuses
  # while the task has runs in progress, cancel stops them)
  lock_acquire task
  active_task && task_read "$ACT_DIR" ||
    die "нет активной задачи — run работает в задаче (очередь, лог в её shared/runs/, результат — в её канал)" \
      "Без задачи соседи не правят код по плану — команду можно выполнить напрямую."
  wait_timeout_v T "$A_HARNESS" "$A_PLATFORM"
  if [ -n "$topt" ]; then
    parse_dur_v to "$topt" || usage_die "--timeout — 90, 90s, 10m, 1h (от 1 с до 24 ч): $topt"
  elif [ -n "$sync" ]; then
    to=$T
  else
    to=$RUN_TIMEOUT
  fi
  if [ -n "$sync" ] && [ "$to" -gt "$T" ]; then
    die "--sync допускает --timeout не больше $T с (таймаут wait твоего харнесса) — иначе харнесс прервёт вызов" \
      "Для долгой команды убери --sync: она пойдёт в фоне, а результат придёт тебе сообщением в wait."
  fi
  if [ -n "$item" ]; then
    item_norm_id_v x "$item" || usage_die "--item — номер подзадачи вида I001: $item"
    [ -f "$ACT_DIR/items/$x" ] || die "нет подзадачи $x в задаче $ACT_ID" "Все подзадачи: $BRG item list"
    item=$x
  fi
  if [ $# -eq 1 ]; then
    disp=$1
  else
    disp=
    for x in "$@"; do
      shq_v x "$x"
      disp="$disp${disp:+ }$x"
    done
  fi
  one_line_v disp "$disp" 300
  get_now_iso
  t0=$NOW
  rd=$ACT_DIR/shared/runs
  mkdir -p "$rd" "$RUN/execq" 2>/dev/null || die "не удалось создать $rd"
  lock_acquire runs
  run_next_num_v n
  printf -v rid 'R%03d' "$n"
  run_qfile_v q "$rid"
  hf=$rd/$rid
  RN_ID=$rid RN_TASK=$ACT_ID RN_AGENT=$AGENT RN_ITEM=$item RN_CMD=$disp RN_TIMEOUT=$to RN_STATUS=queued RN_EXIT=
  RN_MODE=detached
  [ -n "$sync" ] && RN_MODE=sync
  RN_REQ=$ISO RN_REQ_E=$NOW RN_START= RN_START_E= RN_FIN= RN_FIN_E= RN_RUNNER= RN_PGID= RN_BY= RN_HOW= RN_NOTE=
  run_write "$hf" || die "не удалось записать $hf"
  : >"$hf.log"
  # the queue place is taken now (request order); the runner takes the entry over
  eq_write "$q" "$$" "$rid" "$ACT_NAME"
  lock_release runs
  lock_release task
  [ -n "$sync" ] && printf '%s\n' "$$" >"$hf.sync"
  # Detached runner: own process group (set -m) and nohup — survives the end of
  # the harness's tool call; no fd of ours (the harness pipe) is inherited. No
  # nohup (a minimal Git Bash)? The runner ignores HUP itself.
  x=nohup
  command -v nohup >/dev/null 2>&1 || x=
  set -m
  BRG_CMD_LC_SET=$_brg_lc_set BRG_CMD_LC=$_brg_lc $x bash "$BRG_SELF" __runner "$ACT_NAME" "$rid" -- "$@" \
    </dev/null >/dev/null 2>>"$RUN/runner.log" &
  rpid=$!
  set +m
  lock_acquire runs
  if run_read "$hf" && [ -z "$RN_RUNNER" ] && [ "$RN_STATUS" = queued ]; then
    RN_RUNNER=$rpid
    run_write "$hf"
  fi
  line=
  [ -f "$q" ] && IFS= read -r line <"$q"
  if [ "${line%% *}" = "$$" ]; then
    get_now
    eq_write "$q" "$rpid" "$rid" "$ACT_NAME"
  fi
  lock_release runs
  touch_seen
  metric run id="$rid" task="$ACT_ID" mode="$RN_MODE" timeout="$to" runner="$rpid"
  # where in the queue
  execq_scan "$q" show
  pos="запущен (очередь пуста)"
  if exec_running && [ "$ER_RID" != "$rid" ]; then
    line=${ER_RID:-?}
    if run_read "$ROOT/tasks/$ER_TNAME/shared/runs/$ER_RID"; then
      run_dur_v x
      line="$ER_RID · $RN_AGENT${x:+ · $x} · $RN_CMD"
    fi
    pos="в очереди: перед ним $((EQ_N + 1)) — выполняется $line${EQ_TEXT:+; ждут: $EQ_TEXT}"
  elif [ "$EQ_N" -gt 0 ]; then
    pos="в очереди: перед ним $EQ_N — $EQ_TEXT"
  fi
  dur_v x "$to"
  if [ -z "$sync" ]; then
    echo "── $rid $pos."
    echo "Команда: $disp · лимит $x · лог: $RROOT/tasks/$ACT_NAME/shared/runs/$rid.log"
    echo "Результат (статус, код, хвост лога) придёт тебе сообщением в wait — не опрашивай статус. Отменить: $BRG run cancel $rid --as $ASN"
    echo "── NEXT: продолжай другую работу; закончив шаг — $BRG wait --as $ASN"
    return 0
  fi
  # --sync: wait here (queue included) within the wait timeout of the harness
  echo "── $rid $pos. Жду результат здесь (не дольше $T с)…"
  step=1
  while :; do
    run_read "$hf"
    run_is_final "$RN_STATUS" && break
    get_now
    if [ $((NOW - t0)) -ge "$T" ]; then
      gave=1
      break
    fi
    sleep "0.$step" 2>/dev/null || sleep 1
    [ "$step" -lt 5 ] && step=$((step * 2))
    [ "$step" -gt 5 ] && step=5
  done
  if [ -n "$gave" ]; then
    rm -f "$hf.sync"
    run_read "$hf"
    echo "── $rid не завершился за $T с (сейчас: $RN_STATUS) — результат придёт тебе сообщением в wait."
    echo "── NEXT: продолжай другую работу; закончив шаг — $BRG wait --as $ASN"
    return 0
  fi
  get_now
  run_head_v x
  echo "── $x"
  log_tail_v line "$hf.log" 20
  if [ -n "$line" ]; then printf '%s\n' "$line"; else echo "  (лог пуст)"; fi
  echo "Лог целиком: $RROOT/tasks/$ACT_NAME/shared/runs/$rid.log"
  dl_claim "$hf.notified" || echo "(результат также отправлен тебе сообщением)"
  rm -f "$hf.sync"
  echo "── NEXT: продолжай; закончив шаг — $BRG wait --as $ASN"
  rc=1
  case $RN_STATUS in done | failed) is_uint "$RN_EXIT" && rc=$RN_EXIT ;; esac
  [ "$rc" -le 255 ] || rc=1
  exit "$rc"
}

# ── the runner (detached; started by cmd_run) ──
RUNNER_SIG=
# runner_cancelled — the run ends before its command started: a cancel request or
# a signal while queued. Uses the caller's (run_runner) rid, hf, q. Exits.
runner_cancelled() {
  local by= how=
  [ -e "$hf.cancel" ] && { IFS= read -r by; IFS= read -r how; } <"$hf.cancel" 2>/dev/null
  lock_acquire runs
  rm -f "$q"
  if ! run_read "$hf" || run_is_final "$RN_STATUS"; then
    lock_release runs
    exit 0
  fi
  get_now_iso
  RN_STATUS=cancelled RN_FIN=$ISO RN_FIN_E=$NOW RN_BY=$by RN_HOW=$how
  [ -n "$RUNNER_SIG" ] && [ -z "$by" ] && RN_NOTE="раннер получил сигнал $RUNNER_SIG"
  run_write "$hf"
  lock_release runs
  metric run.end id="$rid" status=cancelled
  run_notify "$hf"
  exit 0
}
run_runner() {
  local tname=$1 rid=$2 rd hf log q fd step=1 maxstep cpid t0 kt= reason= rc st by= how= note= x hbw o lost=
  shift 2
  [ "${1:-}" = -- ] && shift
  for fd in 3 4 5 6 7 8 9; do eval "exec $fd>&-" 2>/dev/null; done
  case $tname in '' | */* | *..*) exit 1 ;; esac
  rd=$ROOT/tasks/$tname/shared/runs
  hf=$rd/$rid
  log=$hf.log
  run_qfile_v q "$rid"
  CMD=__runner
  trap '' HUP # as nohup does (it may be missing): the end of the harness session is not ours
  trap 'RUNNER_SIG=TERM' TERM
  trap 'RUNNER_SIG=INT' INT
  lock_acquire runs
  if ! run_read "$hf" || [ "$RN_STATUS" != queued ]; then
    lock_release runs
    exit 0
  fi
  AGENT=$RN_AGENT
  RN_RUNNER=$$
  run_write "$hf"
  get_now
  eq_write "$q" "$$" "$rid" "$tname"
  hbw=$NOW
  lock_release runs
  # tick: 0.1 s growing to BRG_TICK (1 s)
  x=${BRG_TICK:-1}
  case $x in '' | *[!0-9.]*) x=1 ;; esac
  maxstep=$(awk -v t="$x" 'BEGIN { s = int(t * 10 + 0.5); if (s < 1) s = 1; print s }')
  # Wait for the turn: head of the queue, then the exec lock. Every second: the
  # heartbeat in our queue entry, and a look at our run — settled by someone
  # else meanwhile (we were judged dead) means leave.
  RT_TRIES=0 RT_MISS=
  LOCK_DEAD_HOOK=run_exec_dead
  hb_obs_init
  while :; do
    [ -n "$RUNNER_SIG" ] || [ -e "$hf.cancel" ] && runner_cancelled
    get_now
    hb_obs_tick
    if [ "$NOW" != "$hbw" ] || [ ! -f "$q" ]; then
      run_read "$hf"
      if run_is_final "$RN_STATUS"; then
        rm -f "$q"
        exit 0
      fi
      eq_write "$q" "$$" "$rid" "$tname" # also re-creates an entry dropped meanwhile
      hbw=$NOW
    fi
    execq_scan "$q"
    [ "$EQ_N" -eq 0 ] && lock_try exec noage RT_TRIES RT_MISS && break
    sleep "$((step / 10)).$((step % 10))"
    [ "$step" -lt "$maxstep" ] && step=$((step * 2))
    [ "$step" -gt "$maxstep" ] && step=$maxstep
  done
  LOCK_DEAD_HOOK=
  HB_JUDGE= HB_OBS= HB_OBS_D=
  get_now
  printf '%s %s\n' "$rid" "$tname" >"$LOCKS/exec.lock/run"
  exec_hb
  hbw=$NOW
  lock_acquire runs
  rm -f "$q"
  if ! run_read "$hf" || run_is_final "$RN_STATUS"; then
    lock_release runs
    lock_release exec
    exit 0
  fi
  if [ -n "$RUNNER_SIG" ] || [ -e "$hf.cancel" ]; then
    lock_release runs
    lock_release exec
    runner_cancelled
  fi
  get_now_iso
  RN_STATUS=running RN_START=$ISO RN_START_E=$NOW
  run_write "$hf"
  lock_release runs
  t0=$NOW
  # the command: cwd = project root, the caller's locale, own process group
  set -m
  (
    cd "$PROJ" || exit 127
    if [ -n "${BRG_CMD_LC_SET:-}" ]; then
      LC_ALL=${BRG_CMD_LC-}
      export LC_ALL
    else
      unset LC_ALL
    fi
    unset BRG_CMD_LC_SET BRG_CMD_LC BRG_VIA_CMD
    BRG_RUN=$rid
    export BRG_RUN
    if [ $# -eq 1 ]; then exec bash -c "$1"; else exec "$@"; fi
  ) </dev/null >>"$log" 2>&1 &
  cpid=$!
  set +m
  lock_acquire runs
  run_read "$hf"
  RN_PGID=$cpid
  run_write "$hf"
  lock_release runs
  metric run.start id="$rid" pgid="$cpid"
  step=1
  while kill -0 "$cpid" 2>/dev/null; do
    sleep "$((step / 10)).$((step % 10))"
    [ "$step" -lt "$maxstep" ] && step=$((step * 2))
    [ "$step" -gt "$maxstep" ] && step=$maxstep
    get_now
    # every second: the heartbeat of the exec lock — if it is still ours (taken
    # away: we were judged dead, our run settled as killed — stop the command)
    if [ "$NOW" != "$hbw" ]; then
      lock_owner_v o "$LOCKS/exec.lock"
      if [ "${o%% *}" = "$$" ]; then exec_hb; else lost=1; fi
      hbw=$NOW
    fi
    if [ -z "$reason" ]; then
      if [ -n "$RUNNER_SIG" ]; then
        reason=signal
      elif [ -e "$hf.cancel" ]; then
        reason=cancel
      elif [ -n "$lost" ]; then
        reason=lost
      elif [ $((NOW - t0)) -ge "$RN_TIMEOUT" ]; then
        reason=timeout
      fi
      if [ -n "$reason" ]; then
        kill -TERM -- -"$cpid" 2>/dev/null
        kt=$NOW
      fi
    elif [ $((NOW - kt)) -ge "$RUN_KILL_GRACE" ]; then
      kill -KILL -- -"$cpid" 2>/dev/null
    fi
  done
  wait "$cpid" 2>/dev/null
  rc=$?
  # whatever the command left behind in its group (background children) goes too
  if kill -0 -- -"$cpid" 2>/dev/null; then
    kill -TERM -- -"$cpid" 2>/dev/null
    x=0
    while kill -0 -- -"$cpid" 2>/dev/null && [ $x -lt $((RUN_KILL_GRACE * 10)) ]; do
      sleep 0.1
      x=$((x + 1))
    done
    kill -KILL -- -"$cpid" 2>/dev/null
  fi
  case $reason in
    timeout) st=timeout ;;
    cancel)
      st=killed
      { IFS= read -r by; IFS= read -r how; } <"$hf.cancel" 2>/dev/null
      ;;
    signal)
      st=killed
      note="раннер получил сигнал $RUNNER_SIG"
      ;;
    lost)
      st=killed
      note="exec-блокировку забрали: раннер сочли зависшим"
      ;;
    *) if [ "$rc" -eq 0 ]; then st=done; else st=failed; fi ;;
  esac
  lock_acquire runs
  run_read "$hf"
  get_now_iso
  if run_is_final "$RN_STATUS"; then
    # settled by someone else meanwhile (this runner was judged dead): keep that
    RN_NOTE="${RN_NOTE:+$RN_NOTE; }позже раннер ожил, команда завершилась с кодом $rc"
  else
    RN_STATUS=$st RN_EXIT=$rc RN_FIN=$ISO RN_FIN_E=$NOW RN_BY=$by RN_HOW=$how RN_NOTE=$note
  fi
  run_write "$hf"
  lock_release runs
  lock_release exec
  metric run.end id="$rid" status="$st" exit="$rc" dur=$((NOW - t0))
  run_notify "$hf"
  exit 0
}

# ── run list / show / cancel ──
run_opts() { # ALLOWID "$@" → RO_ID; --as
  RO_ID=
  shift
  while [ $# -gt 0 ]; do
    case $1 in
      --as)
        need_val "$@"
        OPT_AS=$2
        shift 2
        ;;
      -h | --help)
        usage_print run
        exit 0
        ;;
      -*) usage_die "неизвестный параметр: $1" ;;
      *)
        [ -z "$RO_ID" ] || usage_die "лишний аргумент: $1"
        RO_ID=$1
        shift
        ;;
    esac
  done
}

run_list() {
  local f x cnt=0 list=
  run_opts list "$@"
  [ -z "$RO_ID" ] || usage_die "лишний аргумент: $RO_ID (один прогон: run show $RO_ID)"
  need_root
  get_now
  if [ -n "${OPT_AS:-}" ]; then
    need_agent read
    touch_seen
  fi
  # the task's runs first: a runner found dead is settled (killed) before the summary
  if active_task; then
    for f in "$ACT_DIR"/shared/runs/R[0-9]*; do
      [ -f "$f" ] || continue
      case ${f##*/} in *.*) continue ;; esac
      run_check "$f" || continue
      run_line_v x
      [ "$RH" = stale ] && x="$x · раннер не отвечает $RH_AGE с"
      list=$list$x$NL
      cnt=$((cnt + 1))
    done
  fi
  get_now
  if exec_running && run_read "$ROOT/tasks/$ER_TNAME/shared/runs/$ER_RID" && ! run_is_final "$RN_STATUS"; then
    run_line_v x
    echo "── выполняется: $x"
  elif [ -n "$ER_RID" ]; then
    echo "── сейчас ничего не выполняется (блокировка осталась от $ER_RID — её снимет следующий run)"
  else
    echo "── сейчас ничего не выполняется"
  fi
  execq_scan "" show
  [ "$EQ_N" -gt 0 ] && echo "── в очереди ($EQ_N): $EQ_TEXT"
  if [ -n "$ACT_ID" ]; then
    if [ "$cnt" -gt 0 ]; then
      echo "── прогоны задачи $ACT_ID ($cnt, последние 20):"
      printf '%s' "$list" | tail -n 20
    else
      echo "── в задаче $ACT_ID прогонов ещё не было"
    fi
  fi
  metric run.list
  [ -n "$AGENT" ] && echo "── NEXT: продолжай; закончив шаг — $BRG wait --as $ASN"
  return 0
}

run_show() {
  local id hf x t
  run_opts show "$@"
  [ -n "$RO_ID" ] || usage_die "какой прогон: run show R00N"
  run_norm_id_v id "$RO_ID" || usage_die "номер прогона вида R001: $RO_ID"
  need_root
  get_now
  if [ -n "${OPT_AS:-}" ]; then
    need_agent read
    touch_seen
  fi
  run_file_v hf "$id" || die "нет прогона $id" "Список: $BRG run list"
  run_check "$hf" || die "не удалось прочитать $hf"
  run_dur_v x
  echo "── $RN_ID · $RN_STATUS${RN_EXIT:+ · код $RN_EXIT}${x:+ · $x} · $RN_AGENT · задача $RN_TASK${RN_ITEM:+ · подзадача $RN_ITEM}"
  dur_v t "$RN_TIMEOUT"
  echo "Команда: $RN_CMD · лимит $t · режим $RN_MODE"
  echo "Запрошен: $RN_REQ${RN_START:+ · начат: $RN_START}${RN_FIN:+ · завершён: $RN_FIN}"
  [ -n "$RN_BY" ] && echo "Отменил: $RN_BY${RN_HOW:+ ($RN_HOW)}"
  [ -n "$RN_NOTE" ] && echo "Примечание: $RN_NOTE"
  if [ "$RH" = stale ]; then
    echo "ВНИМАНИЕ: раннер (pid $RN_RUNNER) не подаёт признаков жизни $RH_AGE с — завис, или его pid занят другим процессом. Следующий прогон в очереди снимет его сам (после $RUNNER_STALE с наблюдения); остановить сейчас: $BRG run cancel $RN_ID --as <имя>"
  fi
  if [ "$RN_STATUS" = queued ]; then
    run_qfile_v t "$RN_ID"
    execq_scan "$t"
    exec_running && x=1 || x=0
    echo "Перед ним в очереди: $((EQ_N + x))"
  fi
  log_tail_v x "$hf.log" 40
  echo "── лог (последние строки) ──"
  if [ -n "$x" ]; then printf '%s\n' "$x"; else echo "  (пуст)"; fi
  echo "Лог целиком: $RROOT/tasks/${hf#"$ROOT"/tasks/}.log"
  metric run.show id="$RN_ID"
  [ -n "$AGENT" ] && echo "── NEXT: продолжай; закончив шаг — $BRG wait --as $ASN"
  return 0
}

# run_settle_here HF ACTOR HOW NOTE — a cancel request nobody will act on (no live
# runner, or a silent one): settle the run here — queued → cancelled, running →
# killed — and drop its queue entry. 0 if settled now.
run_settle_here() {
  local q rc=1
  lock_acquire runs
  if run_read "$1" && ! run_is_final "$RN_STATUS"; then
    get_now_iso
    if [ "$RN_STATUS" = queued ]; then RN_STATUS=cancelled; else RN_STATUS=killed; fi
    RN_FIN=$ISO RN_FIN_E=$NOW RN_BY=$2 RN_HOW=$3 RN_NOTE=$4
    run_write "$1"
    run_qfile_v q "$RN_ID"
    rm -f "$q"
    rc=0
  fi
  lock_release runs
  return $rc
}
# run_dead_note_v VAR — why the loaded run (RN_*, RH from run_health) needs settling
# by the canceller ("" — its runner is alive and will act on the request)
run_dead_note_v() {
  local _dn_n=
  if [ -z "$RN_RUNNER" ] || [ "$RH" = dead ] || [ "$RH" = nostart ]; then
    _dn_n="раннер не работал${RN_RUNNER:+ (pid $RN_RUNNER)}"
  elif [ "$RH" = stale ]; then
    _dn_n="раннер не отвечал $RH_AGE с (pid $RN_RUNNER); команда могла остаться работать${RN_PGID:+ (группа процессов $RN_PGID)}"
  fi
  eval "$1=\$_dn_n"
}

run_cancel() {
  local id hf i=0 lead= x
  run_opts cancel "$@"
  [ -n "$RO_ID" ] || usage_die "какой прогон: run cancel R00N --as <имя>"
  run_norm_id_v id "$RO_ID" || usage_die "номер прогона вида R001: $RO_ID"
  need_root
  need_agent write
  NEXT_ON_ERR="$BRG wait --as $ASN"
  get_now_iso
  run_file_v hf "$id" || die "нет прогона $id" "Список: $BRG run list"
  run_read "$hf" || die "не удалось прочитать $hf"
  active_task && task_read "$ACT_DIR" && lead=$TK_LEAD
  if [ "$AGENT" != "$RN_AGENT" ] && [ "$AGENT" != "$lead" ]; then
    die "отменить $id может только его инициатор ($RN_AGENT) или lead (${lead:-нет активной задачи})" \
      "Напиши инициатору: $BRG send --as $ASN --to $RN_AGENT"
  fi
  run_is_final "$RN_STATUS" && die "$id уже завершён: $RN_STATUS${RN_EXIT:+ (код $RN_EXIT)}" "Подробно: $BRG run show $id"
  printf '%s\n' "$AGENT" >"$hf.cancel"
  touch_seen
  metric run.cancel id="$id"
  # no live runner to act on the request (it never started, died or hung): settle
  # here; a hung runner that wakes up sees the request and stops its command
  run_health
  run_dead_note_v x
  if [ -n "$x" ] && run_settle_here "$hf" "$AGENT" "" "$x"; then
    run_notify "$hf"
  fi
  # the runner sees the request within a tick; a running command gets TERM, then KILL
  while [ $i -lt $(((RUN_KILL_GRACE + 3) * 10)) ]; do
    run_read "$hf"
    run_is_final "$RN_STATUS" && break
    if [ $((i % 10)) = 9 ]; then # a runner that has just died is judged after runner_dead_grace
      get_now
      run_health
      run_dead_note_v x
      [ -n "$x" ] && run_settle_here "$hf" "$AGENT" "" "$x" && run_notify "$hf"
    fi
    sleep 0.1
    i=$((i + 1))
  done
  if run_is_final "$RN_STATUS"; then
    get_now
    run_head_v x
    echo "── $x"
    [ "$AGENT" != "$RN_AGENT" ] && echo "Инициатор $RN_AGENT получит сообщение об отмене."
  else
    echo "── отмена $id запрошена (сейчас: $RN_STATUS) — раннер остановит команду в ближайшие секунды."
  fi
  echo "── NEXT: продолжай; закончив шаг — $BRG wait --as $ASN"
}

# my_runs_lines — AGENT's runs in the queue or running (for status); a run whose
# runner turns out dead is settled (killed) and its message goes to wait
my_runs_lines() {
  local f x out= lost= my="Мои прогоны"
  [ -n "${AS_NOKEY:-}" ] && my="Прогоны $AGENT" # no key: do not confirm the identity
  for f in "$ACT_DIR"/shared/runs/R[0-9]*; do
    [ -f "$f" ] || continue
    case ${f##*/} in *.*) continue ;; esac
    run_read "$f" || continue
    [ "$RN_AGENT" = "$AGENT" ] || continue
    run_is_final "$RN_STATUS" && continue
    run_check "$f"
    if run_is_final "$RN_STATUS"; then
      lost="$lost${lost:+, }$RN_ID"
      continue
    fi
    run_line_v x
    [ "$RH" = stale ] && x="$x · раннер не отвечает $RH_AGE с"
    out="$out${out:+; }$x"
  done
  [ -n "$out" ] && echo "$my (результат придёт сообщением): $out"
  [ -n "$lost" ] && echo "$my с умершим раннером: $lost — отмечены killed, сообщение придёт в wait."
  return 0
}

# ── runs of a task: task close/cancel ──
# task_runs_v VAR DIR — runs of task DIR still queued or running (a runner found
# dead is settled first, see run_check) → VAR: ids; TR_DESC: "R001 (codex-1,
# running: npm test), …"
task_runs_v() {
  local _tr_f _tr_r= _tr_c
  TR_DESC=
  get_now
  for _tr_f in "$2"/shared/runs/R[0-9]*; do
    [ -f "$_tr_f" ] || continue
    case ${_tr_f##*/} in *.*) continue ;; esac
    run_read "$_tr_f" || continue
    run_is_final "$RN_STATUS" && continue
    run_check "$_tr_f"
    run_is_final "$RN_STATUS" && continue
    trunc_v _tr_c "$RN_CMD" 60
    _tr_r="$_tr_r${_tr_r:+ }$RN_ID"
    TR_DESC="$TR_DESC${TR_DESC:+, }$RN_ID ($RN_AGENT, $RN_STATUS: $_tr_c)"
  done
  eval "$1=\$_tr_r"
}
# task_stop_runs DIR ACTOR HOW IDS — stop those runs as run cancel does: a request
# for a live runner (it stops the command within a tick); a run without a live
# runner is settled here. No separate result messages: the notice about the task
# lists the runs (the .notified markers are taken here).
task_stop_runs() {
  local x hf n
  for x in $4; do
    hf=$1/shared/runs/$x
    run_read "$hf" || continue
    printf '%s\n%s\n' "$2" "$3" >"$hf.cancel"
    dl_claim "$hf.notified"
    get_now
    run_health
    run_dead_note_v n
    [ -n "$n" ] && run_settle_here "$hf" "$2" "$3" "$n"
  done
  return 0
}
# runs_await DIR IDS — wait (≤ kill grace + 3 s) until those runs are final → RA_TEXT
runs_await() {
  local i=0 x pend out
  while :; do
    pend= out=
    for x in $2; do
      run_read "$1/shared/runs/$x" || continue
      if run_is_final "$RN_STATUS"; then
        out="$out${out:+, }$x — $RN_STATUS"
      else
        pend="$pend${pend:+, }$x — $RN_STATUS"
      fi
    done
    [ -z "$pend" ] && break
    [ $i -ge $(((RUN_KILL_GRACE + 3) * 10)) ] && break
    sleep 0.1
    i=$((i + 1))
  done
  RA_TEXT="Прогоны задачи остановлены: ${out:-—}"
  [ -n "$pend" ] && RA_TEXT="$RA_TEXT; ещё останавливаются: $pend"
  return 0
}

# ── wait (DESIGN §5) ───────────────────────────────────────────────────────
W_SUPERSEDED="── SUPERSEDED: тебя заменил более новый wait. НЕ вызывай wait повторно."
W_FINISHING=
W_DELIVERING=
W_SLEEP=

w_stopped() {
  if [ -e "$RUN/stopped" ]; then
    W_STOP_TEXT="── STOP: человек остановил бригаду. Заверши ход."
    return 0
  fi
  if [ -e "$RUN/stopped.$AGENT" ]; then
    W_STOP_TEXT="── STOP: человек остановил тебя ($AGENT). Заверши ход."
    return 0
  fi
  return 1
}

w_pid_v() { # VAR — current content of the pid file
  local _wp_p=
  [ -f "$W_PID" ] && IFS= read -r _wp_p <"$W_PID"
  eval "$1=\$_wp_p"
}
w_claim() { printf '%s\n' "$SELF" >"$W_PID.tmp.$SELF" && mv_retry "$W_PID.tmp.$SELF" "$W_PID"; }

# w_finish RESULT DELIVERED [TEXT] — release pid file, log, print, exit 0.
w_finish() {
  local cur
  [ -n "$W_FINISHING" ] && return 0
  W_FINISHING=1
  [ -n "$W_SLEEP" ] && kill "$W_SLEEP" 2>/dev/null
  w_pid_v cur
  get_now
  if [ "$cur" = "$SELF" ]; then
    wait_last_mark # who/status: "без wait N мин" counts from here
    rm -f "$W_PID" "$W_HB"
  fi
  rm -f "$W_HB.tmp.$SELF" "$W_PID.tmp.$SELF"
  metric wait dur=$((NOW - T0)) result="$1" delivered="$2" timeout="$T" pid="$SELF"
  [ -n "${3:-}" ] && printf '%s\n' "$3"
  exit 0
}

# Signals come from the harness or the human, never from another wait (takeover
# is signal-free). If the pid file already names a newer wait, say SUPERSEDED.
w_on_signal() { # NAME
  local cur
  [ -n "$W_DELIVERING" ] && return 0 # output is being written: finish it normally
  w_stopped && w_finish stop 0 "$W_STOP_TEXT"
  w_pid_v cur
  if [ -n "$cur" ] && [ "$cur" != "$SELF" ]; then w_finish superseded 0 "$W_SUPERSEDED"; fi
  local r=term
  case $1 in INT) r=int ;; HUP) r=hup ;; esac
  w_finish "$r" 0 "── прерван сигналом $1 · NEXT: $NEXT_WAIT"
}

# w_channels_init — listen to lobby, the active task and finished tasks still to
# drain (listen_set), and acknowledge the batch issued by the previous wait
# (Acked := Pending). Called at start and whenever tasks/active changes: a task
# closed or cancelled under a running wait is drained in that same tick — the
# messages sent right before the close are not lost. A channel without my cursor
# starts from 0: I was there when the task was created (join writes a cursor at
# the end for latecomers).
w_channels_init() {
  local i c d a
  listen_set
  W_TASKRAW=$LISTEN_RAW
  CH_N=0
  CH_LIST=()
  CH_NOTE=()
  CH_DIR=()
  CH_ACK=()
  CH_SEEN=()
  CH_SHOW=()
  i=0
  while [ $i -lt "$LS_N" ]; do
    c=${LS_CH[i]}
    i=$((i + 1))
    chan_dir d "$c" || continue
    [ -d "$d/cursors" ] || mkdir -p "$d/cursors"
    cursor_read "$d/cursors/$AGENT"
    a=$CUR_PEND
    if [ ! -f "$d/cursors/$AGENT" ] || [ "$a" != "$CUR_ACK" ]; then cursor_write "$d/cursors/$AGENT" "$a" "$a"; fi
    CH_LIST[CH_N]=$c
    CH_NOTE[CH_N]=${LS_NOTE[i - 1]}
    CH_DIR[CH_N]=$d
    CH_ACK[CH_N]=$a
    CH_SEEN[CH_N]=$a
    CH_N=$((CH_N + 1))
  done
}

# dl_claim MARKER → 0 if this process created it (O_EXCL via noclobber)
dl_claim() {
  local rc
  set -C
  { : >"$1"; } 2>/dev/null
  rc=$?
  set +C
  return $rc
}
dl_unclaim() {
  local x
  for x in $DL_MARKS; do rm -f "$RUN/deadlines/$x.done"; done
  DL_MARKS=
}

# w_deadlines EARLY — my deadlines to report now: expired ones, and with EARLY=1
# (a batch is being delivered anyway) also those every addressee already answered
# — that saves a separate wakeup at the deadline. → DL_TEXT, DL_FILES (index
# files to drop after output), DL_MARKS (claimed markers), DL_LOGS (metrics).
w_deadlines() {
  local f b ep ex d r m y n kind
  DL_TEXT= DL_FILES= DL_MARKS=
  DL_LOGS=()
  for f in "$RUN/deadlines/$AGENT"/*; do
    [ -f "$f" ] || continue
    b=${f##*/}
    ep=${b%%-*}
    is_uint "$ep" || continue
    ex=
    [ "$ep" -le "$NOW" ] && ex=1
    [ -n "$ex$1" ] || continue
    if ! dl_read "$f"; then
      rm -f "$f"
      continue
    fi
    r=
    chan_dir d "$DL_CH" && dl_replied_v r "$d" "$DL_ID" "$AGENT"
    dl_split "$DL_EXPECT" "$r"
    [ -n "$ex" ] || [ -z "$DL_NO" ] || continue
    m=$DL_CH-$DL_ID
    if ! dl_claim "$RUN/deadlines/$m.done"; then
      # Claimed by a racing wait of mine: it removes the index after printing,
      # or drops the claim if it could not print (superseded, EPIPE). An index
      # still here a minute after expiry: the reporter was killed between the
      # claim and the output — report again (a rare duplicate beats a loss).
      [ $((NOW - ep)) -gt 60 ] || continue
    fi
    if [ -n "$ex" ]; then
      DL_TEXT="$DL_TEXT── дедлайн по #$DL_ID ($DL_CH) истёк: ответили: ${DL_YES:-никто}; не ответили: ${DL_NO:-—}$NL"
      kind=expired
    else
      DL_TEXT="$DL_TEXT── по #$DL_ID ($DL_CH) до срока ответили все адресаты: $DL_YES$NL"
      kind=answered
    fi
    DL_FILES="$DL_FILES $b"
    DL_MARKS="$DL_MARKS $m"
    y=${DL_YES//, /,}
    n=${DL_NO//, /,}
    DL_LOGS[${#DL_LOGS[@]}]="channel=$DL_CH id=$DL_ID result=$kind replied=${y:--} missing=${n:--}"
  done
}

# w_deliver — new messages for me on all channels and due deadline summaries;
# print and exit if anything wakes. Quiet messages (Wake: no: join/leave) alone
# do not wake: they stay unissued (CH_SEEN remembers how far it was checked) and
# come with the next waking batch.
w_deliver() {
  local i d out= budget=$OUTMAX force=1 wake= count=0 pl cur res=msg x
  # pass 1: anything that wakes since the last check?
  i=0
  while [ $i -lt "$CH_N" ]; do
    d=${CH_DIR[i]}
    scan_new "$d" "${CH_SEEN[i]}"
    if [ "$SCAN_N" -gt 0 ]; then
      FMT_COUNTONLY=1
      fmt_msgs wait 0 1
      FMT_COUNTONLY=
      if [ "$FMT_WAKE" -gt 0 ]; then
        wake=1
      elif [ "$FMT_TOTAL" -eq 0 ] && [ "${CH_SEEN[i]}" = "${CH_ACK[i]}" ]; then
        # nothing for me here and nothing quiet before it: acknowledge right away
        cursor_write "$d/cursors/$AGENT" "$SCAN_MAX" "$SCAN_MAX"
        CH_ACK[i]=$SCAN_MAX
      fi
      CH_SEEN[i]=$SCAN_MAX
    fi
    i=$((i + 1))
  done
  w_deadlines "$wake"
  [ -n "$wake$DL_TEXT" ] || return 1
  # pass 2: format everything for me since Acked (quiet ones included)
  i=0
  while [ $i -lt "$CH_N" ]; do
    d=${CH_DIR[i]}
    CH_SHOW[i]=
    scan_new "$d" "${CH_ACK[i]}"
    if [ "$SCAN_N" -gt 0 ]; then
      fmt_msgs wait "$budget" "$force"
      if [ "$FMT_SHOWN" -gt 0 ]; then
        plural_new_v pl "$FMT_SHOWN"
        out="$out── ${CH_LIST[i]}${CH_NOTE[i]} · $FMT_SHOWN $pl ─────────────────────────────$NL$FMT_TEXT"
        if [ "$FMT_REST" -gt 0 ]; then
          out="$out── ещё $FMT_REST в ${CH_LIST[i]} не вошло (лимит вывода): придут следующим wait сразу; посмотреть: $BRG read --as $ASN --since $FMT_LAST --channel ${CH_LIST[i]}$NL"
          CH_SHOW[i]=$FMT_LAST
        else
          CH_SHOW[i]=$SCAN_MAX
        fi
        budget=$((budget - ${#FMT_TEXT}))
        force=0
        count=$((count + FMT_SHOWN))
      elif [ "$FMT_REST" -eq 0 ]; then
        cursor_write "$d/cursors/$AGENT" "$SCAN_MAX" "$SCAN_MAX"
        CH_ACK[i]=$SCAN_MAX
        CH_SEEN[i]=$SCAN_MAX
      fi
    fi
    i=$((i + 1))
  done
  [ -n "$out$DL_TEXT" ] || return 1
  w_pid_v cur
  if [ "$cur" != "$SELF" ]; then
    dl_unclaim
    w_finish superseded 0 "$W_SUPERSEDED"
  fi
  W_DELIVERING=1
  if printf '%s%s── NEXT: обработай, затем: %s\n' "$out" "$DL_TEXT" "$NEXT_WAIT"; then
    # At-least-once: issued messages become Pending only after the output was
    # written; the next wait acknowledges them (Acked := Pending).
    i=0
    while [ $i -lt "$CH_N" ]; do
      [ -n "${CH_SHOW[i]}" ] && cursor_write "${CH_DIR[i]}/cursors/$AGENT" "${CH_ACK[i]}" "${CH_SHOW[i]}"
      i=$((i + 1))
    done
    for x in $DL_FILES; do rm -f "$RUN/deadlines/$AGENT/$x"; done
    for x in "${DL_LOGS[@]}"; do metric deadline $x; done
    [ -n "$out" ] || res=deadline
    w_finish "$res" "$count"
  fi
  dl_unclaim # not printed: report the deadlines again next time
  w_finish epipe 0
}

w_hb() { # heartbeat file "pid epoch" (tmp + mv: readers never see a half-written line)
  printf '%s %s\n' "$SELF" "$NOW" >"$W_HB.tmp.$SELF" 2>/dev/null && mv_retry "$W_HB.tmp.$SELF" "$W_HB"
}

cmd_wait() {
  local opt_t= c x deadline
  WAIT_MODE=1
  NEXT_ON_ERR="$BRG wait --as $AS_HINT"
  while [ $# -gt 0 ]; do
    case $1 in
      --as)
        need_val "$@"
        OPT_AS=$2
        shift 2
        ;;
      --timeout)
        need_val "$@"
        opt_t=$2
        shift 2
        ;;
      -h | --help)
        usage_print wait
        exit 0
        ;;
      *) usage_die "неизвестный параметр: $1" ;;
    esac
  done
  [ -z "$opt_t" ] || { is_uint "$opt_t" && [ ${#opt_t} -le 9 ]; } || usage_die "--timeout — целое число секунд: $opt_t"
  need_root
  STOP_SHOWN=1 # wait returns STOP itself
  need_agent write
  if [ -n "$opt_t" ]; then T=$opt_t; else wait_timeout_v T "$A_HARNESS" "$A_PLATFORM"; fi
  NEXT_WAIT="$BRG wait --as $ASN"
  [ -n "$opt_t" ] && NEXT_WAIT="$NEXT_WAIT --timeout $opt_t"
  NEXT_ON_ERR=$NEXT_WAIT
  SELF=$$
  PARENT=$PPID
  W_PID=$RUN/wait/$AGENT.pid
  W_HB=$RUN/wait/$AGENT.hb
  TICK=${BRG_TICK:-1}
  case $TICK in '' | *[!0-9.]*) TICK=1 ;; esac
  trap '' PIPE # a closed stdout must not kill us before the log line
  trap 'w_on_signal TERM' TERM
  trap 'w_on_signal INT' INT
  trap 'w_on_signal HUP' HUP
  get_now
  T0=$NOW
  metric wait.start timeout="$T" pid="$SELF" ppid="$PARENT"
  w_stopped && w_finish stop 0 "$W_STOP_TEXT"

  # Takeover without signals: claim the pid file; the previous wait notices on
  # its next tick and exits with SUPERSEDED.
  w_claim
  w_hb
  HB_AT=$NOW

  w_channels_init
  touch_seen
  SEEN_AT=$NOW
  deadline=$((T0 + T))
  while :; do
    w_stopped && w_finish stop 0 "$W_STOP_TEXT"
    w_pid_v c
    if [ -z "$c" ]; then
      w_claim # removed by a finishing older wait right after our claim
    elif [ "$c" != "$SELF" ]; then
      w_finish superseded 0 "$W_SUPERSEDED"
    fi
    if [ "$PARENT" != 1 ] && ! pid_alive "$PARENT"; then w_finish orphan 0; fi
    profile_read "$AGENT_FILE"
    [ -n "$P_LEFT" ] && w_finish left 0 "── LEFT: агент $AGENT отключён (brg leave). Заверши ход."
    get_now
    if [ "$NOW" != "$HB_AT" ]; then
      w_hb
      HB_AT=$NOW
    fi
    if [ $((NOW - SEEN_AT)) -ge "$HEARTBEAT" ]; then
      touch_seen
      SEEN_AT=$NOW
    fi
    # The active task changed (created, closed, cancelled): new channel set.
    x=
    [ -f "$ROOT/tasks/active" ] && { IFS= read -r x <"$ROOT/tasks/active"; } 2>/dev/null
    [ "$x" = "$W_TASKRAW" ] || w_channels_init
    w_deliver
    if [ "$NOW" -ge "$deadline" ]; then
      # nothing new: a one-line digest of the active task before NEXT
      x=
      active_task && task_digest_v x && x=$x$NL
      w_finish timeout 0 "$x── нет новых ($T с) · ход не завершай · NEXT: $NEXT_WAIT"
    fi
    sleep "$TICK" &
    W_SLEEP=$!
    wait "$W_SLEEP" 2>/dev/null
    W_SLEEP=
  done
}

# ── board (DESIGN §9.1): a read-only snapshot for the human's browser page ──
# Writes only into run/board/: no locks, cursors, Last-Seen, metrics; nobody is
# woken. Only read-only helpers are used here (not need_root, die, run_check,
# execq_scan, touch_seen, …): a runner found dead is shown as such (RH), brg
# settles it on its next view. data.js is executed by the browser, so every piece
# of data becomes JSON in one awk program (AWK_JSON) fed by directives on stdin —
# never through awk -v (it expands \n and \\).
#
# Directives (one per line: a char, US, the argument):
#   { } [ ]          open/close an object/array     k NAME   key
#   s TEXT           string                          n NUM    number (else null)
#   b 1|0            boolean                         z        null
#   x TEXT           a line of a multi-line string;  X        emit it
#   R PATH US SKIP   the record's "f","h","b" into the open object (SKIP: header names left out)
#   r PATH           the record as an object (null if no such file)
#   t PATH US MAX    the whole file as a string, ≤ MAX bytes (null if no such file)
#   M LABEL US TOTAL [US PCT], m PATH…, E — messages, newest first: kept while they fit
#                    PCT % (default 100) of what is left of BRG_BOARD_MAX (less 1 KB for
#                    the rest), printed oldest first
#   D                {"LABEL": {"shown": N, "total": M}} of the message lists cut short
#   p RAW            raw text: constant prefixes and suffixes only
# Escaping: \ and " via "\\\\&" (portable: "\\\\" gives a single \ in gawk); control
# bytes, DEL and U+2028/2029 → \t \r \u00XX \u2028 — a loop only for a string that
# has them. Header names: [A-Za-z0-9-]+. Bodies ≤ BRG_BOARD_BMAX (64 KB).
AWK_JSON='
BEGIN {
  for (i = 1; i < 32; i++) J[sprintf("%c", i)] = sprintf("\\u%04x", i)
  J["\t"] = "\\t"; J["\r"] = "\\r"; J[sprintf("%c", 127)] = "\\u007f"
  J["\342\200\250"] = "\\u2028"; J["\342\200\251"] = "\\u2029"
  BMAX = ENVIRON["BRG_BOARD_BMAX"] + 0; if (BMAX < 1) BMAX = 65536
  LIMIT = ENVIRON["BRG_BOARD_MAX"] + 0; if (LIMIT < 1) LIMIT = 2000000
  depth = 0; ak = 0; outn = 0; nlab = 0; xn = 0; xs = ""; BN = 0; BUF = ""
}
function esc(s,   o, c) {
  gsub(/[\\"]/, "\\\\&", s)
  if (s !~ /[\001-\037\177]|\342\200[\250\251]/) return s
  o = ""
  while (match(s, /[\001-\037\177]|\342\200[\250\251]/)) {
    c = substr(s, RSTART, RLENGTH)
    o = o substr(s, 1, RSTART - 1) J[c]
    s = substr(s, RSTART + RLENGTH)
  }
  return o s
}
function out(s) { printf "%s", s; outn += length(s) }
function sep() {
  if (ak) { ak = 0; return }
  if (depth > 0) { if (!first[depth]) out(","); first[depth] = 0 }
}
function open(c) { sep(); out(c); first[++depth] = 1 }
function shut(c) { depth--; out(c) }
function key(s) { sep(); out("\"" esc(s) "\":"); ak = 1 }
function val(s) { sep(); out(s) }
function split2(s,   k) {
  k = index(s, "\037")
  if (k) { A1 = substr(s, 1, k - 1); A2 = substr(s, k + 1) } else { A1 = s; A2 = "" }
}
# a body is built in chunks: no quadratic concatenation
function bput(s) { BUF = BUF s; if (length(BUF) > 8192) { BP[++BN] = BUF; BUF = "" } }
function bget(   r, i) { r = ""; for (i = 1; i <= BN; i++) r = r BP[i]; r = r BUF; BN = 0; BUF = ""; return r }
# rd(PATH, SKIP, HDR, MAX) → RF (file name), RH (headers), RB (body), escaped; 0 if no such file
function rd(path, skip, hdr, max,   rc, line, n, nb, bl, cut, k, nm) {
  RH = ""; RB = ""; RF = ""; n = 0; nb = 0; bl = 0; cut = 0; BN = 0; BUF = ""
  while ((rc = (getline line < path)) > 0) {
    n++
    if (hdr) {
      if (line == "" || line == "\r") { hdr = 0; continue }
      k = index(line, ":")
      if (k < 2) continue
      nm = substr(line, 1, k - 1)
      if (nm !~ /^[A-Za-z0-9-]+$/ || index(" " skip " ", " " nm " ")) continue
      line = substr(line, k + 1); sub(/^ /, "", line)
      RH = RH (RH == "" ? "" : ",") "\"" nm "\":\"" esc(line) "\""
      continue
    }
    if (nb + length(line) > max) {
      line = substr(line, 1, max > nb ? max - nb : 0); sub(/[\300-\377][\200-\277]*$/, "", line)
      cut = 1
    }
    bput((bl++ ? "\\n" : "") esc(line))
    nb += length(line) + 1
    if (cut) break
  }
  close(path)
  if (rc < 0 && n == 0) return 0
  RB = bget()
  if (cut) RB = RB " …(обрезано)"
  RF = path; sub(/.*\//, "", RF); RF = esc(RF)
  return 1
}
function recobj() { return "{\"f\":\"" RF "\",\"h\":{" RH "},\"b\":\"" RB "\"}" }
{
  d = substr($0, 1, 1); a = substr($0, 3)
  if (d == "{" || d == "[") open(d)
  else if (d == "}" || d == "]") shut(d)
  else if (d == "k") key(a)
  else if (d == "s") val("\"" esc(a) "\"")
  else if (d == "n") val(a ~ /^-?[0-9]+$/ ? a : "null")
  else if (d == "b") val(a == "1" ? "true" : "false")
  else if (d == "z") val("null")
  else if (d == "x") xs = xs (xn++ ? "\\n" : "") esc(a)
  else if (d == "X") { val("\"" xs "\""); xs = ""; xn = 0 }
  else if (d == "R") {
    split2(a); rd(A1, A2, 1, BMAX)
    key("f"); val("\"" RF "\""); key("h"); val("{" RH "}"); key("b"); val("\"" RB "\"")
  }
  else if (d == "r") { if (rd(a, "", 1, BMAX)) val(recobj()); else val("null") }
  else if (d == "t") { split2(a); if (rd(A1, "", 0, A2 + 0 > 0 ? A2 + 0 : BMAX)) val("\"" RB "\""); else val("null") }
  else if (d == "M") {
    split2(a); lab = A1; a = A2; split2(a); mtot = A1 + 0; mcap = LIMIT - 1024 - outn
    if (A2 + 0 > 0) mcap = int(mcap * A2 / 100)
    open("["); mn = 0; mh = 0; mdrop = 0; split("", MS)
  }
  else if (d == "m") {
    if (!mdrop && rd(a, "", 1, BMAX)) {
      o = recobj()
      if (mh + length(o) + 1 > mcap) mdrop = 1
      else { MS[++mn] = o; mh += length(o) + 1 }
    }
  }
  else if (d == "E") {
    for (i = mn; i >= 1; i--) { if (i < mn) out(","); out(MS[i]) }
    split("", MS); shut("]")
    LB[++nlab] = lab; SH[nlab] = mn; TT[nlab] = mtot
  }
  else if (d == "D") {
    open("{")
    for (i = 1; i <= nlab; i++) if (SH[i] < TT[i]) {
      key(LB[i]); open("{"); key("shown"); val(SH[i]); key("total"); val(TT[i]); shut("}")
    }
    shut("}")
  }
  else if (d == "p") out(a)
}
END { printf "\n" }'
BOARD_MSGS=500   # the last messages of a channel in the snapshot
BOARD_TMAX=65536 # brief, plan, summary
BOARD_SETTLE=60  # a finished task is cached for good this long after its close (or once its runs are final)

# The manifest BJ[]: bjo DIRECTIVE · bjk KEY · bjs KEY TEXT · bjn KEY NUM · bjb KEY 0|1 · bjx KEY TEXT
bjo() { BJ[${#BJ[@]}]=$1; }
bjk() { BJ[${#BJ[@]}]="k$US$1"; }
bjs() {
  bjk "$1"
  BJ[${#BJ[@]}]="s$US${2//$NL/ }"
}
bjn() {
  bjk "$1"
  BJ[${#BJ[@]}]="n$US$2"
}
bjb() {
  bjk "$1"
  BJ[${#BJ[@]}]="b$US$2"
}
bjx() { # KEY TEXT — a multi-line string
  local r=$2
  bjk "$1"
  while :; do
    case $r in
      *"$NL"*)
        BJ[${#BJ[@]}]="x$US${r%%"$NL"*}"
        r=${r#*"$NL"}
        ;;
      *)
        BJ[${#BJ[@]}]="x$US$r"
        break
        ;;
    esac
  done
  BJ[${#BJ[@]}]=X
}

# board_url_v VAR ROOTDIR PLATFORM — file:// address of ROOTDIR/board.html; 1 and ""
# when a browser cannot open that path (WSL, MSYS/Cygwin outside a drive). Started by
# brg.cmd: the path comes from BRG_VIA_CMD (C:\p\.brigada\bin\brg.cmd). Space, #, ?, %
# are encoded.
board_url_v() {
  local _bu_p=$2/board.html _bu_d _bu_t _bu_lc=abcdefghijklmnopqrstuvwxyz _bu_uc=ABCDEFGHIJKLMNOPQRSTUVWXYZ
  if [ -n "${BRG_VIA_CMD:-}" ]; then
    _bu_p=${BRG_VIA_CMD%\\*}
    _bu_p=${_bu_p%\\*}/board.html
    _bu_p=${_bu_p//\\//}
  else
    case $3 in
      MSYS) case $_bu_p in /[A-Za-z]/*) _bu_p=${_bu_p:1:1}:${_bu_p:2} ;; *) _bu_p= ;; esac ;;
      Cygwin) case $_bu_p in /cygdrive/[A-Za-z]/*) _bu_p=${_bu_p:10:1}:${_bu_p:11} ;; *) _bu_p= ;; esac ;;
      WSL) _bu_p= ;;
    esac
  fi
  case $_bu_p in
    [A-Za-z]:/*)
      _bu_d=${_bu_p%%:*}
      _bu_t=${_bu_lc%%"$_bu_d"*}
      [ ${#_bu_t} -lt 26 ] && _bu_d=${_bu_uc:${#_bu_t}:1}
      _bu_p=/$_bu_d${_bu_p#?}
      ;;
    /*) ;;
    *) _bu_p= ;;
  esac
  if [ -z "$_bu_p" ]; then
    eval "$1="
    return 1
  fi
  _bu_p=${_bu_p//\%/%25}
  _bu_p=${_bu_p// /%20}
  _bu_p=${_bu_p//\#/%23}
  _bu_p=${_bu_p//\?/%3F}
  eval "$1=\"file://\$_bu_p\""
}

# board_warn TEXT — at most once a minute (a browser on Windows may hold the file)
BW_AT=0
board_warn() {
  [ $((NOW - BW_AT)) -ge 60 ] || return 0
  BW_AT=$NOW
  say_err "── board: $1"
}
# board_write NAME — the manifest BJ[] through AWK_JSON into run/board/NAME (tmp + mv)
board_write() {
  local t=$BD/.tmp.$1.$$ i
  # one directive per line: a LF inside an element (a file name from a glob, the
  # path of .brigada) would start a forged directive — such a path becomes "?"
  # (it no longer exists: read as missing); texts are already one-line (bjs/bjx)
  printf '%s\n' "${BJ[@]//$NL/?}" | awk "$AWK_JSON" >"$t" 2>/dev/null
  if [ $? -ne 0 ] || [ ! -s "$t" ]; then
    rm -f "$t"
    board_warn "не удалось собрать $1"
    return 1
  fi
  for i in 1 2 3; do
    mv -f "$t" "$BD/$1" 2>/dev/null && return 0
    sleep 0.1
  done
  rm -f "$t"
  board_warn "не удалось записать $BD/$1 (файл занят?) — повторю на следующем тике"
  return 1
}

# board_tail_v VAR HF — log tail of the loaded run (RN_*): of a running one every tick,
# of a finished one once per process (BT_<id>)
board_tail_v() {
  local _bt_id=${2##*/} _bt_x=
  case $_bt_id in R[0-9]*) ;; *) _bt_id= ;; esac
  case $_bt_id in *[!R0-9]*) _bt_id= ;; esac
  if [ -n "$_bt_id" ] && run_is_final "$RN_STATUS"; then
    if eval "[ -n \"\${BT_$_bt_id+x}\" ]"; then
      eval "$1=\$BT_$_bt_id"
      return 0
    fi
    log_tail_v _bt_x "$2.log" 20
    eval "BT_$_bt_id=\$_bt_x"
  elif [ "$RN_STATUS" = running ]; then
    log_tail_v _bt_x "$2.log" 20
  fi
  eval "$1=\$_bt_x"
}

# board_msgs DIR LABEL [PCT] — (after a key) the last BOARD_MSGS messages of the
# channel, within PCT % of the size budget left (AWK_JSON)
board_msgs() {
  local m i lo
  m=("$1"/messages/*.msg)
  [ -f "${m[0]}" ] || m=()
  bjo "M$US$2$US${#m[@]}$US${3:-}"
  i=$((${#m[@]} - 1))
  lo=$((${#m[@]} - BOARD_MSGS))
  [ "$lo" -ge 0 ] || lo=0
  while [ "$i" -ge "$lo" ]; do
    bjo "m$US${m[$i]}"
    i=$((i - 1))
  done
  bjo E
}

# board_task DIR — (inside an object) a task: id, dir, its record, brief, plan,
# summary, items with reviews, runs (+ RH, log tail), messages
board_task() {
  local d=$1 f r x n=${1##*/}
  bjs id "${n%%-*}"
  bjs dir "$n"
  bjk task
  bjo "r$US$d/task"
  bjk brief
  bjo "t$US$d/brief.md$US$BOARD_TMAX"
  bjk plan
  bjo "t$US$d/shared/plan.md$US$BOARD_TMAX"
  bjk summary
  bjo "t$US$d/summary.md$US$BOARD_TMAX"
  item_files "$d"
  bjk items
  bjo "["
  for f in ${ITEM_FILES[@]+"${ITEM_FILES[@]}"}; do
    bjo "{"
    bjo "R$US$f$US"
    bjk reviews
    bjo "["
    # only the records (not "2.bak", "0"), by number (glob order: 1 10 2)
    review_files "$f.reviews"
    for r in $RF_LIST; do
      bjo "r$US$f.reviews/$r"
    done
    bjo "]"
    bjo "}"
  done
  bjo "]"
  bjk runs
  bjo "["
  for f in "$d"/shared/runs/R[0-9]*; do
    [ -f "$f" ] || continue
    case ${f##*/} in *.*) continue ;; esac
    run_read "$f" || continue
    run_health # one-shot (HB_OBS_D empty): dead | stale | nostart are only shown
    bjo "{"
    bjo "R$US$f$US"
    bjs rh "$RH"
    bjn rh_age "$RH_AGE"
    board_tail_v x "$f"
    bjx tail "$x"
    bjo "}"
  done
  bjo "]"
  bjk messages
  board_msgs "$d" task "$BM_PCT" # data.js: some room is left for lobby
}

# board_settled DIR — a finished task whose data no longer change: closed longer than
# BOARD_SETTLE ago, or none of its runs is still going
board_settled() {
  local f
  task_read "$1"
  is_uint "$TK_CLOSED_EPOCH" && [ $((NOW - TK_CLOSED_EPOCH)) -gt "$BOARD_SETTLE" ] && return 0
  for f in "$1"/shared/runs/R[0-9]*; do
    [ -f "$f" ] || continue
    case ${f##*/} in *.*) continue ;; esac
    run_read "$f" || continue
    run_is_final "$RN_STATUS" || return 1
  done
  return 0
}

# board_tasks — TL_DIRS (task dirs, by number), CUR_DIR: the active task, else the
# last finished one (by number); "" if there are no tasks
board_tasks() {
  local d n max=0
  TL_DIRS=()
  CUR_DIR=
  for d in "$ROOT"/tasks/T[0-9]*; do
    [ -f "$d/task" ] || continue
    n=${d##*/}
    n=${n%%-*}
    n=${n#T}
    is_uint "$n" && [ ${#n} -le 6 ] || continue
    TL_DIRS[${#TL_DIRS[@]}]=$d
    n=$((10#$n))
    if [ "$n" -gt "$max" ]; then
      max=$n
      CUR_DIR=$d
    fi
  done
  active_task && CUR_DIR=$ACT_DIR
  return 0
}

# board_cache — run/board/T00N.js of every finished task but the current one: written
# once it settled (BC_<id>: done in this process); until then — every tick, with a
# T00N.part mark (a later run rewrites a cache written unsettled)
board_cache() {
  local d id st
  for d in ${TL_DIRS[@]+"${TL_DIRS[@]}"}; do
    [ "$d" = "$CUR_DIR" ] && continue
    id=${d##*/}
    id=${id%%-*}
    eval "[ -z \"\${BC_$id-}\" ]" || continue
    task_status_v st "$d"
    case $st in done | cancelled) ;; *) continue ;; esac
    if board_settled "$d"; then
      if [ ! -f "$BD/$id.js" ] || [ -f "$BD/$id.part" ]; then
        board_cache_write "$d" "$id" || continue
        rm -f "$BD/$id.part"
      fi
      eval "BC_$id=1"
    else
      : >"$BD/$id.part"
      board_cache_write "$d" "$id"
    fi
  done
}
board_cache_write() { # DIR ID
  BJ=()
  BM_PCT=
  bjo "p$US(window.BRG_TASKS = window.BRG_TASKS || {})[\"$2\"] = "
  bjo "{"
  board_task "$1"
  bjk trunc
  bjo D
  bjo "}"
  bjo "p$US;"
  board_write "$2.js"
}

# board_tick — run/board/data.js: agents, tasks, the current task, lobby, meta
board_tick() {
  local n d x drop st
  get_now
  board_tasks
  board_cache
  BJ=()
  bjo "p${US}window.BRG_BOARD = "
  bjo "{"
  list_agents
  bjk agents
  bjo "["
  for n in $AGENT_NAMES; do
    agent_state "$n"
    idle_note_v x "$n" " · "
    x=${x# · }
    drop=0
    case $x in *"возможно выпал"*) drop=1 ;; esac
    st=0
    [ -e "$RUN/stopped.$n" ] && st=1
    bjo "{"
    bjo "R$US$ROOT/agents/$n${US}Key" # the session key is shown only to the agent itself (§3)
    bjs name "$n"
    bjs state "$ST"
    bjn seen "$ST_SEEN"
    bjs note "$x"
    bjb drop "$drop"
    bjb stopped "$st"
    bjo "}"
  done
  bjo "]"
  bjk tasks
  bjo "["
  for d in ${TL_DIRS[@]+"${TL_DIRS[@]}"}; do
    x=
    summary_line_v x "$d/summary.md"
    bjo "{"
    bjo "R$US$d/task$US"
    bjs dir "${d##*/}"
    bjs sum "$x"
    bjo "}"
  done
  bjo "]"
  bjk current
  if [ -n "$CUR_DIR" ]; then
    bjo "{"
    BM_PCT=75
    board_task "$CUR_DIR"
    bjo "}"
  else
    bjo z
  fi
  bjk lobby
  board_msgs "$ROOT/lobby" lobby
  bjk meta
  bjo "{"
  bjn time "$NOW"
  bjn interval "$B_INT"
  bjs version "$BRG_VERSION"
  bjs project "${PROJ##*/}"
  x=0
  [ -e "$RUN/stopped" ] && x=1
  bjb stop "$x"
  bjk stopped
  bjo "["
  for d in "$RUN"/stopped.*; do
    [ -e "$d" ] || continue
    n=${d##*/stopped.}
    valid_name "$n" && bjo "s$US$n"
  done
  bjo "]"
  bjk trunc
  bjo D
  bjo "}"
  bjo "}"
  bjo "p$US;"
  board_write data.js
}

board_quit() {
  [ -n "$B_SLEEP" ] && kill "$B_SLEEP" 2>/dev/null
  rm -f "$BD"/.tmp.*."$$" 2>/dev/null
  exit 0
}

cmd_board() {
  local once= url x u
  B_INT=2
  while [ $# -gt 0 ]; do
    case $1 in
      --interval)
        x=${2:-}
        if ! is_uint "$x" || [ "$x" -lt 1 ] || [ ${#x} -gt 6 ]; then
          usage_line_v u board
          say_err "── ОШИБКА: --interval — целое число секунд ≥ 1${2+: $2}" "Использование: $u"
          exit 1
        fi
        B_INT=$((10#$x))
        shift 2
        ;;
      --once)
        once=1
        shift
        ;;
      -h | --help)
        usage_print board
        exit 0
        ;;
      *)
        usage_line_v u board
        say_err "── ОШИБКА: неизвестный параметр: $1" "Использование: $u"
        exit 1
        ;;
    esac
  done
  # not need_root: it writes (mkdir, body_gc)
  if [ ! -f "$ROOT/VERSION" ] || [ ! -d "$ROOT/lobby/messages" ]; then
    say_err "── ОШИБКА: не найдено состояние brigada в $ROOT" \
      "Создать .brigada в проекте: bash /путь/к/brigada/bin/brg init <каталог_проекта>"
    exit 1
  fi
  BD=$RUN/board
  if ! mkdir -p "$BD" 2>/dev/null; then
    say_err "── ОШИБКА: не удалось создать $BD"
    exit 1
  fi
  x=
  [ -f "$BD/VERSION" ] && IFS= read -r x <"$BD/VERSION"
  if [ "$x" != "$BRG_VERSION" ]; then # another brg: the cache of finished tasks is rebuilt
    rm -f "$BD"/T[0-9]*.js "$BD"/T[0-9]*.part
    printf '%s\n' "$BRG_VERSION" >"$BD/.tmp.VERSION.$$" && mv -f "$BD/.tmp.VERSION.$$" "$BD/VERSION"
  fi
  detect_platform
  if board_url_v url "$ROOT" "$PLATFORM"; then
    printf '%s\n' "$url"
  else
    echo "── открой в браузере файл .brigada/board.html проекта ($ROOT/board.html)"
  fi
  [ -f "$ROOT/board.html" ] || say_err "── нет $ROOT/board.html — обнови .brigada: bash /путь/к/brigada/bin/brg init $PROJ"
  B_SLEEP=
  trap board_quit INT TERM HUP
  if [ -n "$once" ]; then
    board_tick || exit 1
    echo "── снимок записан: $RROOT/run/board/data.js"
    exit 0
  fi
  echo "── доска обновляется каждые $B_INT с (снимок: $RROOT/run/board/); Ctrl+C — выход"
  while :; do
    board_tick
    sleep "$B_INT" &
    B_SLEEP=$!
    wait "$B_SLEEP" 2>/dev/null
    B_SLEEP=
  done
}

# ── main ───────────────────────────────────────────────────────────────────
# How agents call brg — repeated in every NEXT line. Started by bin/brg.cmd
# (PowerShell/cmd on Windows): that .cmd, not `bash …` (in PowerShell `bash` may
# be WSL), always in the relative form .\.brigada\bin\brg.cmd — the one command
# that runs alike in PowerShell and cmd (a quoted full path is a mere string in
# PowerShell, & "…" is an error in cmd). Called from elsewhere: WIN_CD_HINT, a line
# before the output, tells to go to the project root first.
WIN_CD_HINT=
if [ -n "${BRG_VIA_CMD:-}" ]; then
  BRG='.\.brigada\bin\brg.cmd'
  _brg_a=$PWD _brg_b=$PROJ
  [ "$_brg_a" = "$_brg_b" ] || { # Windows paths: case does not matter
    _brg_a=$(printf '%s' "$_brg_a" | tr 'A-Z' 'a-z')
    _brg_b=$(printf '%s' "$_brg_b" | tr 'A-Z' 'a-z')
  }
  if [ "$_brg_a" != "$_brg_b" ]; then
    _brg_w=${BRG_VIA_CMD%\\*} # C:\proj\.brigada\bin\brg.cmd → C:\proj
    _brg_w=${_brg_w%\\*}
    _brg_w=${_brg_w%\\*}
    WIN_CD_HINT="── ВНИМАНИЕ: brg вызван не из корня проекта. Команды brg (и из NEXT тоже) выполняй из корня: cd \"$_brg_w\" (в cmd, если корень на другом диске: cd /d \"$_brg_w\"), затем .\\.brigada\\bin\\brg.cmd …"
  fi
else
  shq_v _brg_q "$0"
  BRG="bash $_brg_q"
fi
OPT_AS=
NOW=

main() {
  local x prev=
  CMD=${1:-help}
  [ $# -gt 0 ] && shift
  # The agent name, if given, goes into every error's NEXT line.
  AS_HINT='<имя>'
  for x in "$@"; do
    [ "$prev" = --as ] && valid_name "$x" && AS_HINT=$x
    prev=$x
  done
  [ "$AS_HINT" = '<имя>' ] && valid_name "${BRG_AS:-}" && AS_HINT=$BRG_AS
  trap release_all EXIT
  trap 'release_all; exit 130' INT TERM HUP
  case $CMD in -h | --help | help | version | --version | init | board | __runner) ;; *) [ -z "$WIN_CD_HINT" ] || printf '%s\n' "$WIN_CD_HINT" ;; esac
  case $CMD in
    -h | --help | help) cmd_help ;;
    version | --version) echo "brg $BRG_VERSION" ;;
    init)
      cfg_load
      cmd_init "$@"
      ;;
    join | leave | send | wait | read | who | tail | say | status | stop | resume | task | doctor | board)
      cfg_load
      "cmd_$CMD" "$@"
      ;;
    lead | host)
      cfg_load
      cmd_role "$CMD" "$@"
      ;;
    item | run)
      cfg_load
      "cmd_$CMD" "$@"
      ;;
    __runner) # internal: the detached runner of `brg run`
      cfg_load
      run_runner "$@"
      ;;
    *) die "неизвестная команда: $CMD" "Список команд: $BRG help" ;;
  esac
}

# BRG_SOURCE_ONLY=1: load functions only (tests of internals).
[ "${BRG_SOURCE_ONLY:-}" = 1 ] || main "$@"
